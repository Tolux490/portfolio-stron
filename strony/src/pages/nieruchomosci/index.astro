---
import Site from '../../layouts/Site.astro';
import { nieruchomosci as biz } from '../../data/firmy.js';

const fonts =
  'https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&family=Roboto+Mono:wght@400;500&family=Syne:wght@600;800&display=swap';

const links = [
  { href: '#oferty', label: 'Oferty' },
  { href: '#zasady', label: 'Jak pracujemy' },
  { href: '#zespol', label: 'Zespół' },
];

// Na demo oferty wpisane na sztywno. Prawdziwy portal z wyszukiwarką
// to już aplikacja z bazą danych — inny zakres i inna wycena.
const oferty = [
  { typ: 'Mieszkanie', gdzie: 'Wołomin, ul. Kobyłkowska', cena: '465 000', m: '48', pok: '2', pietro: '3/4', rok: '2018' },
  { typ: 'Dom wolnostojący', gdzie: 'Duczki', cena: '1 190 000', m: '142', pok: '5', pietro: '—', rok: '2009' },
  { typ: 'Mieszkanie', gdzie: 'Wołomin, centrum', cena: '549 000', m: '62', pok: '3', pietro: '1/3', rok: '1998' },
  { typ: 'Działka budowlana', gdzie: 'Zagościniec', cena: '289 000', m: '1100', pok: '—', pietro: '—', rok: 'MPZP' },
  { typ: 'Kawalerka', gdzie: 'Kobyłka', cena: '339 000', m: '31', pok: '1', pietro: '2/5', rok: '2021' },
  { typ: 'Bliźniak', gdzie: 'Marki', cena: '985 000', m: '118', pok: '4', pietro: '—', rok: '2016' },
];

const zespol = [
  { imie: 'Marta Sienkiewicz', rola: 'Mieszkania, Wołomin i Kobyłka', tel: '+48 604 337 902' },
  { imie: 'Tomasz Rybak', rola: 'Domy i działki, powiat wołomiński', tel: '+48 604 337 903' },
];
---

<Site
  title="Kontur Nieruchomości — mieszkania i domy, powiat wołomiński"
  description="Biuro nieruchomości w Wołominie. Sprzedaż mieszkań, domów i działek w powiecie wołomińskim. Prowizja 2% + VAT, umowa na czas określony."
  fonts={fonts}
  biz={biz}
  links={links}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Wołomin · Kobyłka · Marki · Zielonka · Radzymin</p>
        <h1>Sprzedajemy nieruchomości w powiecie wołomińskim.</h1>
        <p class="lead">
          Pracujemy na wyłączność i na jasnych warunkach: jedna stawka, umowa na
          trzy miesiące, bez automatycznego przedłużania.
        </p>
      </div>
      <!-- Sygnatura: jedna liczba, która mówi więcej niż akapit o „pasji" -->
      <div class="stat">
        <span class="stat__num">41</span>
        <span class="stat__label">dni — mediana od umowy pośrednictwa do aktu notarialnego, 2025</span>
      </div>
    </div>
  </section>

  <section id="oferty" class="band">
    <div class="wrap">
      <p class="eyebrow">Wybrane oferty · stan na 20 sierpnia</p>
      <h2 class="h2">Sześć nieruchomości w sprzedaży.</h2>

      <div class="oferty">
        {oferty.map((o) => (
          <article class="oferta">
            <div class="ph">Zdjęcie nieruchomości</div>
            <div class="oferta__body">
              <p class="oferta__typ">{o.typ}</p>
              <h3>{o.gdzie}</h3>
              <dl class="metryka">
                <div><dt>Powierzchnia</dt><dd>{o.m} m²</dd></div>
                <div><dt>Pokoje</dt><dd>{o.pok}</dd></div>
                <div><dt>Piętro</dt><dd>{o.pietro}</dd></div>
                <div><dt>Rok / status</dt><dd>{o.rok}</dd></div>
              </dl>
              <p class="oferta__cena">{o.cena} zł</p>
            </div>
          </article>
        ))}
      </div>
      <p class="fine">
        Ceny ofertowe. Zdjęcia i opisy nieruchomości publikujemy wyłącznie za zgodą właściciela.
      </p>
    </div>
  </section>

  <section id="zasady" class="band band--alt">
    <div class="wrap dwie">
      <div>
        <p class="eyebrow">Jak pracujemy</p>
        <h2 class="h2">Jedna stawka, bez gwiazdek.</h2>
        <ul class="lista">
          <li><strong>2% + VAT</strong> od ceny transakcyjnej, płatne po akcie notarialnym.</li>
          <li><strong>Umowa na 3 miesiące</strong>, bez klauzuli automatycznego przedłużenia.</li>
          <li><strong>Zdjęcia i opis</strong> w cenie — fotograf przyjeżdża w ciągu tygodnia.</li>
          <li><strong>Sprawdzenie stanu prawnego</strong> księgi wieczystej przed publikacją.</li>
        </ul>
      </div>
      <div class="ph ph--wide">Zdjęcie biura lub zespołu przy pracy</div>
    </div>
  </section>

  <section id="zespol" class="band">
    <div class="wrap">
      <p class="eyebrow">Kontakt bezpośredni</p>
      <h2 class="h2">Dzwoń do osoby, która prowadzi dany typ nieruchomości.</h2>
      <div class="osoby">
        {zespol.map((o) => (
          <div class="osoba">
            <h3>{o.imie}</h3>
            <p class="osoba__rola">{o.rola}</p>
            <a class="osoba__tel" href={`tel:${o.tel.replace(/[^+\d]/g, '')}`}>{o.tel}</a>
          </div>
        ))}
      </div>
      <p class="fine">
        Biuro: {biz.street}, {biz.zip} {biz.city}. Spotkania w soboty po wcześniejszym umówieniu.
      </p>
    </div>
  </section>
</Site>

<style is:global>
  /* --- TOKENY: katalog. Jasno, dużo powietrza, granat zamiast czerni,
         liczby złożone monospace jak w karcie katalogowej. --- */
  :root {
    --bg: #f7f7f4;
    --bg-alt: #ecece7;
    --ink: #14213a;
    --muted: #5f6a80;
    --line: #d5d6ce;
    --accent: #14213a;
    --accent-dark: #0c1729;
    --on-accent: #f7f7f4;
    --radius: 3px;
    --maxw: 1180px;
    --font-display: 'Syne', system-ui, sans-serif;
    --font-body: 'Public Sans', system-ui, sans-serif;
    --font-mono: 'Roboto Mono', ui-monospace, monospace;
  }

  .hero { padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 7vw, 5rem); }
  .hero__grid { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 940px) { .hero__grid { grid-template-columns: 1.6fr 1fr; gap: 4rem; } }
  .hero h1 {
    font-size: clamp(2.3rem, 5.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }

  .lead { font-size: 1.1rem; color: var(--muted); max-width: 46ch; margin-top: 1.5rem; }

  .stat { border-top: 3px solid var(--ink); padding-top: 1rem; }
  .stat__num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .stat__label {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .band--alt { background: var(--bg-alt); }

  .h2 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 2rem; }

  .oferty { display: grid; gap: 1.75rem; }
  @media (min-width: 700px) { .oferty { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1020px) { .oferty { grid-template-columns: repeat(3, 1fr); } }

  .oferta { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .oferta__body { padding: 1.25rem 1.35rem 1.5rem; }
  .oferta__typ {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.35rem;
  }
  .oferta h3 { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }

  .metryka { margin: 1.1rem 0 1.25rem; display: grid; gap: 0; }
  .metryka > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .metryka dt { color: var(--muted); margin: 0; }
  .metryka dd { margin: 0; font-weight: 500; }

  .oferta__cena {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .fine { font-size: 0.85rem; color: var(--muted); margin-top: 1.75rem; max-width: 62ch; }

  .dwie { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .dwie { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .lista { list-style: none; margin: 0; padding: 0; }
  .lista li { padding: 0.9rem 0; border-bottom: 1px solid var(--line); color: var(--muted); }
  .lista strong { color: var(--ink); }

  .osoby { display: grid; gap: 1.75rem; }
  @media (min-width: 700px) { .osoby { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .osoba { border-top: 2px solid var(--ink); padding-top: 1.1rem; }
  .osoba h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -0.02em; }
  .osoba__rola { color: var(--muted); font-size: 0.95rem; margin: 0.35rem 0 0.9rem; }
  .osoba__tel {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    text-decoration: none;
    border-bottom: 2px solid var(--line);
  }
  .osoba__tel:hover { border-color: var(--ink); }

  .ph {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    aspect-ratio: 3 / 2;
    background: #e3e4dd;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .ph--wide { aspect-ratio: 4 / 3; border: 1px solid var(--line); }
</style>
