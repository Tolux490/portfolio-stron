---
import Site from '../../layouts/Site.astro';
import { restauracja as biz } from '../../data/firmy.js';

const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Karla:wght@400;500;600&display=swap';

const links = [
  { href: '#karta', label: 'Karta' },
  { href: '#kuchnia', label: 'Kuchnia' },
  { href: '#rezerwacja', label: 'Rezerwacja' },
];

const karta = [
  {
    grupa: 'Na początek',
    dania: [
      { n: 'Śledź w oleju rzepakowym, kiszone jabłko, koperek', c: '26' },
      { n: 'Krem z pieczonej dyni, olej z pestek, grzanka żytnia', c: '24' },
      { n: 'Tatar z polędwicy, żółtko, ogórek małosolny', c: '38' },
    ],
  },
  {
    grupa: 'Dalej',
    dania: [
      { n: 'Policzki wołowe duszone w czerwonym winie, purée z selera', c: '64' },
      { n: 'Pstrąg z pieca, koper włoski, masło cytrynowe', c: '58' },
      { n: 'Pierogi z kaszą gryczaną i twarogiem, podsmażany boczek', c: '42' },
    ],
  },
  {
    grupa: 'Na koniec',
    dania: [
      { n: 'Sernik pieczony, karmel solony', c: '22' },
      { n: 'Gruszka w korzeniach, lody śmietankowe', c: '20' },
    ],
  },
];
---

<Site
  title="Ogrodowa 3 — kuchnia sezonowa w Wołominie"
  description="Restauracja przy ulicy Ogrodowej 3 w Wołominie. Karta na cztery dania, zmieniana co środę. Rezerwacja telefoniczna."
  fonts={fonts}
  biz={biz}
  links={links}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Wołomin · ul. Ogrodowa 3 · czynne od środy</p>
      <h1>Krótka karta,<br /><em>zmieniana co środę.</em></h1>
      <p class="lead">
        Gotujemy z tego, co akurat jest. Osiem pozycji, żadnej z nich nie robimy „na zapas".
        Stolik rezerwujesz telefonicznie — odbieramy od 15:00.
      </p>
      <a class="btn btn--solid" href={`tel:${biz.phone.replace(/[^+\d]/g, '')}`}>
        Rezerwuj: {biz.phone}
      </a>
    </div>
  </section>

  <!-- Sygnatura: karta zapisana jak drukowane menu, z kropkowanym
       wypełnieniem do ceny. Bez zdjęć dań — zdjęcia jedzenia to
       najczęstszy powód, dla którego strona restauracji wygląda tanio. -->
  <section id="karta" class="band">
    <div class="wrap menu">
      <p class="eyebrow">Karta 34. tygodnia · obowiązuje do wtorku</p>
      {karta.map((g) => (
        <div class="menu__grupa">
          <h2>{g.grupa}</h2>
          <ul>
            {g.dania.map((d) => (
              <li>
                <span class="menu__nazwa">{d.n}</span>
                <span class="menu__kropki" aria-hidden="true"></span>
                <span class="menu__cena">{d.c}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="fine">
        Ceny w złotych. Informację o alergenach podaje obsługa. Kartę wegetariańską
        przygotowujemy na zgłoszenie przy rezerwacji.
      </p>
    </div>
  </section>

  <section id="kuchnia" class="band band--alt">
    <div class="wrap dwie">
      <div>
        <p class="eyebrow">Kuchnia</p>
        <h2 class="h2">Dostawcy z promienia 40 kilometrów.</h2>
        <p class="lead">
          Warzywa bierzemy z gospodarstwa w Kobyłce, pieczywo z piekarni na Legionów,
          ryby dwa razy w tygodniu z Warszawy. Kiedy czegoś nie ma, po prostu tego
          dnia nie ma tego w karcie.
        </p>
        <p class="fine">Sala na 34 miejsca. Latem osiem stolików w ogrodzie od podwórza.</p>
      </div>
      <div class="ph">Zdjęcie sali lub otwartej kuchni, wieczorowe światło</div>
    </div>
  </section>

  <section id="rezerwacja" class="band">
    <div class="wrap rez">
      <p class="eyebrow">Rezerwacja</p>
      <h2 class="h2">Dzwoń, nie pisz.</h2>
      <p class="lead">
        Nie prowadzimy rezerwacji mailowych ani formularza — przy ośmiu stolikach
        telefon jest szybszy i pewniejszy.
      </p>
      <p class="tel"><a href={`tel:${biz.phone.replace(/[^+\d]/g, '')}`}>{biz.phone}</a></p>
      <ul class="godziny">
        {biz.hours.map((h) => <li>{h}</li>)}
      </ul>
      <p class="fine">
        Ostatnie zamówienie przyjmujemy 45 minut przed zamknięciem kuchni.
      </p>
    </div>
  </section>
</Site>

<style is:global>
  /* --- TOKENY: wieczór. Ciemna, spokojna baza, jeden winny akcent,
         typografia prowadzi całą stronę zamiast zdjęć jedzenia. --- */
  :root {
    --bg: #16211d;
    --bg-alt: #1c2a25;
    --ink: #ece5da;
    --muted: #9aa9a0;
    --line: #33453d;
    --accent: #8c3b4e;
    --accent-dark: #75303f;
    --on-accent: #fdf8f2;
    --radius: 1px;
    --maxw: 1040px;
    --font-display: 'Bricolage Grotesque', system-ui, sans-serif;
    --font-body: 'Karla', system-ui, sans-serif;
    --font-mono: 'Karla', system-ui, sans-serif;
  }

  .hero { padding-block: clamp(3.5rem, 11vw, 8rem) clamp(3rem, 8vw, 6rem); }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 700; letter-spacing: -0.03em; }
  .hero h1 em { font-style: normal; color: var(--muted); }

  .lead { font-size: 1.14rem; color: var(--muted); max-width: 48ch; margin-block: 1.75rem 2rem; }

  .band--alt { background: var(--bg-alt); }

  .h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 700; letter-spacing: -0.025em; margin-bottom: 1.25rem; }

  .menu { max-width: 720px; }
  .menu__grupa { margin-bottom: 3rem; }
  .menu__grupa h2 {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--accent);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.25rem;
  }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.6rem 0;
  }
  .menu__nazwa { font-size: 1.05rem; }
  .menu__kropki {
    flex: 1;
    border-bottom: 1px dotted var(--line);
    transform: translateY(-0.25rem);
    min-width: 1.5rem;
  }
  .menu__cena { font-variant-numeric: tabular-nums; color: var(--muted); }

  .fine { font-size: 0.85rem; color: var(--muted); max-width: 58ch; }

  .dwie { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .dwie { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }

  .rez { max-width: 640px; }
  .tel { margin: 2rem 0 1.25rem; }
  .tel a {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    border-bottom: 3px solid var(--accent);
  }

  .godziny { list-style: none; margin: 0 0 1.5rem; padding: 0; color: var(--muted); }
  .godziny li { padding: 0.3rem 0; border-bottom: 1px solid var(--line); max-width: 22rem; }

  .ph {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1.5rem;
    aspect-ratio: 4 / 5;
    background: #223029;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
