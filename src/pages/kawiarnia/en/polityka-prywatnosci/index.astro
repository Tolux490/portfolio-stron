---
import Site from '../../../../layouts/Site.astro';
import Polityka from '../../../../components/Polityka.astro';
import { kawiarnia as biz } from '../../../../data/firmy.js';
const fonts = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,420&family=Albert+Sans:wght@400;500;600&display=swap';
---
<Site title={`Privacy policy — ${biz.name}`} description="How personal data is processed." fonts={fonts} biz={biz} lang="en" path="polityka-prywatnosci/">
  <Polityka biz={biz} lang="en" />
  <section class="band" style="padding-top:0">
    <div class="wrap prose">
      <h2>9. Google Maps and the loyalty card</h2>
      <p>
        The map is loaded from Google Maps only after you click “Show map”. Until then the
        website does not connect to Google's servers. After you click, Google may set its own
        cookies in line with its privacy policy.
      </p>
      <p>
        The loyalty card stores the number of stamps only in your browser's memory
        (localStorage). The data never leaves your device and is not sent anywhere.
      </p>
    </div>
  </section>
</Site>
<style is:global>
  :root {
    --bg:#f8f5ee; --bg-alt:#efeadf; --ink:#221a13; --muted:rgba(34,26,19,.62); --line:rgba(34,26,19,.14);
    --accent:#46543a; --accent-dark:#38452e; --on-accent:#f8f5ee; --radius:999px; --maxw:1040px;
    --font-display:'Fraunces',Georgia,serif;
    --font-body:'Albert Sans',system-ui,sans-serif;
    --font-mono:'Albert Sans',system-ui,sans-serif;
  }
</style>
