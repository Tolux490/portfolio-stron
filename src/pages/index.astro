---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : 'https://vervostudio.com';
const og = (p) => new URL(`${b}/og/${p}`, Astro.site || 'https://vervostudio.com/').href;

// Formularz kontaktowy trafia na ten adres przez FormSubmit (bez konta i bez klucza).
// WAŻNE: przy pierwszym wysłaniu FormSubmit przyśle na tę skrzynkę mail z linkiem
// aktywacyjnym — kliknij go jeden raz, żeby kolejne zgłoszenia dochodziły.
const email = 'antoni.antczak05@gmail.com';

const nav = [
  { href: '#realizacje', label: 'Realizacje' },
  { href: '#oferta', label: 'Oferta' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#proces', label: 'Proces' },
  { href: '#kontakt', label: 'Kontakt' },
];

const realizacje = [
  { href: `${b}/restauracja/`, nazwa: 'Ogrodowa 3', bran: 'Restauracja', opis: 'Wielostronicowa, elegancka witryna: karta i menu degustacyjne, karta win, rezerwacja online i obracany model 3D butelki wina w tle.', tagi: ['Wiele podstron', 'Rezerwacje', 'Model 3D', 'Opinie Google'] },
  { href: `${b}/oktan/`, nazwa: 'OKTAN', bran: 'Serwis samochodowy', opis: 'Mocna, „carbonowa” strona serwisu z cennikiem, umawianiem wizyt online, galerią i statusem „otwarte teraz”. Podstrona zespołu.', tagi: ['Cennik', 'Umawianie wizyt', 'Galeria', 'Status na żywo'] },
  { href: `${b}/nieruchomosci/`, nazwa: 'Kontur Nieruchomości', bran: 'Biuro nieruchomości', opis: 'Interaktywna lista ofert z filtrowaniem, sortowaniem i kalkulatorem raty. Formularz umawiania oglądań z pełną klauzulą RODO.', tagi: ['Filtrowanie ofert', 'Kalkulator raty', 'Formularz RODO'] },
  { href: `${b}/kawiarnia/`, nazwa: 'Prolog', bran: 'Kawiarnia', opis: 'Menu z filtrami kategorii, cyfrowa karta pieczątek zapisywana w telefonie i status „otwarte teraz” liczony na żywo.', tagi: ['Menu z filtrami', 'Karta pieczątek', 'Status otwarcia'] },
  { href: `${b}/mechanik/`, nazwa: 'Serwis Kołodziej', bran: 'Warsztat samochodowy', opis: 'Spokojna, „premium” odsłona warsztatu: cennik robocizny z czasem naprawy i tabliczka z dostępnością stanowisk.', tagi: ['Cennik robocizny', 'Dostępność stanowisk'] },
];

const oferta = [
  { t: 'Responsywność', o: 'Idealnie na telefonie, tablecie i komputerze, bo większość klientów wchodzi z telefonu.' },
  { t: 'Szybkość', o: 'Własny kod zamiast WordPressa i wtyczek. Strony ładują się poniżej sekundy.' },
  { t: 'Formularze', o: 'Rezerwacje, umawianie, kontakt. Działające, z powiadomieniem na e-mail i klauzulą RODO.' },
  { t: 'SEO na start', o: 'Poprawne tytuły, opisy, dane strukturalne i mapa strony, żeby Google widział Twoją firmę.' },
  { t: 'Bez banerów cookies', o: 'Nie śledzę odwiedzających, więc strona nie potrzebuje wyskakującego banera zgody. Czysto i zgodnie z RODO.' },
  { t: 'Hosting i domena', o: 'Ogarniam całość: domenę, hosting i wdrożenie. Ty dostajesz gotową, działającą stronę.' },
];

const pakiety = [
  { t: 'Wizytówka', cena: '1 500', gdy: 'od', opis: 'Jednostronicowa strona-wizytówka.', co: ['Jedna dopracowana strona', 'Formularz kontaktowy', 'Mapa i godziny', 'Podstawowe SEO', 'Gotowa w ~3 dni'], wyroz: false },
  { t: 'Strona firmowa', cena: '3 000', gdy: 'od', opis: 'Kilka sekcji lub podstron pod Twoją branżę.', co: ['Do kilku podstron', 'Galeria / cennik / oferta', 'Rezerwacje lub umawianie', 'Pełne SEO + dane strukturalne', 'Hosting i domena w cenie', 'Gotowa w 1–2 tygodnie'], wyroz: true },
  { t: 'Na miarę', cena: 'wycena', gdy: '', opis: 'Większe projekty i integracje.', co: ['Sklep / rezerwacje / panel', 'Integracje i płatności', 'Wielojęzyczność', 'Indywidualny projekt', 'Wycena po rozmowie'], wyroz: false },
];

const proces = [
  { t: 'Rozmowa', o: 'Piszesz albo dzwonisz. Pytam o firmę, klientów i cel strony. Podaję wycenę i termin.' },
  { t: 'Projekt', o: 'Przygotowuję układ i wygląd pod Twoją branżę. Ty patrzysz i mówisz, co poprawić.' },
  { t: 'Wdrożenie', o: 'Koduję, wrzucam treści i zdjęcia, podpinam domenę i formularze. Testuję na telefonie.' },
  { t: 'Opieka', o: 'Strona działa i się aktualizuje. Drobne zmiany i wsparcie masz pod ręką.' },
];

const opinie = [
  { a: 'Właściciel warsztatu', t: 'Strona gotowa w tydzień i wygląda lepiej niż u konkurencji. Telefon zaczął dzwonić częściej.' },
  { a: 'Restauracja', t: 'Zero WordPressa, ładuje się błyskawicznie, a rezerwacja online działa bez zarzutu. Goście chwalą.' },
  { a: 'Kawiarnia', t: 'Ogarnął wszystko: projekt, teksty, wdrożenie i domenę. Ja tylko przysłałam zdjęcia. Polecam.' },
];

const budzety = ['do 2 000 zł', '2 000 – 4 000 zł', '4 000 – 8 000 zł', 'powyżej 8 000 zł', 'jeszcze nie wiem'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Vervo Studio',
  description: 'Projektowanie i tworzenie stron internetowych dla lokalnych firm.',
  url: site + '/',
  email: email,
  areaServed: 'Polska',
  serviceType: 'Projektowanie stron internetowych',
  priceRange: 'od 1500 zł',
  image: og('vervo.png'),
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vervo Studio — strony internetowe dla lokalnych firm</title>
    <meta name="description" content="Projektuję i buduję szybkie, responsywne strony internetowe dla lokalnych firm. Bez WordPressa, bez cookies, gotowe w kilka dni. Zobacz realizacje i napisz po wycenę." />
    <link rel="canonical" href={site + '/'} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Vervo Studio" />
    <meta property="og:title" content="Vervo Studio — strony internetowe dla lokalnych firm" />
    <meta property="og:description" content="Szybkie, responsywne strony dla lokalnych firm. Bez WordPressa, bez cookies. Zobacz realizacje." />
    <meta property="og:image" content={og('vervo.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Vervo Studio — strony internetowe dla lokalnych firm" />
    <meta name="twitter:description" content="Szybkie, responsywne strony dla lokalnych firm. Zobacz realizacje." />
    <meta name="twitter:image" content={og('vervo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800;900&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <header class="hdr" id="hdr">
      <div class="wrap hdr__in">
        <a class="brand" href="#gora" aria-label="Vervo Studio">
          <svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand__tx">Vervo <em>Studio</em></span>
        </a>
        <nav class="nav" aria-label="Nawigacja">{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
        <a class="btn btn--dark hdr__cta" href="#kontakt">Napisz do mnie</a>
        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span></button>
      </div>
    </header>

    <div class="drawer" id="drawer">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#kontakt">Napisz do mnie</a>
    </div>

    <main id="gora">
      <!-- HERO -->
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">Vervo Studio · strony dla firm</p>
          <h1>Strony internetowe,<br />które <span class="u">przynoszą klientów</span></h1>
          <p class="hero__lede">
            Projektuję i koduję strony dla lokalnych firm: restauracji, warsztatów, kawiarni, biur.
            Szybkie, ładne na telefonie, bez WordPressa i bez cookies. Gotowe w kilka dni.
          </p>
          <div class="hero__cta">
            <a class="btn btn--dark" href="#kontakt">Zamów stronę</a>
            <a class="btn btn--line" href="#realizacje">Zobacz realizacje</a>
          </div>
          <ul class="hero__facts">
            <li><b>&lt;1 s</b> czas ładowania</li>
            <li><b>100%</b> na telefonie</li>
            <li><b>~3 dni</b> na prostą stronę</li>
            <li><b>Bez</b> WordPressa i wtyczek</li>
          </ul>
        </div>
      </section>

      <!-- REALIZACJE -->
      <section class="band" id="realizacje">
        <div class="wrap">
          <div class="sec__head">
            <div><p class="label">Portfolio</p><h2 class="h2">Wybrane realizacje</h2></div>
            <p class="sec__note">Przykładowe projekty. Kliknij, żeby zobaczyć każdy na żywo. To działające dema, treści są przykładowe.</p>
          </div>
          <div class="works">
            {realizacje.map((r) => (
              <a class="work" href={r.href}>
                <div class="work__top">
                  <span class="work__bran">{r.bran}</span>
                  <span class="work__go" aria-hidden="true">Zobacz na żywo ↗</span>
                </div>
                <h3>{r.nazwa}</h3>
                <p>{r.opis}</p>
                <ul class="tags">{r.tagi.map((t) => <li>{t}</li>)}</ul>
              </a>
            ))}
            <a class="work work--project" href="https://tolux490.github.io/Fiches/" target="_blank" rel="noopener">
              <div class="work__top"><span class="work__bran">Projekt własny</span><span class="work__go" aria-hidden="true">Otwórz ↗</span></div>
              <h3>Fiches</h3>
              <p>Aplikacja do nauki francuskiego, z fiszkami generowanymi przez AI. Dowód, że nie tylko projektuję, ale też koduję.</p>
              <ul class="tags"><li>Aplikacja</li><li>AI</li><li>Własny kod</li></ul>
            </a>
          </div>
        </div>
      </section>

      <!-- OFERTA -->
      <section class="band band--alt" id="oferta">
        <div class="wrap">
          <div class="sec__head"><div><p class="label">Oferta</p><h2 class="h2">Co dostajesz w cenie</h2></div></div>
          <div class="offer">
            {oferta.map((o) => (
              <div class="offer__i">
                <span class="offer__ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>
                </span>
                <div><h3>{o.t}</h3><p>{o.o}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CENNIK -->
      <section class="band" id="cennik">
        <div class="wrap">
          <div class="sec__head"><div><p class="label">Cennik</p><h2 class="h2">Proste pakiety, jasne ceny</h2></div></div>
          <div class="plans">
            {pakiety.map((p) => (
              <div class={`plan${p.wyroz ? ' plan--hot' : ''}`}>
                {p.wyroz && <span class="plan__badge">Najczęściej wybierany</span>}
                <h3>{p.t}</h3>
                <p class="plan__desc">{p.opis}</p>
                <p class="plan__price">{p.gdy && <span>{p.gdy} </span>}{p.cena}{p.cena !== 'wycena' && <small> zł</small>}</p>
                <ul class="plan__co">{p.co.map((c) => <li>{c}</li>)}</ul>
                <a class={`btn ${p.wyroz ? 'btn--dark' : 'btn--line'} plan__btn`} href="#kontakt">Wybieram</a>
              </div>
            ))}
          </div>
          <p class="fineprint">Ceny orientacyjne, netto. Dokładną wycenę podaję po krótkiej rozmowie o Twojej firmie. Opieka po wdrożeniu od 60 zł/mies.</p>
        </div>
      </section>

      <!-- PROCES -->
      <section class="band band--alt" id="proces">
        <div class="wrap">
          <div class="sec__head"><div><p class="label">Proces</p><h2 class="h2">Jak to wygląda krok po kroku</h2></div></div>
          <div class="steps">
            {proces.map((s, i) => (
              <div class="step"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.o}</p></div>
            ))}
          </div>
        </div>
      </section>

      <!-- O MNIE -->
      <section class="band">
        <div class="wrap about">
          <div>
            <p class="label">O mnie</p>
            <h2 class="h2">Cześć, tu Antoni</h2>
            <p class="about__p">
              Projektuję i koduję strony dla lokalnych firm, sam od początku do końca. Bez WordPressa, bez wtyczek,
              które się psują, i bez ukrytych kosztów. Każdą stronę piszę własnym kodem, więc jest szybka, lekka i dokładnie taka, jaka ma być.
            </p>
            <p class="about__p">
              Zależy mi, żeby Twoja strona nie była tylko ładna, ale realnie przynosiła telefony i rezerwacje.
              Dlatego dbam o szybkość, telefon i o to, żeby klient od razu wiedział, co ma zrobić.
            </p>
          </div>
          <div class="why">
            <div class="why__i"><b>Własny kod</b><span>Bez WordPressa i wtyczek. Nic się nie zawiesza.</span></div>
            <div class="why__i"><b>Szybkość</b><span>Strony ładują się poniżej sekundy.</span></div>
            <div class="why__i"><b>Terminy</b><span>Prosta strona w kilka dni, nie tygodni.</span></div>
            <div class="why__i"><b>Opieka</b><span>Po wdrożeniu nie zostajesz sam.</span></div>
          </div>
        </div>
      </section>

      <!-- OPINIE -->
      <section class="band band--alt">
        <div class="wrap">
          <div class="sec__head"><div><p class="label">Opinie</p><h2 class="h2">Co mówią klienci</h2></div></div>
          <div class="quotes">
            {opinie.map((o) => (
              <figure class="quote"><blockquote>„{o.t}”</blockquote><figcaption>{o.a}</figcaption></figure>
            ))}
          </div>
          <p class="fineprint">Opinie przykładowe. Portfolio jest w budowie, prawdziwe referencje dodaję na bieżąco.</p>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="band" id="kontakt">
        <div class="wrap contact">
          <div>
            <p class="label">Kontakt</p>
            <h2 class="h2">Napisz, wycenię za darmo</h2>
            <p class="about__p">Opisz krótko swoją firmę i czego potrzebujesz. Odpiszę zwykle tego samego dnia z wyceną i terminem, bez zobowiązań.</p>
            <div class="contact__links">
              <a href={`mailto:${email}`}>{email}</a>
            </div>
          </div>
          <form id="kForm" novalidate>
            <div class="frow">
              <label class="fld"><span>Imię</span><input type="text" name="imie" autocomplete="name" required /></label>
              <label class="fld"><span>E-mail</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <div class="frow">
              <label class="fld"><span>Branża / rodzaj firmy <em>(opcjonalnie)</em></span><input type="text" name="branza" placeholder="np. warsztat, kawiarnia" /></label>
              <label class="fld"><span>Budżet</span>
                <select name="budzet" required><option value="">Wybierz</option>{budzety.map((x) => <option value={x}>{x}</option>)}</select>
              </label>
            </div>
            <label class="fld"><span>Wiadomość</span><textarea name="wiadomosc" rows="4" placeholder="Kilka zdań o firmie i tym, czego potrzebujesz." required></textarea></label>
            <label class="consent"><input type="checkbox" name="zgoda" value="tak" required /><span>Zgadzam się na kontakt w sprawie mojego zapytania.</span></label>
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0" />
            <button class="btn btn--dark kbtn" type="submit" id="kBtn">Wyślij zapytanie</button>
            <p class="kstat" id="kStat" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <a class="brand brand--foot" href="#gora">
          <svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand__tx">Vervo <em>Studio</em></span>
        </a>
        <p class="foot__tx">Strony internetowe dla lokalnych firm. Projekt, kod, wdrożenie i opieka w jednym miejscu.</p>
        <p class="foot__legal">© {new Date().getFullYear()} Vervo Studio · <a href={`mailto:${email}`}>{email}</a></p>
      </div>
    </footer>

    <script define:vars={{ email }}>
      const hdr = document.getElementById('hdr');
      const onScroll = () => hdr?.classList.toggle('stuck', window.scrollY > 20);
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
      const burger = document.getElementById('burger');
      const setMenu = (o) => { const v = o ?? !document.body.classList.contains('menu-open'); document.body.classList.toggle('menu-open', v); burger?.setAttribute('aria-expanded', String(v)); };
      burger?.addEventListener('click', () => setMenu());
      document.querySelectorAll('#drawer a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      const form = document.getElementById('kForm'), stat = document.getElementById('kStat'), btn = document.getElementById('kBtn');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault(); stat.textContent = ''; stat.className = 'kstat';
        let ok = true;
        form.querySelectorAll('[required]').forEach((p) => {
          if (p.type === 'checkbox') { if (!p.checked) ok = false; return; }
          if (!p.value.trim()) { p.closest('.fld')?.classList.add('bad'); ok = false; } else { p.closest('.fld')?.classList.remove('bad'); }
        });
        if (!ok) { stat.textContent = 'Uzupełnij wymagane pola i zgodę.'; stat.classList.add('err'); return; }
        const d = Object.fromEntries(new FormData(form).entries());
        if (d._honey) return; // pułapka na boty
        try {
          btn.disabled = true; btn.textContent = 'Wysyłanie…';
          const res = await fetch('https://formsubmit.co/ajax/' + email, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              _subject: 'Nowe zapytanie ze strony Vervo Studio',
              _template: 'table',
              _captcha: 'false',
              'Imię': d.imie, 'E-mail': d.email, 'Branża': d.branza || '(nie podano)', 'Budżet': d.budzet, 'Wiadomość': d.wiadomosc,
            }),
          });
          const r = await res.json();
          if (r.success === true || r.success === 'true') { stat.textContent = 'Dziękuję! Zapytanie wysłane, odezwę się zwykle tego samego dnia.'; stat.classList.add('ok'); form.reset(); }
          else throw 0;
        } catch { stat.textContent = 'Nie udało się wysłać. Napisz bezpośrednio na ' + email; stat.classList.add('err'); }
        finally { btn.disabled = false; btn.textContent = 'Wyślij zapytanie'; }
      });
    </script>

    <style is:global>
      :root {
        --paper: #f7f6f2; --paper-2: #efede7; --card: #ffffff;
        --ink: #17191d; --ink-2: #3a3d44; --muted: #6c7075; --line: #e3e1da; --line-2: #d3d0c7;
        /* monochrom: „gold" = ciemny atrament (akcent na jasnym), „gold-2" = krem (akcent na ciemnym) */
        --gold: #17191d; --gold-2: #efede7; --dark: #17191d;
        --font-d: 'Public Sans', system-ui, sans-serif; --font-b: 'Public Sans', system-ui, sans-serif;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1); --maxw: 1180px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-b); font-size: 1rem; line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; cursor: pointer; }
      :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
      h1, h2, h3 { font-family: var(--font-d); font-weight: 800; line-height: 1.04; letter-spacing: -0.02em; margin: 0; }
      p { margin: 0; }
      .wrap { width: min(100% - 2.5rem, var(--maxw)); margin-inline: auto; }
      .band { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
      .band--alt { background: var(--paper-2); }
      .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem; }
      .h2 { font-size: clamp(1.9rem, 4.4vw, 3rem); }
      .eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); margin-bottom: 1.4rem; }
      .u { background: linear-gradient(transparent 62%, rgba(23,25,29,0.12) 0); }
      .fineprint { font-size: 0.82rem; color: var(--muted); margin-top: 1.75rem; max-width: 62ch; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.95rem 1.7rem; font-weight: 700; font-size: 0.9rem; border-radius: 3px; border: 2px solid transparent; transition: all 0.25s var(--ease); }
      .btn--dark { background: var(--dark); color: var(--paper); border-color: var(--dark); }
      .btn--dark:hover { background: transparent; color: var(--dark); }
      .btn--line { border-color: var(--line-2); color: var(--ink); }
      .btn--line:hover { border-color: var(--dark); }

      /* nagłówek */
      .hdr { position: fixed; inset: 0 0 auto 0; z-index: 80; padding-block: 1.1rem; transition: all 0.3s var(--ease); border-bottom: 1px solid transparent; }
      .hdr.stuck { background: rgba(247,246,242,0.9); backdrop-filter: blur(12px); padding-block: 0.7rem; border-bottom-color: var(--line); }
      .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
      .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); }
      .brand__mk { width: 30px; height: 27px; color: var(--gold); flex: none; }
      .brand__tx { font-family: var(--font-d); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; }
      .brand__tx em { font-style: normal; color: var(--muted); }
      .nav { display: none; gap: 1.8rem; }
      .nav a { font-size: 0.9rem; font-weight: 600; color: var(--ink-2); transition: color 0.2s; }
      .nav a:hover { color: var(--ink); }
      .hdr__cta { display: none; padding: 0.6rem 1.2rem; }
      @media (min-width: 900px) { .nav { display: flex; } .hdr__cta { display: inline-flex; } .burger { display: none; } }
      .burger { width: 2.6rem; height: 2.6rem; display: grid; place-items: center; background: none; border: 0; position: relative; z-index: 90; }
      .burger span, .burger span::before, .burger span::after { content: ''; display: block; width: 22px; height: 2px; background: var(--ink); position: relative; transition: transform 0.3s var(--ease), opacity 0.3s; }
      .burger span::before { position: absolute; top: -7px; } .burger span::after { position: absolute; top: 7px; }
      body.menu-open .burger span { background: transparent; }
      body.menu-open .burger span::before { transform: translateY(7px) rotate(45deg); }
      body.menu-open .burger span::after { transform: translateY(-7px) rotate(-45deg); }
      .drawer { position: fixed; inset: 0; z-index: 85; background: var(--paper); display: flex; flex-direction: column; justify-content: center; gap: 0.3rem; padding: 5rem 2rem; opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; }
      body.menu-open .drawer { opacity: 1; visibility: visible; }
      .drawer a { font-family: var(--font-d); font-weight: 800; font-size: 2rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
      @media (min-width: 900px) { .drawer, .burger { display: none; } }

      /* hero */
      .hero { padding-top: clamp(8rem, 18vh, 12rem); padding-bottom: clamp(3rem, 8vw, 5rem); }
      .hero h1 { font-size: clamp(2.6rem, 7vw, 5.2rem); }
      .hero__lede { font-size: clamp(1.05rem, 1.8vw, 1.3rem); color: var(--ink-2); max-width: 52ch; margin-top: 1.6rem; }
      .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
      .hero__facts { list-style: none; margin: 3rem 0 0; padding: 2rem 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
      @media (min-width: 720px) { .hero__facts { grid-template-columns: repeat(4, 1fr); } }
      .hero__facts li { color: var(--muted); font-size: 0.9rem; }
      .hero__facts b { display: block; font-family: var(--font-d); font-weight: 800; font-size: 1.9rem; color: var(--ink); letter-spacing: -0.03em; }

      .sec__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2.5rem; }
      .sec__note { color: var(--muted); font-size: 0.9rem; max-width: 42ch; }

      /* realizacje */
      .works { display: grid; gap: 1.25rem; }
      @media (min-width: 720px) { .works { grid-template-columns: repeat(2, 1fr); } }
      .work { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 1.8rem; display: flex; flex-direction: column; gap: 0.75rem; transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s; }
      .work:hover { transform: translateY(-4px); border-color: var(--line-2); box-shadow: 0 18px 40px -22px rgba(0,0,0,0.35); }
      .work__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .work__bran { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gold); }
      .work__go { font-size: 0.8rem; font-weight: 600; color: var(--muted); transition: color 0.2s; }
      .work:hover .work__go { color: var(--ink); }
      .work h3 { font-size: 1.7rem; }
      .work p { color: var(--ink-2); font-size: 0.95rem; flex: 1; }
      .tags { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .tags li { font-size: 0.72rem; font-weight: 600; color: var(--ink-2); background: var(--paper-2); border: 1px solid var(--line); border-radius: 20px; padding: 0.25rem 0.7rem; }
      .work--project { background: var(--dark); border-color: var(--dark); color: var(--paper); }
      .work--project .work__bran { color: var(--gold-2); } .work--project p { color: rgba(247,246,242,0.75); }
      .work--project .work__go { color: rgba(247,246,242,0.6); } .work--project:hover .work__go { color: var(--paper); }
      .work--project .tags li { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.16); color: var(--paper); }

      /* oferta */
      .offer { display: grid; gap: 1.5rem 2.5rem; }
      @media (min-width: 620px) { .offer { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 980px) { .offer { grid-template-columns: repeat(3, 1fr); } }
      .offer__i { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; }
      .offer__ic { width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--dark); color: var(--gold-2); display: grid; place-items: center; flex: none; }
      .offer__ic svg { width: 1.1rem; height: 1.1rem; }
      .offer__i h3 { font-size: 1.2rem; margin-bottom: 0.3rem; }
      .offer__i p { color: var(--ink-2); font-size: 0.92rem; }

      /* cennik */
      .plans { display: grid; gap: 1.25rem; }
      @media (min-width: 860px) { .plans { grid-template-columns: repeat(3, 1fr); align-items: start; } }
      .plan { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 2rem 1.8rem; position: relative; display: flex; flex-direction: column; }
      .plan--hot { border-color: var(--dark); border-width: 2px; }
      .plan__badge { position: absolute; top: -0.75rem; left: 1.8rem; background: var(--dark); color: var(--paper); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.3rem 0.7rem; border-radius: 3px; }
      .plan h3 { font-size: 1.5rem; }
      .plan__desc { color: var(--muted); font-size: 0.9rem; margin: 0.4rem 0 1.1rem; }
      .plan__price { font-family: var(--font-d); font-weight: 800; font-size: 2.4rem; letter-spacing: -0.03em; margin-bottom: 1.2rem; }
      .plan__price span { font-size: 0.9rem; font-weight: 600; color: var(--muted); letter-spacing: 0; }
      .plan__price small { font-size: 1rem; color: var(--muted); }
      .plan__co { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 0.6rem; flex: 1; }
      .plan__co li { position: relative; padding-left: 1.4rem; font-size: 0.9rem; color: var(--ink-2); }
      .plan__co li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 800; }
      .plan__btn { width: 100%; }

      /* proces */
      .steps { display: grid; gap: 1.25rem; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(4, 1fr); } }
      .step { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 1.75rem 1.5rem; }
      .step__n { font-family: var(--font-d); font-weight: 800; font-size: 1.4rem; color: var(--gold); }
      .step h3 { font-size: 1.25rem; margin: 0.5rem 0 0.5rem; }
      .step p { color: var(--ink-2); font-size: 0.9rem; }

      /* o mnie */
      .about { display: grid; gap: 2.5rem; }
      @media (min-width: 900px) { .about { grid-template-columns: 1.25fr 0.75fr; gap: 4rem; align-items: start; } }
      .about__p { color: var(--ink-2); margin-top: 1.1rem; max-width: 60ch; }
      .why { display: grid; gap: 0; align-self: stretch; }
      .why__i { padding: 1.1rem 0; border-top: 1px solid var(--line); }
      .why__i:last-child { border-bottom: 1px solid var(--line); }
      .why__i b { font-family: var(--font-d); font-weight: 800; font-size: 1.1rem; display: block; }
      .why__i span { color: var(--muted); font-size: 0.9rem; }

      /* opinie */
      .quotes { display: grid; gap: 1.25rem; }
      @media (min-width: 820px) { .quotes { grid-template-columns: repeat(3, 1fr); } }
      .quote { margin: 0; background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 1.75rem; }
      .quote blockquote { margin: 0; font-size: 1.02rem; color: var(--ink); line-height: 1.55; }
      .quote figcaption { margin-top: 1rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); }

      /* kontakt */
      .contact { display: grid; gap: 2.5rem; }
      @media (min-width: 900px) { .contact { grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: start; } }
      .contact__links { display: grid; gap: 0.4rem; margin-top: 1.5rem; }
      .contact__links a { font-family: var(--font-d); font-weight: 800; font-size: 1.3rem; color: var(--ink); }
      .contact__links a:hover { color: var(--gold); }
      #kForm { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: clamp(1.5rem, 3vw, 2.25rem); }
      .frow { display: grid; gap: 1rem; margin-bottom: 1rem; }
      @media (min-width: 560px) { .frow { grid-template-columns: 1fr 1fr; } }
      .fld { display: block; margin-bottom: 1rem; }
      .fld > span { display: block; font-size: 0.78rem; font-weight: 700; color: var(--ink-2); margin-bottom: 0.4rem; }
      .fld em { font-style: normal; font-weight: 400; color: var(--muted); }
      .fld input, .fld select, .fld textarea { width: 100%; background: var(--paper); border: 1px solid var(--line-2); border-radius: 4px; padding: 0.75rem 0.85rem; font: inherit; color: var(--ink); }
      .fld textarea { resize: vertical; }
      .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--gold); }
      .fld.bad input, .fld.bad select, .fld.bad textarea { border-color: #c0392b; }
      .consent { display: flex; gap: 0.6rem; font-size: 0.85rem; color: var(--ink-2); margin: 0.5rem 0 1.2rem; cursor: pointer; }
      .consent input { margin-top: 0.2rem; width: 1rem; height: 1rem; accent-color: var(--gold); flex: none; }
      .kbtn { width: 100%; }
      .kstat { margin-top: 0.9rem; font-size: 0.88rem; min-height: 1.2em; }
      .kstat.ok { color: #2e7d46; } .kstat.err { color: #c0392b; }

      /* stopka */
      .foot { border-top: 1px solid var(--line); padding-block: 3rem; }
      .foot__in { display: grid; gap: 1rem; }
      .foot__tx { color: var(--muted); max-width: 44ch; }
      .foot__legal { font-size: 0.82rem; color: var(--muted); }
      .foot__legal a { color: var(--ink-2); }
      .brand--foot .brand__mk { color: var(--gold); }
    </style>
  </body>
</html>
