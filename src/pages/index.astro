---
import Cosmos from '../components/Cosmos.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : 'https://vervostudio.com';
const og = (p) => new URL(`${b}/og/${p}`, Astro.site || 'https://vervostudio.com/').href;

// Formularz trafia na ten adres przez FormSubmit (bez konta i klucza).
// WAŻNE: przy pierwszym wysłaniu FormSubmit przyśle na tę skrzynkę mail z linkiem aktywacyjnym — kliknij go raz.
const email = 'antoni.antczak05@gmail.com';

const nav = [
  { href: '#gora', label: 'Start' },
  { href: '#realizacje', label: 'Realizacje' },
  { href: '#oferta', label: 'Oferta' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#kontakt', label: 'Kontakt' },
];

const realizacje = [
  { href: `${b}/restauracja/`, nazwa: 'Ogrodowa 3', bran: 'Restauracja', opis: 'Wielostronicowa, elegancka witryna: karta i menu degustacyjne, karta win, rezerwacja online i obracany model 3D butelki wina w tle.', tagi: ['Wiele podstron', 'Rezerwacje', 'Model 3D', 'Opinie Google'] },
  { href: `${b}/oktan/`, nazwa: 'OKTAN', bran: 'Serwis samochodowy', opis: 'Mocna, „carbonowa” strona serwisu z cennikiem, umawianiem wizyt online, galerią i statusem „otwarte teraz”. Z podstroną zespołu.', tagi: ['Cennik', 'Umawianie wizyt', 'Galeria', 'Status na żywo'] },
  { href: `${b}/nieruchomosci/`, nazwa: 'Kontur Nieruchomości', bran: 'Biuro nieruchomości', opis: 'Interaktywna lista ofert z filtrowaniem, sortowaniem i kalkulatorem raty. Formularz umawiania oglądań z pełną klauzulą RODO.', tagi: ['Filtrowanie ofert', 'Kalkulator raty', 'Formularz RODO'] },
  { href: `${b}/kawiarnia/`, nazwa: 'Prolog', bran: 'Kawiarnia', opis: 'Menu z filtrami kategorii, cyfrowa karta pieczątek zapisywana w telefonie i status „otwarte teraz” liczony na żywo.', tagi: ['Menu z filtrami', 'Karta pieczątek', 'Status otwarcia'] },
  { href: `${b}/mechanik/`, nazwa: 'Serwis Kołodziej', bran: 'Warsztat samochodowy', opis: 'Spokojna, „premium” odsłona warsztatu: cennik robocizny z czasem naprawy i tabliczka z dostępnością stanowisk.', tagi: ['Cennik robocizny', 'Dostępność stanowisk'] },
];

const oferta = [
  { t: 'Responsywność', o: 'Idealnie na telefonie, tablecie i komputerze, bo większość klientów wchodzi z telefonu.' },
  { t: 'Szybkość', o: 'Własny kod zamiast WordPressa i wtyczek. Strony ładują się poniżej sekundy.' },
  { t: 'Formularze', o: 'Rezerwacje, umawianie, kontakt. Działające, z powiadomieniem na e-mail i klauzulą RODO.' },
  { t: 'SEO na start', o: 'Poprawne tytuły, opisy, dane strukturalne i mapa strony, żeby Google widział Twoją firmę.' },
  { t: 'Bez banerów cookies', o: 'Nie śledzę odwiedzających, więc strona nie potrzebuje wyskakującego banera zgody. Czysto i zgodnie z RODO.' },
  { t: 'Hosting i domena', o: 'Ogarniam całość: domenę, hosting i wdrożenie. Ty dostajesz gotową, działającą stronę.' },
];

const pakiety = [
  { t: 'Wizytówka', cena: '1 500', gdy: 'od', opis: 'Jednostronicowa strona-wizytówka.', co: ['Jedna dopracowana strona', 'Formularz kontaktowy', 'Mapa i godziny', 'Podstawowe SEO', 'Gotowa w ~3 dni'], wyroz: false },
  { t: 'Strona firmowa', cena: '3 000', gdy: 'od', opis: 'Kilka sekcji lub podstron pod Twoją branżę.', co: ['Do kilku podstron', 'Galeria / cennik / oferta', 'Rezerwacje lub umawianie', 'Pełne SEO + dane strukturalne', 'Hosting i domena w cenie', 'Gotowa w 1–2 tygodnie'], wyroz: true },
  { t: 'Na miarę', cena: 'wycena', gdy: '', opis: 'Większe projekty i integracje.', co: ['Sklep / rezerwacje / panel', 'Integracje i płatności', 'Wielojęzyczność', 'Indywidualny projekt', 'Wycena po rozmowie'], wyroz: false },
];

const proces = [
  { t: 'Rozmowa', o: 'Piszesz albo dzwonisz. Pytam o firmę, klientów i cel strony. Podaję wycenę i termin.' },
  { t: 'Projekt', o: 'Przygotowuję układ i wygląd pod Twoją branżę. Ty patrzysz i mówisz, co poprawić.' },
  { t: 'Wdrożenie', o: 'Koduję, wrzucam treści i zdjęcia, podpinam domenę i formularze. Testuję na telefonie.' },
  { t: 'Opieka', o: 'Strona działa i się aktualizuje. Drobne zmiany i wsparcie masz pod ręką.' },
];

const opinie = [
  { a: 'Właściciel warsztatu', t: 'Strona gotowa w tydzień i wygląda lepiej niż u konkurencji. Telefon zaczął dzwonić częściej.' },
  { a: 'Restauracja', t: 'Zero WordPressa, ładuje się błyskawicznie, a rezerwacja online działa bez zarzutu. Goście chwalą.' },
  { a: 'Kawiarnia', t: 'Ogarnął wszystko: projekt, teksty, wdrożenie i domenę. Ja tylko przysłałam zdjęcia. Polecam.' },
];

const budzety = ['do 2 000 zł', '2 000 – 4 000 zł', '4 000 – 8 000 zł', 'powyżej 8 000 zł', 'jeszcze nie wiem'];

const schema = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Vervo Studio',
  description: 'Projektowanie i tworzenie stron internetowych dla lokalnych firm.',
  url: site + '/', email, areaServed: 'Polska', serviceType: 'Projektowanie stron internetowych',
  priceRange: 'od 1500 zł', image: og('vervo.png'),
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vervo Studio — strony internetowe dla lokalnych firm</title>
    <meta name="description" content="Projektuję i buduję szybkie, responsywne strony internetowe dla lokalnych firm. Bez WordPressa, bez cookies, gotowe w kilka dni. Zobacz realizacje i napisz po wycenę." />
    <link rel="canonical" href={site + '/'} />
    <meta name="theme-color" content="#05060b" />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Vervo Studio" />
    <meta property="og:title" content="Vervo Studio — strony internetowe dla lokalnych firm" />
    <meta property="og:description" content="Szybkie, responsywne strony dla lokalnych firm. Bez WordPressa, bez cookies. Zobacz realizacje." />
    <meta property="og:image" content={og('vervo.png')} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og('vervo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Public+Sans:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Cosmos />

    <!-- NAVBAR -->
    <header class="nav" id="nav">
      <div class="nav__in">
        <a class="brand ent" href="#gora" data-d="0">
          <svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Vervo <em>Studio</em></span>
        </a>
        <button class="pill ent" id="menuBtn" data-d="200" aria-expanded="false"><span id="pillLabel">Menu</span></button>
        <a class="nav__cta ent" href="#kontakt" data-d="400">Napisz do mnie</a>
        <button class="burger ent" id="burger" data-d="200" aria-label="Menu"><span></span></button>
      </div>
    </header>

    <!-- OVERLAY MENU -->
    <div class="overlay" id="overlay">
      <nav class="overlay__nav">
        {nav.map((l, i) => <a class="ol" href={l.href} style={`--i:${i}`}>{l.label}</a>)}
      </nav>
      <a class="overlay__mail" href={`mailto:${email}`}>{email}</a>
    </div>

    <main id="gora">
      <!-- HERO -->
      <section class="hero">
        <div class="hero__in">
          <p class="hero__kicker ent2" data-d="300">Vervo Studio · strony dla firm</p>
          <h1 class="hero__h1 ent2" data-d="450">Strony internetowe,<br />które przyciągają uwagę</h1>
          <p class="hero__sub ent2" data-d="650">Projektuję i koduję strony dla lokalnych firm. Szybkie, dopracowane, gotowe w kilka dni.</p>
          <div class="hero__cta ent2" data-d="800">
            <a class="btn btn--light" href="#kontakt">Zamów stronę</a>
            <a class="btn btn--ghost" href="#realizacje">Zobacz realizacje</a>
          </div>
        </div>
        <span class="scrollhint">przewiń</span>
      </section>

      <!-- REALIZACJE -->
      <section class="sec" id="realizacje">
        <div class="wrap">
          <div class="head reveal"><div><p class="label">Portfolio</p><h2 class="h2">Wybrane realizacje</h2></div>
            <p class="head__note">Przykładowe projekty. Kliknij, żeby zobaczyć każdy na żywo. To działające dema, treści są przykładowe.</p></div>
          <div class="works">
            {realizacje.map((r) => (
              <a class="work reveal" href={r.href}>
                <div class="work__top"><span class="work__bran">{r.bran}</span><span class="work__go">Zobacz na żywo ↗</span></div>
                <h3>{r.nazwa}</h3><p>{r.opis}</p>
                <ul class="tags">{r.tagi.map((t) => <li>{t}</li>)}</ul>
              </a>
            ))}
            <a class="work work--fi reveal" href="https://tolux490.github.io/Fiches/" target="_blank" rel="noopener">
              <div class="work__top"><span class="work__bran">Projekt własny</span><span class="work__go">Otwórz ↗</span></div>
              <h3>Fiches</h3><p>Aplikacja do nauki francuskiego, z fiszkami generowanymi przez AI. Dowód, że nie tylko projektuję, ale też koduję.</p>
              <ul class="tags"><li>Aplikacja</li><li>AI</li><li>Własny kod</li></ul>
            </a>
          </div>
        </div>
      </section>

      <!-- OFERTA -->
      <section class="sec" id="oferta">
        <div class="wrap">
          <div class="head reveal"><div><p class="label">Oferta</p><h2 class="h2">Co dostajesz w cenie</h2></div></div>
          <div class="offer">
            {oferta.map((o) => (
              <div class="offer__i reveal">
                <span class="offer__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg></span>
                <div><h3>{o.t}</h3><p>{o.o}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CENNIK -->
      <section class="sec" id="cennik">
        <div class="wrap">
          <div class="head reveal"><div><p class="label">Cennik</p><h2 class="h2">Proste pakiety, jasne ceny</h2></div></div>
          <div class="plans">
            {pakiety.map((p) => (
              <div class={`plan reveal${p.wyroz ? ' plan--hot' : ''}`}>
                {p.wyroz && <span class="plan__badge">Najczęściej wybierany</span>}
                <h3>{p.t}</h3><p class="plan__desc">{p.opis}</p>
                <p class="plan__price">{p.gdy && <span>{p.gdy} </span>}{p.cena}{p.cena !== 'wycena' && <small> zł</small>}</p>
                <ul class="plan__co">{p.co.map((c) => <li>{c}</li>)}</ul>
                <a class={`btn ${p.wyroz ? 'btn--light' : 'btn--ghost'} plan__btn`} href="#kontakt">Wybieram</a>
              </div>
            ))}
          </div>
          <p class="fine reveal">Ceny orientacyjne, netto. Dokładną wycenę podaję po krótkiej rozmowie o Twojej firmie. Opieka po wdrożeniu od 60 zł/mies.</p>
        </div>
      </section>

      <!-- PROCES + O MNIE -->
      <section class="sec" id="proces">
        <div class="wrap">
          <div class="head reveal"><div><p class="label">Proces</p><h2 class="h2">Jak to wygląda krok po kroku</h2></div></div>
          <div class="steps">
            {proces.map((s, i) => (<div class="step reveal"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.o}</p></div>))}
          </div>
          <div class="about reveal">
            <div><p class="label">O mnie</p><h2 class="h2">Cześć, tu Antoni</h2>
              <p class="about__p">Projektuję i koduję strony dla lokalnych firm, sam od początku do końca. Bez WordPressa, bez wtyczek, które się psują, i bez ukrytych kosztów. Każdą stronę piszę własnym kodem, więc jest szybka, lekka i dokładnie taka, jaka ma być.</p>
              <p class="about__p">Zależy mi, żeby Twoja strona nie była tylko ładna, ale realnie przynosiła telefony i rezerwacje.</p>
            </div>
            <div class="why">
              <div class="why__i"><b>Własny kod</b><span>Bez WordPressa i wtyczek. Nic się nie zawiesza.</span></div>
              <div class="why__i"><b>Szybkość</b><span>Strony ładują się poniżej sekundy.</span></div>
              <div class="why__i"><b>Terminy</b><span>Prosta strona w kilka dni, nie tygodni.</span></div>
              <div class="why__i"><b>Opieka</b><span>Po wdrożeniu nie zostajesz sam.</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- OPINIE -->
      <section class="sec">
        <div class="wrap">
          <div class="head reveal"><div><p class="label">Opinie</p><h2 class="h2">Co mówią klienci</h2></div></div>
          <div class="quotes">
            {opinie.map((o) => (<figure class="quote reveal"><blockquote>„{o.t}”</blockquote><figcaption>{o.a}</figcaption></figure>))}
          </div>
          <p class="fine reveal">Opinie przykładowe. Portfolio jest w budowie, prawdziwe referencje dodaję na bieżąco.</p>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="sec" id="kontakt">
        <div class="wrap contact">
          <div class="reveal">
            <p class="label">Kontakt</p><h2 class="h2">Napisz, wycenię za darmo</h2>
            <p class="about__p">Opisz krótko swoją firmę i czego potrzebujesz. Odpiszę zwykle tego samego dnia z wyceną i terminem, bez zobowiązań.</p>
            <div class="contact__links"><a href={`mailto:${email}`}>{email}</a></div>
          </div>
          <form id="kForm" class="reveal" novalidate>
            <div class="frow">
              <label class="fld"><span>Imię</span><input type="text" name="imie" autocomplete="name" required /></label>
              <label class="fld"><span>E-mail</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <div class="frow">
              <label class="fld"><span>Branża / rodzaj firmy <em>(opcjonalnie)</em></span><input type="text" name="branza" placeholder="np. warsztat, kawiarnia" /></label>
              <label class="fld"><span>Budżet</span><select name="budzet" required><option value="">Wybierz</option>{budzety.map((x) => <option value={x}>{x}</option>)}</select></label>
            </div>
            <label class="fld"><span>Wiadomość</span><textarea name="wiadomosc" rows="4" placeholder="Kilka zdań o firmie i tym, czego potrzebujesz." required></textarea></label>
            <label class="consent"><input type="checkbox" name="zgoda" value="tak" required /><span>Zgadzam się na kontakt w sprawie mojego zapytania.</span></label>
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0" />
            <button class="btn btn--light kbtn" type="submit" id="kBtn">Wyślij zapytanie</button>
            <p class="kstat" id="kStat" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <footer class="foot">
        <div class="wrap foot__in">
          <a class="brand" href="#gora"><svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Vervo <em>Studio</em></span></a>
          <p class="foot__tx">Strony internetowe dla lokalnych firm. Projekt, kod, wdrożenie i opieka w jednym miejscu.</p>
          <p class="foot__legal">© {new Date().getFullYear()} Vervo Studio · <a href={`mailto:${email}`}>{email}</a></p>
        </div>
      </footer>
    </main>

    <script define:vars={{ email }}>
      // wejście (pewny setTimeout, nie zależy od rAF)
      setTimeout(() => document.body.classList.add('mounted'), 90);
      addEventListener('load', () => document.body.classList.add('mounted'));
      // navbar tło po scrollu
      const nav = document.getElementById('nav');
      const onScroll = () => nav?.classList.toggle('solid', scrollY > 40);
      onScroll(); addEventListener('scroll', onScroll, { passive: true });
      // overlay menu
      const setMenu = (open) => {
        const v = open ?? !document.body.classList.contains('menu-open');
        document.body.classList.toggle('menu-open', v);
        document.getElementById('menuBtn')?.setAttribute('aria-expanded', String(v));
        const pl = document.getElementById('pillLabel'); if (pl) pl.textContent = v ? 'Zamknij' : 'Menu';
        document.body.style.overflow = v ? 'hidden' : '';
      };
      document.getElementById('menuBtn')?.addEventListener('click', () => setMenu());
      document.getElementById('burger')?.addEventListener('click', () => setMenu());
      document.querySelectorAll('.overlay a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      // reveal
      const obs = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      document.querySelectorAll('.reveal').forEach((el, i) => { el.style.transitionDelay = (Math.min(i % 3, 2) * 80) + 'ms'; obs.observe(el); });
      // formularz -> FormSubmit -> e-mail
      const form = document.getElementById('kForm'), stat = document.getElementById('kStat'), btn = document.getElementById('kBtn');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault(); stat.textContent = ''; stat.className = 'kstat';
        let ok = true;
        form.querySelectorAll('[required]').forEach((p) => {
          if (p.type === 'checkbox') { if (!p.checked) ok = false; return; }
          if (!p.value.trim()) { p.closest('.fld')?.classList.add('bad'); ok = false; } else { p.closest('.fld')?.classList.remove('bad'); }
        });
        if (!ok) { stat.textContent = 'Uzupełnij wymagane pola i zgodę.'; stat.classList.add('err'); return; }
        const d = Object.fromEntries(new FormData(form).entries());
        if (d._honey) return;
        try {
          btn.disabled = true; btn.textContent = 'Wysyłanie…';
          const res = await fetch('https://formsubmit.co/ajax/' + email, {
            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ _subject: 'Nowe zapytanie ze strony Vervo Studio', _template: 'table', _captcha: 'false',
              'Imię': d.imie, 'E-mail': d.email, 'Branża': d.branza || '(nie podano)', 'Budżet': d.budzet, 'Wiadomość': d.wiadomosc }),
          });
          const r = await res.json();
          if (r.success === true || r.success === 'true') { stat.textContent = 'Dziękuję! Zapytanie wysłane, odezwę się zwykle tego samego dnia.'; stat.classList.add('ok'); form.reset(); }
          else throw 0;
        } catch { stat.textContent = 'Nie udało się wysłać. Napisz bezpośrednio na ' + email; stat.classList.add('err'); }
        finally { btn.disabled = false; btn.textContent = 'Wyślij zapytanie'; }
      });
    </script>

    <style is:global>
      :root {
        --ink: #eef0f6; --ink-2: #b9bece; --muted: #7f8496; --line: rgba(255,255,255,0.1); --line-2: rgba(255,255,255,0.18);
        --panel: rgba(7, 8, 14, 0.66); --panel-2: rgba(16, 18, 28, 0.6);
        --serif: 'Instrument Serif', Georgia, serif; --sans: 'Public Sans', system-ui, -apple-system, sans-serif;
        --e-in: cubic-bezier(0.16, 1, 0.3, 1); --e-menu: cubic-bezier(0.76, 0, 0.24, 1); --maxw: 1180px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; background: #05060b; color: var(--ink); font-family: var(--sans); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; cursor: pointer; background: none; border: 0; color: inherit; }
      :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      h1, h2, h3 { margin: 0; }
      p { margin: 0; }
      main { position: relative; z-index: 1; }
      .wrap { width: min(100% - 2.5rem, var(--maxw)); margin-inline: auto; }
      .font-serif { font-family: var(--serif); }

      /* entrance */
      .ent, .ent2 { opacity: 0; transform: translateY(-16px); transition: opacity 0.7s var(--e-in), transform 0.7s var(--e-in); }
      .ent2 { transform: translateY(28px); transition-duration: 0.9s; }
      body.mounted .ent, body.mounted .ent2 { opacity: 1; transform: none; }
      .ent[data-d="200"], .ent2[data-d="200"] { transition-delay: .2s; }
      .ent[data-d="300"] { transition-delay: .3s; } .ent2[data-d="300"] { transition-delay: .3s; }
      .ent[data-d="400"], .ent2[data-d="450"] { transition-delay: .45s; }
      .ent2[data-d="650"] { transition-delay: .65s; } .ent2[data-d="800"] { transition-delay: .8s; }
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s var(--e-in), transform 0.8s var(--e-in); }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .ent, .ent2, .reveal { opacity: 1 !important; transform: none !important; } }

      /* buttons */
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.95rem 1.9rem; font-weight: 600; font-size: 0.92rem; border-radius: 999px; border: 1px solid transparent; transition: all 0.25s var(--e-in); }
      .btn--light { background: #fff; color: #0a0b10; border-color: #fff; }
      .btn--light:hover { background: rgba(255,255,255,0.85); }
      .btn--ghost { border-color: var(--line-2); color: var(--ink); }
      .btn--ghost:hover { border-color: #fff; background: rgba(255,255,255,0.06); }

      /* NAVBAR */
      .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background 0.5s ease, backdrop-filter 0.5s ease, border-color 0.5s ease; border-bottom: 1px solid transparent; }
      .nav.solid { background: rgba(5,6,11,0.7); backdrop-filter: blur(12px); border-bottom-color: var(--line); }
      .nav__in { max-width: 1440px; margin-inline: auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); height: clamp(64px, 8vw, 80px); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em; z-index: 51; }
      .brand__mk { width: 26px; height: 23px; color: #fff; flex: none; }
      .brand em { font-style: normal; color: var(--muted); }
      .pill { display: none; align-items: center; gap: 0.5rem; padding: 0.5rem 1.15rem; border-radius: 999px; border: 1px solid var(--line-2); color: var(--ink-2); font-size: 0.85rem; transition: background 0.25s; }
      .pill:hover { background: rgba(255,255,255,0.08); color: #fff; }
      .nav__cta { display: none; padding: 0.55rem 1.2rem; border-radius: 999px; background: #fff; color: #0a0b10; font-weight: 600; font-size: 0.85rem; }
      @media (min-width: 860px) { .pill { display: inline-flex; } .nav__cta { display: inline-flex; } .burger { display: none; } }
      .burger { width: 2.5rem; height: 2.5rem; display: grid; place-items: center; z-index: 51; }
      .burger span, .burger span::before, .burger span::after { content: ''; display: block; width: 22px; height: 2px; background: #fff; position: relative; transition: transform 0.5s var(--e-menu), opacity 0.3s; }
      .burger span::before { position: absolute; top: -6px; } .burger span::after { position: absolute; top: 6px; }
      body.menu-open .burger span { background: transparent; }
      body.menu-open .burger span::before { transform: translateY(6px) rotate(45deg); }
      body.menu-open .burger span::after { transform: translateY(-6px) rotate(-45deg); }

      /* OVERLAY */
      .overlay { position: fixed; inset: 0; z-index: 40; background: rgba(5,6,11,0.96); backdrop-filter: blur(8px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2.5rem; opacity: 0; visibility: hidden; transition: opacity 0.7s var(--e-menu), visibility 0.7s; }
      body.menu-open .overlay { opacity: 1; visibility: visible; }
      .overlay__nav { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
      .ol { font-family: var(--serif); font-size: clamp(2.4rem, 8vw, 4.5rem); line-height: 1; color: #fff; opacity: 0; transform: translateY(24px); transition: opacity 0.6s var(--e-menu), transform 0.6s var(--e-menu); }
      .ol:hover { opacity: 0.6; }
      body.menu-open .ol { opacity: 1; transform: none; transition-delay: calc(0.15s + var(--i) * 0.08s); }
      .overlay__mail { color: var(--muted); font-size: 0.95rem; opacity: 0; transition: opacity 0.5s ease 0.5s; }
      body.menu-open .overlay__mail { opacity: 1; }

      /* HERO */
      .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; justify-content: center; text-align: center; padding: 8rem 1.25rem clamp(4rem, 10vh, 7rem); }
      .hero__in { position: relative; z-index: 2; max-width: 60rem; }
      .hero__kicker { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 1.4rem; }
      .hero__h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.9rem, 8vw, 6.4rem); line-height: 1.0; letter-spacing: 0.005em; color: #fff; text-shadow: 0 2px 40px rgba(0,0,0,0.5); }
      .hero__sub { margin: 1.5rem auto 0; max-width: 40ch; color: var(--ink-2); font-size: clamp(1.02rem, 1.7vw, 1.25rem); }
      .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2.2rem; }
      .scrollhint { position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%); z-index: 2; font-size: 0.6rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
      .scrollhint::after { content: ''; width: 1px; height: 2.2rem; background: linear-gradient(rgba(255,255,255,0.5), transparent); }

      /* SECTIONS (translucent -> asteroida widoczna w tle) */
      .sec { position: relative; padding-block: clamp(3.5rem, 8vw, 6.5rem); background: var(--panel); backdrop-filter: blur(14px); border-top: 1px solid var(--line); }
      .sec:first-of-type { border-top: 0; }
      .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 1rem; }
      .h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.02; letter-spacing: 0.005em; color: #fff; }
      .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2.5rem; }
      .head__note { color: var(--muted); font-size: 0.9rem; max-width: 42ch; }
      .fine { font-size: 0.82rem; color: var(--muted); margin-top: 1.75rem; max-width: 64ch; }

      /* realizacje */
      .works { display: grid; gap: 1.1rem; }
      @media (min-width: 720px) { .works { grid-template-columns: repeat(2, 1fr); } }
      .work { background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.7rem; display: flex; flex-direction: column; gap: 0.7rem; transition: transform 0.35s var(--e-in), border-color 0.35s, background 0.35s; }
      .work:hover { transform: translateY(-4px); border-color: var(--line-2); background: rgba(22,25,38,0.7); }
      .work__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .work__bran { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
      .work__go { font-size: 0.8rem; color: var(--muted); transition: color 0.2s; }
      .work:hover .work__go { color: #fff; }
      .work h3 { font-family: var(--serif); font-weight: 400; font-size: 1.8rem; color: #fff; }
      .work p { color: var(--ink-2); font-size: 0.92rem; flex: 1; }
      .tags { list-style: none; margin: 0.3rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .tags li { font-size: 0.72rem; color: var(--ink-2); background: rgba(255,255,255,0.05); border: 1px solid var(--line); border-radius: 999px; padding: 0.25rem 0.7rem; }
      .work--fi { background: linear-gradient(150deg, rgba(40,46,74,0.6), rgba(10,12,20,0.7)); }

      /* oferta */
      .offer { display: grid; gap: 1.5rem 2.5rem; }
      @media (min-width: 620px) { .offer { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 980px) { .offer { grid-template-columns: repeat(3, 1fr); } }
      .offer__i { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; }
      .offer__ic { width: 2.1rem; height: 2.1rem; border-radius: 50%; background: rgba(255,255,255,0.08); border: 1px solid var(--line-2); color: #fff; display: grid; place-items: center; flex: none; }
      .offer__ic svg { width: 1.05rem; height: 1.05rem; }
      .offer__i h3 { font-size: 1.15rem; margin-bottom: 0.3rem; color: #fff; }
      .offer__i p { color: var(--ink-2); font-size: 0.92rem; }

      /* cennik */
      .plans { display: grid; gap: 1.1rem; }
      @media (min-width: 860px) { .plans { grid-template-columns: repeat(3, 1fr); align-items: start; } }
      .plan { background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 2rem 1.8rem; position: relative; display: flex; flex-direction: column; }
      .plan--hot { border-color: rgba(255,255,255,0.5); }
      .plan__badge { position: absolute; top: -0.7rem; left: 1.8rem; background: #fff; color: #0a0b10; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.3rem 0.7rem; border-radius: 999px; }
      .plan h3 { font-family: var(--serif); font-weight: 400; font-size: 1.7rem; color: #fff; }
      .plan__desc { color: var(--muted); font-size: 0.9rem; margin: 0.3rem 0 1.1rem; }
      .plan__price { font-family: var(--serif); font-size: 2.6rem; color: #fff; margin-bottom: 1.2rem; line-height: 1; }
      .plan__price span { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); }
      .plan__price small { font-size: 1.1rem; color: var(--muted); }
      .plan__co { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 0.6rem; flex: 1; }
      .plan__co li { position: relative; padding-left: 1.4rem; font-size: 0.9rem; color: var(--ink-2); }
      .plan__co li::before { content: '✓'; position: absolute; left: 0; color: #fff; }
      .plan__btn { width: 100%; }

      /* proces + o mnie */
      .steps { display: grid; gap: 1.1rem; }
      @media (min-width: 720px) { .steps { grid-template-columns: repeat(4, 1fr); } }
      .step { background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.7rem 1.5rem; }
      .step__n { font-family: var(--serif); font-size: 1.6rem; color: var(--ink-2); }
      .step h3 { font-size: 1.2rem; margin: 0.4rem 0 0.4rem; color: #fff; }
      .step p { color: var(--ink-2); font-size: 0.9rem; }
      .about { display: grid; gap: 2.5rem; margin-top: 3rem; padding-top: 3rem; border-top: 1px solid var(--line); }
      @media (min-width: 900px) { .about { grid-template-columns: 1.25fr 0.75fr; gap: 4rem; align-items: start; } }
      .about__p { color: var(--ink-2); margin-top: 1.1rem; max-width: 60ch; }
      .why { display: grid; }
      .why__i { padding: 1.05rem 0; border-top: 1px solid var(--line); }
      .why__i:last-child { border-bottom: 1px solid var(--line); }
      .why__i b { font-size: 1.05rem; display: block; color: #fff; }
      .why__i span { color: var(--muted); font-size: 0.9rem; }

      /* opinie */
      .quotes { display: grid; gap: 1.1rem; }
      @media (min-width: 820px) { .quotes { grid-template-columns: repeat(3, 1fr); } }
      .quote { margin: 0; background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 1.7rem; }
      .quote blockquote { margin: 0; font-family: var(--serif); font-size: 1.2rem; line-height: 1.4; color: #fff; }
      .quote figcaption { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); }

      /* kontakt */
      .contact { display: grid; gap: 2.5rem; }
      @media (min-width: 900px) { .contact { grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: start; } }
      .contact__links { margin-top: 1.5rem; }
      .contact__links a { font-family: var(--serif); font-size: 1.4rem; color: #fff; }
      .contact__links a:hover { color: var(--ink-2); }
      #kForm { background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px; padding: clamp(1.5rem, 3vw, 2.25rem); }
      .frow { display: grid; gap: 1rem; margin-bottom: 1rem; }
      @media (min-width: 560px) { .frow { grid-template-columns: 1fr 1fr; } }
      .fld { display: block; margin-bottom: 1rem; }
      .fld > span { display: block; font-size: 0.78rem; font-weight: 600; color: var(--ink-2); margin-bottom: 0.4rem; }
      .fld em { font-style: normal; font-weight: 400; color: var(--muted); }
      .fld input, .fld select, .fld textarea { width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--line-2); border-radius: 6px; padding: 0.75rem 0.85rem; font: inherit; color: var(--ink); }
      .fld select option { background: #12141c; }
      .fld textarea { resize: vertical; }
      .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: #fff; }
      .fld.bad input, .fld.bad select, .fld.bad textarea { border-color: #ff6b6b; }
      .consent { display: flex; gap: 0.6rem; font-size: 0.85rem; color: var(--ink-2); margin: 0.5rem 0 1.2rem; cursor: pointer; }
      .consent input { margin-top: 0.2rem; width: 1rem; height: 1rem; accent-color: #fff; flex: none; }
      .kbtn { width: 100%; }
      .kstat { margin-top: 0.9rem; font-size: 0.88rem; min-height: 1.2em; }
      .kstat.ok { color: #7ee0a0; } .kstat.err { color: #ff8a8a; }

      /* stopka */
      .foot { position: relative; z-index: 1; border-top: 1px solid var(--line); padding-block: 3rem; background: rgba(5,6,11,0.7); backdrop-filter: blur(14px); }
      .foot__in { display: grid; gap: 1rem; }
      .foot__tx { color: var(--muted); max-width: 44ch; }
      .foot__legal { font-size: 0.82rem; color: var(--muted); }
      .foot__legal a { color: var(--ink-2); }
    </style>
  </body>
