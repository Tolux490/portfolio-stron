---
import Site from '../../../layouts/Site.astro';
import Polityka from '../../../components/Polityka.astro';
import { mechanik as biz } from '../../../data/firmy.js';
const fonts = 'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap';
---
<Site title={`Polityka prywatności — ${biz.name}`} description="Zasady przetwarzania danych osobowych." fonts={fonts} biz={biz}>
  <Polityka biz={biz} />
</Site>
<style is:global>
  :root {
    --bg:#e9eae7; --bg-alt:#dedfdb; --ink:#16181a; --muted:#5a6064; --line:#c3c5c0;
    --accent:#ffb400; --accent-dark:#e6a200; --on-accent:#16181a; --radius:2px; --maxw:1140px;
    --font-display:'Barlow Condensed',system-ui,sans-serif;
    --font-body:'IBM Plex Sans',system-ui,sans-serif;
    --font-mono:'IBM Plex Mono',ui-monospace,monospace;
  }
</style>
