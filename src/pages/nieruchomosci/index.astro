---
import { nieruchomosci as biz } from '../../data/firmy.js';
import Foto from '../../components/Foto.astro';

const tel = biz.phone.replace(/[^+\d]/g, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mapEmbed = 'https://maps.google.com/maps?q=Wo%C5%82omin%20Legion%C3%B3w%208&z=16&output=embed';

const nawigacja = [
  { href: '#oferty', label: 'Oferty' },
  { href: '#zasady', label: 'Zasady' },
  { href: '#zespol', label: 'Zespół' },
  { href: '#oglad', label: 'Umów oglądanie' },
];

const oferty = [
  {
    id: 'kob-48', typ: 'Mieszkanie', gdzie: 'Wołomin, ul. Kobyłkowska', cena: 465000,
    m: 48, pok: 2, pietro: '3/4', rok: '2018', foto: '', zdjec: 6, rynek: 'wtórny',
    stan: 'do wprowadzenia', ogrzewanie: 'miejskie', dostepne: 'od zaraz',
    opis: 'Dwa pokoje w czteropiętrowym budynku z 2018 roku, na trzecim piętrze z windą. Rozkład bez przechodnich pomieszczeń, kuchnia otwarta na salon, sypialnia od strony podwórza. Mieszkanie po jednym właścicielu, bez konieczności remontu.',
    atuty: ['Balkon 6 m²', 'Miejsce postojowe w hali', 'Winda', 'Komórka lokatorska'],
    okolica: [['Szkoła podstawowa', '400 m'], ['PKP Wołomin', '1,2 km'], ['Sklep spożywczy', '150 m'], ['Park', '600 m']],
    agent: 'Marta Sienkiewicz', agentTel: '+48 123 456 789',
  },
  {
    id: 'duc-142', typ: 'Dom', gdzie: 'Duczki', cena: 1190000,
    m: 142, pok: 5, pietro: '—', rok: '2009', foto: '', zdjec: 8, rynek: 'wtórny',
    stan: 'dobry', ogrzewanie: 'gazowe', dostepne: 'od stycznia',
    opis: 'Dom wolnostojący na działce 780 m², parter z salonem i kuchnią, na piętrze cztery sypialnie. Garaż w bryle budynku, taras od południa. Dach kryty blachodachówką, wymieniony w 2019 roku.',
    atuty: ['Działka 780 m²', 'Garaż dwustanowiskowy', 'Taras 24 m²', 'Kominek', 'Ogród urządzony'],
    okolica: [['Przedszkole', '900 m'], ['Trasa S8', '3 km'], ['Las', '350 m'], ['Przystanek autobusowy', '250 m']],
    agent: 'Tomasz Rybak', agentTel: '+48 123 456 788',
  },
  {
    id: 'cen-62', typ: 'Mieszkanie', gdzie: 'Wołomin, centrum', cena: 549000,
    m: 62, pok: 3, pietro: '1/3', rok: '1998', foto: '', zdjec: 5, rynek: 'wtórny',
    stan: 'do odświeżenia', ogrzewanie: 'miejskie', dostepne: 'od zaraz',
    opis: 'Trzy pokoje w kamienicy z 1998 roku, pierwsze piętro. Wysokie sufity, duże okna od strony ulicy. Mieszkanie wymaga odświeżenia — instalacje sprawne, do wymiany podłogi i kuchnia.',
    atuty: ['Wysokość 2,9 m', 'Piwnica 8 m²', 'Balkon', 'Niski czynsz'],
    okolica: [['Rynek', '200 m'], ['PKP Wołomin', '700 m'], ['Przychodnia', '450 m'], ['Liceum', '800 m']],
    agent: 'Marta Sienkiewicz', agentTel: '+48 123 456 789',
  },
  {
    id: 'zag-1100', typ: 'Działka', gdzie: 'Zagościniec', cena: 289000,
    m: 1100, pok: 0, pietro: '—', rok: 'MPZP', foto: '', zdjec: 4, rynek: 'wtórny',
    stan: 'niezabudowana', ogrzewanie: '—', dostepne: 'od zaraz',
    opis: 'Działka budowlana 1100 m² objęta miejscowym planem zagospodarowania: zabudowa mieszkaniowa jednorodzinna. Kształt prostokątny, wymiary 22 × 50 m, dostęp z drogi asfaltowej.',
    atuty: ['MPZP: zabudowa jednorodzinna', 'Prąd i woda w drodze', 'Gaz w drodze', 'Wymiary 22 × 50 m'],
    okolica: [['Trasa S8', '4 km'], ['Szkoła', '1,8 km'], ['Sklep', '600 m'], ['Las', '200 m']],
    agent: 'Tomasz Rybak', agentTel: '+48 123 456 788',
  },
  {
    id: 'kob-31', typ: 'Mieszkanie', gdzie: 'Kobyłka', cena: 339000,
    m: 31, pok: 1, pietro: '2/5', rok: '2021', foto: '', zdjec: 5, rynek: 'wtórny',
    stan: 'do wprowadzenia', ogrzewanie: 'miejskie', dostepne: 'od zaraz',
    opis: 'Kawalerka 31 m² w budynku z 2021 roku, drugie piętro z windą. Aneks kuchenny, duży balkon, okna na wschód. Idealna pod wynajem — czynsz najmu w okolicy to 1900–2200 zł.',
    atuty: ['Balkon 5 m²', 'Winda', 'Rowerownia w budynku', 'Pod wynajem'],
    okolica: [['PKP Kobyłka', '800 m'], ['Sklep', '100 m'], ['Park', '450 m'], ['Szkoła', '700 m']],
    agent: 'Marta Sienkiewicz', agentTel: '+48 123 456 789',
  },
  {
    id: 'mar-118', typ: 'Dom', gdzie: 'Marki', cena: 985000,
    m: 118, pok: 4, pietro: '—', rok: '2016', foto: '', zdjec: 7, rynek: 'wtórny',
    stan: 'bardzo dobry', ogrzewanie: 'pompa ciepła', dostepne: 'od marca',
    opis: 'Dom w zabudowie bliźniaczej z 2016 roku, działka 320 m². Pompa ciepła i fotowoltaika 6 kWp — rachunki za ogrzewanie poniżej 200 zł miesięcznie. Salon z wyjściem na taras, cztery sypialnie na piętrze.',
    atuty: ['Fotowoltaika 6 kWp', 'Pompa ciepła', 'Działka 320 m²', 'Dwa miejsca postojowe', 'Rekuperacja'],
    okolica: [['Trasa S8', '1,5 km'], ['Szkoła', '600 m'], ['Galeria handlowa', '2 km'], ['Przystanek', '300 m']],
    agent: 'Tomasz Rybak', agentTel: '+48 123 456 788',
  },
];

const zasady = [
  { t: '2% + VAT', d: 'Jedna stawka od ceny transakcyjnej, płatna po akcie notarialnym. Bez opłat wstępnych i bez opłat za odstąpienie.' },
  { t: '3 miesiące', d: 'Umowa na czas określony, bez klauzuli automatycznego przedłużenia. Po tym terminie decydujesz od nowa.' },
  { t: '7 dni', d: 'Tyle zajmuje przygotowanie oferty: sprawdzenie księgi wieczystej, zdjęcia, opis, publikacja na portalach.' },
  { t: '41 dni', d: 'Mediana czasu od podpisania umowy pośrednictwa do aktu notarialnego w 2025 roku.' },
];

const zespol = [
  { imie: 'Marta Sienkiewicz', rola: 'Mieszkania — Wołomin, Kobyłka', tel: '+48 123 456 789' },
  { imie: 'Tomasz Rybak', rola: 'Domy i działki — powiat wołomiński', tel: '+48 123 456 788' },
];

const godziny = ['9:00', '10:00', '11:00', '12:00', '15:00', '16:00', '17:00'];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kontur — nieruchomości w powiecie wołomińskim</title>
    <meta name="description" content="Biuro nieruchomości w Wołominie. Mieszkania, domy i działki. Prowizja 2% + VAT, umowa na trzy miesiące. Umów oglądanie online." />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content="Kontur — nieruchomości w powiecie wołomińskim" />
    <meta property="og:description" content="Mieszkania, domy i działki. Prowizja 2% + VAT, umowa na trzy miesiące." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={new URL('/og/nieruchomosci.png', Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': biz.schemaType,
      name: biz.name,
      telephone: biz.phone,
      email: biz.email,
      address: { '@type': 'PostalAddress', streetAddress: biz.street, addressLocality: biz.city, postalCode: biz.zip, addressCountry: 'PL' },
      openingHours: biz.openingHours,
      sameAs: [biz.facebook, biz.instagram],
      url: Astro.url.origin,
    })} />
  </head>

  <body>
    <header class="hdr" id="hdr">
      <div class="wrap hdr__in">
        <a class="hdr__mark" href="#gora">Kontur</a>
        <nav class="hdr__nav">
          {nawigacja.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <a class="hdr__tel" href={`tel:${tel}`}>{biz.phone}</a>
      </div>
    </header>

    <!-- ============ HERO — bez zdjęcia, sama typografia i siatka ============ -->
    <section class="hero" id="gora">
      <div class="wrap">
        <p class="hero__kicker">Biuro nieruchomości · Wołomin</p>
        <h1>Sprzedajemy nieruchomości<br />w powiecie wołomińskim.</h1>
        <div class="hero__stopa">
          <p class="hero__lede">
            Jedna stawka, umowa na trzy miesiące, bez automatycznego przedłużania.
            Sześć nieruchomości w aktualnej sprzedaży.
          </p>
          <a class="btn btn--pelny" href="#oferty">Zobacz oferty</a>
        </div>
      </div>
      <div class="hero__pasek">
        <div class="wrap hero__liczby">
          <div><span class="hero__l-wart" id="liczbaOfert">6</span><span class="hero__l-opis">ofert w sprzedaży</span></div>
          <div><span class="hero__l-wart">2%</span><span class="hero__l-opis">prowizji + VAT, płatne po akcie</span></div>
          <div><span class="hero__l-wart">41</span><span class="hero__l-opis">dni — mediana do aktu w 2025</span></div>
          <div><span class="hero__l-wart">5</span><span class="hero__l-opis">gmin, w których pracujemy</span></div>
        </div>
      </div>
    </section>

    <!-- ============ OFERTY z filtrami i sortowaniem ============ -->
    <section id="oferty" class="band">
      <div class="wrap">
        <div class="sekcja__glowa reveal">
          <div>
            <p class="label">Oferty</p>
            <h2 class="h2">W sprzedaży</h2>
          </div>
          <p class="sekcja__licznik" id="licznikOfert"></p>
        </div>

        <div class="narzedzia reveal">
          <div class="filtry" role="group" aria-label="Filtruj oferty">
            <button class="chip is-active" data-typ="wszystko">Wszystkie</button>
            <button class="chip" data-typ="Mieszkanie">Mieszkania</button>
            <button class="chip" data-typ="Dom">Domy</button>
            <button class="chip" data-typ="Działka">Działki</button>
            <button class="chip chip--zapisane" id="chipZapisane" data-typ="zapisane" aria-pressed="false">
              Zapisane <span id="licznikZapisanych">0</span>
            </button>
          </div>

          <div class="narzedzia__prawa">
            <label class="suwak">
              <span>Do <strong id="etykietaCeny">1 200 000 zł</strong></span>
              <input type="range" id="suwakCeny" min="250000" max="1200000" step="10000" value="1200000" aria-label="Maksymalna cena" />
            </label>
            <label class="sortowanie">
              <span>Sortuj</span>
              <select id="sortowanie">
                <option value="cena-asc">Cena rosnąco</option>
                <option value="cena-desc">Cena malejąco</option>
                <option value="m-desc">Powierzchnia malejąco</option>
                <option value="mkw-asc">Cena za m² rosnąco</option>
              </select>
            </label>
            <div class="widok" role="group" aria-label="Widok listy">
              <button class="widok__btn is-active" data-widok="siatka" aria-label="Widok siatki">▦</button>
              <button class="widok__btn" data-widok="lista" aria-label="Widok listy">☰</button>
            </div>
          </div>
        </div>

        <div class="oferty" id="listaOfert">
          {oferty.map((o) => (
            <article class="oferta reveal" data-typ={o.typ} data-cena={o.cena} data-m={o.m} data-id={o.id}>
              <div class="oferta__media">
                <button class="oferta__otworz" type="button" data-otworz={o.id} aria-label={`Zobacz szczegóły: ${o.typ}, ${o.gdzie}`}>
                  <Foto src={o.foto} alt={`${o.typ} — ${o.gdzie}`} ratio="3/2" label={`${o.typ} · ${o.gdzie}`} />
                </button>
                <button class="serce" type="button" data-serce={o.id} aria-label="Zapisz ofertę" aria-pressed="false">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M12 20.3 4.6 13a4.6 4.6 0 1 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 1 1 19.4 13z"/>
                  </svg>
                </button>
                <span class="oferta__zdjec">{o.zdjec} zdjęć</span>
              </div>

              <div class="oferta__ciało">
                <p class="oferta__typ">{o.typ} · {o.stan}</p>
                <h3><button type="button" data-otworz={o.id}>{o.gdzie}</button></h3>
                <dl class="metryka">
                  <div><dt>Powierzchnia</dt><dd>{o.m} m²</dd></div>
                  {o.pok > 0 && <div><dt>Pokoje</dt><dd>{o.pok}</dd></div>}
                  <div><dt>Piętro</dt><dd>{o.pietro}</dd></div>
                  <div><dt>Cena za m²</dt><dd>{Math.round(o.cena / o.m).toLocaleString('pl-PL')} zł</dd></div>
                </dl>
                <div class="oferta__stopa">
                  <p class="oferta__cena">{o.cena.toLocaleString('pl-PL')} zł</p>
                  <button class="oferta__btn" type="button" data-otworz={o.id}>Szczegóły →</button>
                </div>
                <label class="porownaj">
                  <input type="checkbox" data-porownaj={o.id} />
                  <span>Do porównania</span>
                </label>
              </div>
            </article>
          ))}
        </div>
        <p class="pusto" id="pusto" hidden>Żadna oferta nie spełnia tych kryteriów. Zmień filtr albo zadzwoń — mamy też oferty przed publikacją.</p>
        <p class="drobne">Ceny ofertowe. Zdjęcia i opisy publikujemy wyłącznie za pisemną zgodą właściciela.</p>
      </div>
    </section>

    <!-- ============ ZASADY ============ -->
    <section id="zasady" class="band band--kreska">
      <div class="wrap">
        <p class="label reveal">Zasady</p>
        <h2 class="h2 reveal">Cztery liczby zamiast czterech akapitów.</h2>
        <dl class="zasady">
          {zasady.map((z) => (
            <div class="reveal">
              <dt>{z.t}</dt>
              <dd>{z.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ ZESPÓŁ ============ -->
    <section id="zespol" class="band">
      <div class="wrap zespol">
        <div class="reveal">
          <p class="label">Zespół</p>
          <h2 class="h2">Dzwonisz do osoby,<br />która prowadzi daną nieruchomość.</h2>
          <p class="lede">Bez centrali i bez przekierowań. Każda oferta ma jednego opiekuna od pierwszego telefonu do aktu.</p>
        </div>
        <div class="zespol__osoby">
          {zespol.map((o) => (
            <div class="osoba reveal">
              <h3>{o.imie}</h3>
              <p>{o.rola}</p>
              <a href={`tel:${o.tel.replace(/[^+\d]/g, '')}`}>{o.tel}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ UMAWIANIE OGLĄDANIA ============ -->
    <section id="oglad" class="band band--ciemny">
      <div class="wrap oglad">
        <div class="reveal">
          <p class="label">Oglądanie</p>
          <h2 class="h2">Wybierz termin,<br />potwierdzimy telefonicznie.</h2>
          <p class="lede">
            Oglądania prowadzimy od poniedziałku do piątku oraz w soboty po ustaleniu.
            Odpowiadamy tego samego dnia roboczego.
          </p>
          <p class="oglad__alt">
            Wolisz od razu porozmawiać? <a href={`tel:${tel}`}>{biz.phone}</a>
          </p>
        </div>

        <form class="form reveal" id="formOglad" novalidate>
          <div class="form__rzad">
            <label class="pole">
              <span>Nieruchomość</span>
              <select name="nieruchomosc" id="polaNieruchomosc" required>
                <option value="">Wybierz z listy</option>
                {oferty.map((o) => (
                  <option value={o.id}>{o.typ} — {o.gdzie}</option>
                ))}
                <option value="inne">Inna / jeszcze nie wiem</option>
              </select>
            </label>
          </div>

          <div class="form__rzad form__rzad--dwa">
            <label class="pole">
              <span>Preferowany dzień</span>
              <input type="date" name="dzien" id="polaDzien" required />
            </label>
            <label class="pole">
              <span>Godzina</span>
              <select name="godzina" required>
                <option value="">Wybierz</option>
                {godziny.map((g) => <option value={g}>{g}</option>)}
              </select>
            </label>
          </div>

          <div class="form__rzad form__rzad--dwa">
            <label class="pole">
              <span>Imię i nazwisko</span>
              <input type="text" name="imie" autocomplete="name" required />
            </label>
            <label class="pole">
              <span>Telefon</span>
              <input type="tel" name="telefon" autocomplete="tel" inputmode="tel" required />
            </label>
          </div>

          <div class="form__rzad">
            <label class="pole">
              <span>E-mail <em>(opcjonalnie)</em></span>
              <input type="email" name="email" autocomplete="email" />
            </label>
          </div>

          <div class="form__rzad">
            <label class="pole">
              <span>Uwagi <em>(opcjonalnie)</em></span>
              <textarea name="uwagi" rows="3" placeholder="Np. interesuje mnie też garaż, mogę tylko po 16:00"></textarea>
            </label>
          </div>

          <!-- Klauzula informacyjna musi być podana W MOMENCIE zbierania danych (art. 13 RODO) -->
          <div class="klauzula">
            <p>
              Administratorem Twoich danych jest {biz.legalName}, {biz.street}, {biz.zip} {biz.city},
              NIP {biz.nip}. Dane z tego formularza przetwarzamy wyłącznie po to, żeby umówić
              i potwierdzić oglądanie — podstawą są działania podejmowane na Twoje żądanie przed
              zawarciem umowy (art. 6 ust. 1 lit. b RODO) oraz nasz prawnie uzasadniony interes
              w prowadzeniu korespondencji (art. 6 ust. 1 lit. f RODO).
            </p>
            <details>
              <summary>Rozwiń pełną informację</summary>
              <p>
                Podanie danych jest dobrowolne, ale bez imienia i telefonu nie umówimy terminu.
                Dane przechowujemy 12 miesięcy od ostatniego kontaktu, a jeśli dojdzie do transakcji —
                przez okres wymagany przepisami podatkowymi. Odbiorcami mogą być dostawca hostingu
                i dostawca usługi obsługi formularza, działający na podstawie umowy powierzenia.
                Masz prawo dostępu do danych, sprostowania, usunięcia, ograniczenia przetwarzania,
                przenoszenia, sprzeciwu oraz skargi do Prezesa UODO. Nie profilujemy i nie podejmujemy
                decyzji automatycznie. Szczegóły:
                <a href={`${base}/nieruchomosci/polityka-prywatnosci/`}>polityka prywatności</a>.
              </p>
            </details>

            <label class="zgoda">
              <input type="checkbox" name="zgoda_marketing" value="tak" />
              <span>
                Chcę dostawać powiadomienia o nowych ofertach dopasowanych do moich kryteriów.
                Zgoda dobrowolna, możesz ją wycofać w każdej chwili — nie wpływa na umówienie oglądania.
              </span>
            </label>
          </div>

          <button class="btn btn--jasny form__wyslij" type="submit" id="formWyslij">Umów oglądanie</button>
          <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- ============ MIEJSCE ============ -->
    <section class="band">
      <div class="wrap miejsce">
        <div class="reveal">
          <p class="label">Biuro</p>
          <address class="miejsce__adres">{biz.street}<br />{biz.zip} {biz.city}</address>
          <div class="miejsce__godziny">{biz.hours.map((h) => <p>{h}</p>)}</div>
          <div class="miejsce__linki">
            <a href={biz.mapUrl} target="_blank" rel="noopener">Google Maps →</a>
            <a href={biz.instagram} target="_blank" rel="noopener">Instagram →</a>
            <a href={biz.facebook} target="_blank" rel="noopener">Facebook →</a>
            <a href={`mailto:${biz.email}`}>{biz.email} →</a>
          </div>
        </div>
        <div class="mapa reveal" id="mapa" data-src={mapEmbed}>
          <div class="mapa__zaslepka" id="mapaZaslepka">
            <p>Mapa Google ładuje się po kliknięciu —<br />strona nie zapisuje cookies bez Twojej decyzji.</p>
            <button class="btn btn--pelny" id="mapaPokaz" type="button">Pokaż mapę</button>
          </div>
        </div>
      </div>
    </section>

    <footer class="stopka">
      <div class="wrap stopka__dol">
        <span>{biz.legalName} · NIP {biz.nip} · {biz.street}, {biz.zip} {biz.city} · {biz.phone}</span>
