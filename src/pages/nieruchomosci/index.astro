  .pnl__sekcja { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--linia); }
  .pnl__sekcja h4 { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--szary); font-weight: 400; margin: 0 0 0.9rem; }
  .pnl__dane { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; }
  .pnl__dane > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.45rem 0; border-bottom: 1px solid var(--linia); font-family: var(--mono); font-size: 0.74rem; }
  .pnl__dane dt { color: var(--szary); margin: 0; }
  .pnl__dane dd { margin: 0; text-align: right; }
  .pnl__atuty { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pnl__atuty li { border: 1px solid var(--linia); padding: 0.35rem 0.8rem; font-size: 0.78rem; }
  .pnl__okolica > div { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--linia); font-size: 0.82rem; }
  .pnl__okolica span:last-child { font-family: var(--mono); color: var(--szary); }
  .pnl__agent { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
  .pnl__agent strong { font-weight: 500; }
  .pnl__agent a { font-family: var(--mono); font-size: 0.88rem; border-bottom: 1px solid var(--linia); }
  .pnl__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .pnl__cta .btn { flex: 1 1 12rem; }

  /* kalkulator raty */
  .rata { margin-top: 1rem; }
  .rata__pola { display: grid; gap: 1.1rem; }
  .rata__pole span { display: flex; justify-content: space-between; font-size: 0.76rem; color: var(--szary); margin-bottom: 0.4rem; }
  .rata__pole strong { font-family: var(--mono); font-weight: 400; color: var(--atrament); font-variant-numeric: tabular-nums; }
  .rata__pole input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 1px; background: var(--linia); }
  .rata__pole input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; background: var(--atrament); cursor: pointer; }
  .rata__pole input[type="range"]::-moz-range-thumb { width: 12px; height: 12px; border: 0; background: var(--atrament); cursor: pointer; }
  .rata__wynik { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--linia); }
  .rata__kwota { font-size: 1.6rem; font-weight: 500; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .rata__nota { font-size: 0.72rem; color: var(--szary); margin-top: 0.9rem; line-height: 1.55; }

  /* tabela porównania */
  .por__tab { width: 100%; border-collapse: collapse; margin-top: 1.5rem; font-size: 0.82rem; }
  .por__tab th { text-align: left; font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--szary); font-weight: 400; padding: 0 0.75rem 0.7rem 0; vertical-align: bottom; }
  .por__tab td { padding: 0.7rem 0.75rem 0.7rem 0; border-top: 1px solid var(--linia); font-variant-numeric: tabular-nums; }
  .por__tab td:first-child { color: var(--szary); font-family: var(--mono); font-size: 0.72rem; }
  .por__tab .jest-najlepsza { font-weight: 500; }
  .por__tab .jest-najlepsza::after { content: ' ●'; font-size: 0.55em; vertical-align: middle; }

  /* ---------- stopka ---------- */
  .stopka { border-top: 1px solid var(--linia); padding-block: 2rem; }
  .stopka__dol { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; justify-content: space-between; font-family: var(--mono); font-size: 0.7rem; color: var(--szary); }
  .pasek { position: fixed; inset: auto 0 0 0; z-index: 70; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--linia); background: rgba(251,251,250,0.96); backdrop-filter: blur(10px); }
  .pasek a { padding: 1rem 0.5rem; text-align: center; font-size: 0.78rem; }
  .pasek a:first-child { background: var(--atrament); color: var(--papier); }
  body { padding-bottom: 3.4rem; }
  @media (min-width: 980px) { .pasek { display: none; } body { padding-bottom: 0; } }
</style>

<script define:vars={{ formKey: biz.formKey, mailKontakt: biz.email, dane: oferty }}>
  // ---- nagłówek ----
  const hdr = document.getElementById('hdr');
  const przelaczHdr = () => hdr?.classList.toggle('is-stuck', window.scrollY > 60);
  przelaczHdr();
  window.addEventListener('scroll', przelaczHdr, { passive: true });

  // ---- wejścia sekcji ----
  const obs = new IntersectionObserver((wpisy) => {
    wpisy.forEach((w) => { if (w.isIntersecting) { w.target.classList.add('is-in'); obs.unobserve(w.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.reveal').forEach((el, i) => {
    el.style.transitionDelay = `${Math.min(i % 3, 2) * 80}ms`;
    obs.observe(el);
  });

  // ---- filtry, sortowanie, widok, ulubione ----
  const lista = document.getElementById('listaOfert');
  const karty = Array.from(document.querySelectorAll('.oferta'));
  const licznik = document.getElementById('licznikOfert');
  const pusto = document.getElementById('pusto');
  const zl = (n) => n.toLocaleString('pl-PL');

  let aktywnyTyp = 'wszystko';
  let maxCena = 1200000;
  let tylkoZapisane = false;

  const KLUCZ = 'kontur-zapisane';
  const czytajZapisane = () => {
    try { return new Set(JSON.parse(localStorage.getItem(KLUCZ) || '[]')); } catch { return new Set(); }
  };
  const zapiszZapisane = (zbior) => {
    try { localStorage.setItem(KLUCZ, JSON.stringify([...zbior])); } catch {}
  };
  let zapisane = czytajZapisane();

  function odswiez() {
    let widoczne = 0;
    karty.forEach((k) => {
      const id = k.dataset.id;
      const pasujeTyp = aktywnyTyp === 'wszystko' || k.dataset.typ === aktywnyTyp;
      const pasujeCena = +k.dataset.cena <= maxCena;
      const pasujeZapis = !tylkoZapisane || zapisane.has(id);
      const ok = pasujeTyp && pasujeCena && pasujeZapis;
      k.classList.toggle('is-hidden', !ok);
      if (ok) widoczne++;
    });
    if (licznik) licznik.textContent = `${widoczne} ${widoczne === 1 ? 'oferta' : widoczne > 1 && widoczne < 5 ? 'oferty' : 'ofert'}`;
    if (pusto) pusto.hidden = widoczne !== 0;
    const lz = document.getElementById('licznikZapisanych');
    if (lz) lz.textContent = String(zapisane.size);
  }

  document.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => {
    if (c.dataset.typ === 'zapisane') {
      tylkoZapisane = !tylkoZapisane;
      c.classList.toggle('is-active', tylkoZapisane);
      c.setAttribute('aria-pressed', String(tylkoZapisane));
    } else {
      document.querySelectorAll('.chip:not(.chip--zapisane)').forEach((x) => x.classList.remove('is-active'));
      c.classList.add('is-active');
      aktywnyTyp = c.dataset.typ;
    }
    odswiez();
  }));

  const suwakCeny = document.getElementById('suwakCeny');
  suwakCeny?.addEventListener('input', () => {
    maxCena = +suwakCeny.value;
    const et = document.getElementById('etykietaCeny');
    if (et) et.textContent = `${zl(maxCena)} zł`;
    odswiez();
  });

  document.getElementById('sortowanie')?.addEventListener('change', (e) => {
    const tryb = e.target.value;
    [...karty].sort((a, b) => {
      const ca = +a.dataset.cena, cb = +b.dataset.cena, ma = +a.dataset.m, mb = +b.dataset.m;
      if (tryb === 'cena-asc') return ca - cb;
      if (tryb === 'cena-desc') return cb - ca;
      if (tryb === 'm-desc') return mb - ma;
      return ca / ma - cb / mb;
    }).forEach((k) => lista?.appendChild(k));
  });

  document.querySelectorAll('.widok__btn').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.widok__btn').forEach((x) => x.classList.remove('is-active'));
    b.classList.add('is-active');
    lista?.classList.toggle('jest-lista', b.dataset.widok === 'lista');
  }));

  document.querySelectorAll('[data-serce]').forEach((b) => {
    const id = b.dataset.serce;
    b.setAttribute('aria-pressed', String(zapisane.has(id)));
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      zapisane.has(id) ? zapisane.delete(id) : zapisane.add(id);
      zapiszZapisane(zapisane);
      b.setAttribute('aria-pressed', String(zapisane.has(id)));
      odswiez();
    });
  });

  odswiez();

  // ---- panel szczegółów ----
  const panel = document.getElementById('panel');
  const panelTresc = document.getElementById('panelTresc');
  const panelKarta = document.getElementById('panelKarta');
  let wracamDo = null;

  const rata = (kwota, lata, proc) => {
    const r = proc / 100 / 12, n = lata * 12;
    return r === 0 ? kwota / n : (kwota * r) / (1 - Math.pow(1 + r, -n));
  };

  function widokOferty(o) {
    const mkw = Math.round(o.cena / o.m);
    const wklad = Math.round(o.cena * 0.2);
    const kredyt = o.cena - wklad;
    return `
      <p class="pnl__typ">${o.typ} · ${o.gdzie}</p>
      <h2 class="pnl__h">${o.opis.split('.')[0]}.</h2>
      <p class="pnl__cena">${zl(o.cena)} zł</p>
      <p class="pnl__mkw">${zl(mkw)} zł/m² · rynek ${o.rynek} · dostępne ${o.dostepne}</p>

      <div class="pnl__galeria">
        ${Array.from({ length: Math.min(o.zdjec, 4) }, (_, i) =>
          `<div class="ph" style="aspect-ratio:3/2">Zdjęcie ${i + 1} z ${o.zdjec}</div>`).join('')}
      </div>

      <p class="pnl__opis">${o.opis}</p>

      <div class="pnl__sekcja">
        <h4>Dane nieruchomości</h4>
        <dl class="pnl__dane">
          <div><dt>Powierzchnia</dt><dd>${o.m} m²</dd></div>
          ${o.pok > 0 ? `<div><dt>Pokoje</dt><dd>${o.pok}</dd></div>` : ''}
          <div><dt>Piętro</dt><dd>${o.pietro}</dd></div>
          <div><dt>Rok / status</dt><dd>${o.rok}</dd></div>
          <div><dt>Stan</dt><dd>${o.stan}</dd></div>
          <div><dt>Ogrzewanie</dt><dd>${o.ogrzewanie}</dd></div>
        </dl>
      </div>

      <div class="pnl__sekcja">
        <h4>Atuty</h4>
        <ul class="pnl__atuty">${o.atuty.map((a) => `<li>${a}</li>`).join('')}</ul>
      </div>

      <div class="pnl__sekcja pnl__okolica">
        <h4>Okolica</h4>
        ${o.okolica.map(([co, ile]) => `<div><span>${co}</span><span>${ile}</span></div>`).join('')}
      </div>

      <div class="pnl__sekcja rata">
        <h4>Szacunkowa rata kredytu</h4>
        <div class="rata__pola">
          <label class="rata__pole">
            <span>Wkład własny <strong id="rWkladTxt">${zl(wklad)} zł · 20%</strong></span>
            <input type="range" id="rWklad" min="10" max="60" step="1" value="20" />
          </label>
          <label class="rata__pole">
            <span>Okres <strong id="rLataTxt">25 lat</strong></span>
            <input type="range" id="rLata" min="5" max="35" step="1" value="25" />
          </label>
          <label class="rata__pole">
            <span>Oprocentowanie <strong id="rProcTxt">7,0%</strong></span>
            <input type="range" id="rProc" min="3" max="12" step="0.1" value="7" />
          </label>
        </div>
        <div class="rata__wynik">
          <span style="font-size:.78rem;color:var(--szary)">Rata miesięczna</span>
          <span class="rata__kwota" id="rWynik">${zl(Math.round(rata(kredyt, 25, 7)))} zł</span>
        </div>
        <p class="rata__nota">
          Wyliczenie orientacyjne, rata równa, bez ubezpieczeń, prowizji i kosztów okołokredytowych.
          Nie stanowi oferty w rozumieniu Kodeksu cywilnego ani doradztwa finansowego — zdolność
          kredytową ocenia bank.
        </p>
      </div>

      <div class="pnl__sekcja pnl__agent">
        <div><h4 style="margin-bottom:.35rem">Opiekun oferty</h4><strong>${o.agent}</strong></div>
        <a href="tel:${o.agentTel.replace(/[^+\d]/g, '')}">${o.agentTel}</a>
      </div>

      <div class="pnl__cta">
        <button class="btn btn--pelny" type="button" data-umow="${o.id}">Umów oglądanie</button>
        <a class="btn" href="tel:${o.agentTel.replace(/[^+\d]/g, '')}">Zadzwoń</a>
      </div>
    `;
  }

  function otworzPanel(html, hash) {
    if (!panel || !panelTresc) return;
    wracamDo = document.activeElement;
    panelTresc.innerHTML = html;
    panel.hidden = false;
    document.body.style.overflow = 'hidden';
    panelKarta?.focus();
    if (hash) history.replaceState(null, '', '#' + hash);
  }

  function zamknijPanel() {
    if (!panel) return;
    panel.hidden = true;
    document.body.style.overflow = '';
    if (location.hash.startsWith('#oferta-') || location.hash === '#porownanie') {
      history.replaceState(null, '', location.pathname);
    }
    wracamDo?.focus?.();
  }

  function podepnijPanel(o) {
    const kredytBazowy = () => o.cena * (1 - (+document.getElementById('rWklad').value) / 100);
    const przelicz = () => {
      const proc = +document.getElementById('rWklad').value;
      const lata = +document.getElementById('rLata').value;
      const opro = +document.getElementById('rProc').value;
      document.getElementById('rWkladTxt').textContent = `${zl(Math.round(o.cena * proc / 100))} zł · ${proc}%`;
      document.getElementById('rLataTxt').textContent = `${lata} lat`;
      document.getElementById('rProcTxt').textContent = `${opro.toFixed(1).replace('.', ',')}%`;
      document.getElementById('rWynik').textContent = `${zl(Math.round(rata(kredytBazowy(), lata, opro)))} zł`;
    };
    ['rWklad', 'rLata', 'rProc'].forEach((id) => document.getElementById(id)?.addEventListener('input', przelicz));
    panelTresc?.querySelector('[data-umow]')?.addEventListener('click', () => {
      const sel = document.getElementById('polaNieruchomosc');
      if (sel) sel.value = o.id;
      zamknijPanel();
      document.getElementById('oglad')?.scrollIntoView({ behavior: 'smooth' });
      setTimeout(() => document.getElementById('polaDzien')?.focus(), 600);
    });
  }

  function pokazOferte(id) {
    const o = dane.find((x) => x.id === id);
    if (!o) return;
    otworzPanel(widokOferty(o), 'oferta-' + id);
    podepnijPanel(o);
  }

  document.querySelectorAll('[data-otworz]').forEach((b) =>
    b.addEventListener('click', () => pokazOferte(b.dataset.otworz)));

  document.getElementById('panelZamknij')?.addEventListener('click', zamknijPanel);
  document.getElementById('panelTlo')?.addEventListener('click', zamknijPanel);
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel && !panel.hidden) zamknijPanel(); });

  // otwarcie z adresu, np. #oferta-mar-118
  if (location.hash.startsWith('#oferta-')) pokazOferte(location.hash.replace('#oferta-', ''));

  // ---- porównanie ----
  const porBar = document.getElementById('porBar');
  const porTekst = document.getElementById('porBarTekst');
  let doPorownania = [];

  function odswiezPor() {
    if (!porBar || !porTekst) return;
    porBar.hidden = doPorownania.length === 0;
    porTekst.textContent = `Wybrano ${doPorownania.length} ${doPorownania.length === 1 ? 'ofertę' : 'oferty'}`;
  }

  document.querySelectorAll('[data-porownaj]').forEach((c) => c.addEventListener('change', () => {
    const id = c.dataset.porownaj;
    if (c.checked) {
      if (doPorownania.length >= 3) { c.checked = false; return; }
      doPorownania.push(id);
    } else {
      doPorownania = doPorownania.filter((x) => x !== id);
    }
    odswiezPor();
  }));

  document.getElementById('porCzysc')?.addEventListener('click', () => {
    doPorownania = [];
    document.querySelectorAll('[data-porownaj]').forEach((c) => (c.checked = false));
    odswiezPor();
  });

  document.getElementById('porPokaz')?.addEventListener('click', () => {
    const wybrane = doPorownania.map((id) => dane.find((o) => o.id === id)).filter(Boolean);
    if (!wybrane.length) return;
    const mkw = wybrane.map((o) => Math.round(o.cena / o.m));
    const najCena = Math.min(...wybrane.map((o) => o.cena));
    const najMkw = Math.min(...mkw);
    const najM = Math.max(...wybrane.map((o) => o.m));
    const wiersz = (etykieta, wartosci, wyroznij) =>
      `<tr><td>${etykieta}</td>${wartosci.map((w, i) =>
        `<td class="${wyroznij && wyroznij(i) ? 'jest-najlepsza' : ''}">${w}</td>`).join('')}</tr>`;

    otworzPanel(`
      <p class="pnl__typ">Porównanie</p>
      <h2 class="pnl__h">${wybrane.length} ${wybrane.length === 1 ? 'oferta' : 'oferty'} obok siebie</h2>
      <table class="por__tab">
        <thead><tr><th></th>${wybrane.map((o) => `<th>${o.gdzie}</th>`).join('')}</tr></thead>
        <tbody>
          ${wiersz('Cena', wybrane.map((o) => zl(o.cena) + ' zł'), (i) => wybrane[i].cena === najCena)}
          ${wiersz('Powierzchnia', wybrane.map((o) => o.m + ' m²'), (i) => wybrane[i].m === najM)}
          ${wiersz('Cena za m²', mkw.map((v) => zl(v) + ' zł'), (i) => mkw[i] === najMkw)}
          ${wiersz('Pokoje', wybrane.map((o) => o.pok || '—'))}
          ${wiersz('Rok / status', wybrane.map((o) => o.rok))}
          ${wiersz('Stan', wybrane.map((o) => o.stan))}
          ${wiersz('Ogrzewanie', wybrane.map((o) => o.ogrzewanie))}
          ${wiersz('Dostępne', wybrane.map((o) => o.dostepne))}
        </tbody>
      </table>
      <p class="rata__nota">Kropką oznaczyliśmy najkorzystniejszą wartość w wierszu tam, gdzie da się ją policzyć.</p>
    `, 'porownanie');
  });

  // ---- "Umów oglądanie" z karty: wypełnia formularz i przewija ----
  document.querySelectorAll('[data-oglad]').forEach((b) => b.addEventListener('click', () => {
    const sel = document.getElementById('polaNieruchomosc');
    if (sel) sel.value = b.dataset.oglad;
    document.getElementById('oglad')?.scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => document.getElementById('polaDzien')?.focus(), 600);
  }));

  // ---- kalendarz: nie da się wybrać wczoraj ani niedzieli ----
  const dzien = document.getElementById('polaDzien');
  if (dzien) {
    const jutro = new Date(Date.now() + 86400000);
    dzien.min = jutro.toISOString().slice(0, 10);
    const zaMiesiac = new Date(Date.now() + 45 * 86400000);
    dzien.max = zaMiesiac.toISOString().slice(0, 10);
  }

  // ---- walidacja i wysyłka ----
  const form = document.getElementById('formOglad');
  const status = document.getElementById('formStatus');
  const przycisk = document.getElementById('formWyslij');

  const pokazBlad = (pole, tekst) => {
    const wrapper = pole.closest('.pole');
    wrapper?.classList.add('is-blad');
    if (!wrapper?.querySelector('.pole__blad')) {
      const s = document.createElement('span');
      s.className = 'pole__blad';
      s.textContent = tekst;
      wrapper?.appendChild(s);
    }
  };
  const wyczyscBledy = () => document.querySelectorAll('.pole').forEach((p) => {
    p.classList.remove('is-blad');
    p.querySelector('.pole__blad')?.remove();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    wyczyscBledy();
    if (status) { status.textContent = ''; status.className = 'form__status'; }

    const dane = new FormData(form);
    let ok = true;

    const wymagane = [
      ['nieruchomosc', 'Wybierz nieruchomość'],
      ['dzien', 'Podaj dzień'],
      ['godzina', 'Wybierz godzinę'],
      ['imie', 'Podaj imię i nazwisko'],
      ['telefon', 'Podaj numer telefonu'],
    ];
    wymagane.forEach(([nazwa, komunikat]) => {
      const pole = form.elements[nazwa];
      if (!String(dane.get(nazwa) || '').trim()) { pokazBlad(pole, komunikat); ok = false; }
    });

    const telefon = String(dane.get('telefon') || '').replace(/[^\d+]/g, '');
    if (telefon && telefon.replace(/\D/g, '').length < 9) {
      pokazBlad(form.elements['telefon'], 'Numer wygląda na niepełny'); ok = false;
    }
    const mail = String(dane.get('email') || '').trim();
    if (mail && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(mail)) {
      pokazBlad(form.elements['email'], 'Sprawdź adres e-mail'); ok = false;
    }

    if (!ok) {
      if (status) { status.textContent = 'Uzupełnij zaznaczone pola.'; status.className = 'form__status is-blad'; }
      return;
    }

    // Brak klucza = tryb pokazowy. Nic nie wychodzi poza przeglądarkę.
    if (!formKey) {
      if (status) {
        status.textContent = 'Tryb pokazowy — formularz działa poprawnie, ale wiadomość nie została wysłana. Po podaniu klucza usługi trafi na ' + mailKontakt + '.';
        status.className = 'form__status is-ok';
      }
      form.reset();
      return;
    }

    przycisk.disabled = true;
    przycisk.textContent = 'Wysyłam…';
    try {
      const odp = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: formKey,
          subject: 'Nowe zgłoszenie oglądania — strona Kontur',
          from_name: 'Kontur Nieruchomości',
          ...Object.fromEntries(dane),
        }),
      });
      const wynik = await odp.json();
      if (wynik.success) {
        if (status) { status.textContent = 'Dziękujemy. Potwierdzimy termin telefonicznie w ciągu dnia roboczego.'; status.className = 'form__status is-ok'; }
        form.reset();
      } else { throw new Error(wynik.message || 'blad'); }
    } catch {
      if (status) { status.textContent = 'Nie udało się wysłać. Zadzwoń albo napisz na ' + mailKontakt + '.'; status.className = 'form__status is-blad'; }
    } finally {
      przycisk.disabled = false;
      przycisk.textContent = 'Umów oglądanie';
    }
  });

  // ---- mapa po kliknięciu ----
  const mapa = document.getElementById('mapa');
  document.getElementById('mapaPokaz')?.addEventListener('click', () => {
    if (!mapa) return;
    const iframe = document.createElement('iframe');
    iframe.src = mapa.dataset.src || '';
    iframe.loading = 'lazy';
    iframe.title = 'Mapa dojazdu do biura Kontur Nieruchomości';
    mapa.appendChild(iframe);
    document.getElementById('mapaZaslepka')?.remove();
  });
</script>
