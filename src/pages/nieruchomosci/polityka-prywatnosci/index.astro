---
import Site from '../../../layouts/Site.astro';
import Polityka from '../../../components/Polityka.astro';
import { nieruchomosci as biz } from '../../../data/firmy.js';
const fonts = 'https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&family=Roboto+Mono:wght@400;500&family=Syne:wght@600;800&display=swap';
---
<Site title={`Polityka prywatności — ${biz.name}`} description="Zasady przetwarzania danych osobowych." fonts={fonts} biz={biz}>
  <Polityka biz={biz} />
</Site>
<style is:global>
  :root {
    --bg:#f7f7f4; --bg-alt:#ecece7; --ink:#14213a; --muted:#5f6a80; --line:#d5d6ce;
    --accent:#14213a; --accent-dark:#0c1729; --on-accent:#f7f7f4; --radius:3px; --maxw:1180px;
    --font-display:'Syne',system-ui,sans-serif;
    --font-body:'Public Sans',system-ui,sans-serif;
    --font-mono:'Roboto Mono',ui-monospace,monospace;
  }
</style>
