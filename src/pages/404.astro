---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Vervo Studio</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&family=Syne:wght@700;800&display=swap" />
  </head>
  <body>
    <main class="e404">
      <svg class="mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p class="tag">Error 404</p>
      <h1>This page isn’t here.</h1>
      <p class="lede">The link may be out of date or the address was mistyped. Head back to the homepage, you can reach everything from there.</p>
      <p class="lede lede--pl" lang="pl">Tej strony tu nie ma. <a href={`${b}/pl/`}>Wróć na stronę główną</a>.</p>
      <div class="cta">
        <a class="btn btn--dark" href={`${b}/`}>Homepage</a>
        <a class="btn btn--line" href={`${b}/#work`}>See my work</a>
      </div>
    </main>
    <style is:global>
      :root { --paper:#f7f6f2; --ink:#17191d; --ink-2:#3a3d44; --muted:#6c7075; --line-2:#d3d0c7; --font-d:'Syne',system-ui,sans-serif; --font-b:'Public Sans',system-ui,sans-serif; }
      * { box-sizing: border-box; } html,body { margin:0; }
      body { background: var(--paper); color: var(--ink); font-family: var(--font-b); -webkit-font-smoothing: antialiased; min-height: 100svh; display: grid; place-items: center; padding: 2rem; }
      a { color: inherit; text-decoration: none; }
      .e404 { max-width: 34rem; text-align: center; }
      .mk { width: 48px; height: 42px; color: var(--ink); margin-bottom: 1.5rem; }
      .tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin: 0 0 1rem; }
      h1 { font-family: var(--font-d); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(2rem, 6vw, 3rem); margin: 0; }
      .lede { color: var(--ink-2); margin: 1.1rem auto 0; max-width: 40ch; }
      .lede--pl { font-size: 0.9rem; color: var(--muted); } .lede--pl a { text-decoration: underline; }
      .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2rem; }
      .btn { display: inline-flex; align-items: center; padding: 0.9rem 1.6rem; font-weight: 700; font-size: 0.9rem; border-radius: 3px; border: 2px solid transparent; transition: all .25s ease; }
      .btn--dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
      .btn--dark:hover { background: transparent; color: var(--ink); }
      .btn--line { border-color: var(--line-2); }
      .btn--line:hover { border-color: var(--ink); }
    </style>
  </body>
</html>
