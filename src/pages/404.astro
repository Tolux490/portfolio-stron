---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist-mono';
import '../styles/hub.css';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-theme="amber">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Vervo Studio</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0c0d10" />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { var th = localStorage.getItem('vervo-theme'); if (th === 'amber' || th === 'lime' || th === 'paper') document.documentElement.setAttribute('data-theme', th); } catch (e) {}
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <main class="e404 wrap">
      <p class="lab mono">[ Error 404 ] · Vervo Studio</p>
      <h1 class="e404__h"><span>Row</span><span class="o">not</span><span class="a">found.</span></h1>
      <p class="e404__p">The link may be out of date or the address was mistyped. Head back to the homepage, you can reach everything from there.</p>
      <p class="e404__p e404__pl" lang="pl">Tej strony tu nie ma. <a href={`${b}/pl/`}>Wróć na stronę główną</a>.</p>
      <div class="e404__cta">
        <a class="btn btn--acc" href={`${b}/`}><span>Homepage</span><span aria-hidden="true">→</span></a>
        <a class="btn btn--line" href={`${b}/#work`}><span>See my work</span></a>
      </div>
    </main>
    <style>
      .e404 { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 4rem; }
      .e404__h { font-family: var(--font-d); font-stretch: 62%; font-weight: 800; text-transform: uppercase; line-height: 0.86; font-size: clamp(4.5rem, 17vw, 15rem); display: grid; }
      .e404__h .o { color: transparent; -webkit-text-stroke: 2px var(--fg); }
      .e404__h .a { color: var(--acc); }
      .e404__p { color: var(--fg-2); max-width: 46ch; margin-top: 1.6rem; font-size: 1.1rem; }
      .e404__pl { font-size: 0.95rem; color: var(--muted); margin-top: 0.8rem; }
      .e404__pl a { text-decoration: underline; color: var(--fg); }
      .e404__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.2rem; }
    </style>
  </body>
</html>
