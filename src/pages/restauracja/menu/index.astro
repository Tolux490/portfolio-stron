---
import Restauracja from '../../../layouts/Restauracja.astro';
import { restauracja as biz } from '../../../data/firmy.js';
import { menu, degustacja } from '../../../data/restauracja.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/restauracja`;
---
<Restauracja
  title="Karta · Ogrodowa 3, Wołomin"
  description="Karta sezonowa restauracji Ogrodowa 3: przystawki, dania główne, desery i menu degustacyjne z parowaniem win. Zmieniamy ją wraz z sezonem."
  current="menu"
  ogImage="restauracja/danie-sygnatura.webp">

  <section class="pagehead">
    <div class="wrap">
      <p class="eyebrow reveal">Karta</p>
      <h1 class="reveal">Karta sezonu</h1>
      <p class="lede reveal">
        Piszemy ją wraz z sezonem i tym, co przywiozą dostawcy. Poniżej pełna karta à la carte
        oraz menu degustacyjne prowadzone przez kuchnię. Alergeny i wersje wege ustalimy przy stole.
      </p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="wrap">
      <div class="badge reveal" style="display:inline-block;margin-bottom:2.5rem">
        <strong>Nowa karta w każdą środę</strong>, pierwszy wieczór prowadzi szef kuchni
      </div>

      {menu.map((g) => (
        <div class="course reveal">
          <div class="course__top">
            <span class="course__name">{g.grupa}</span>
            <p class="course__desc">{g.opis}</p>
          </div>
          <ul class="dish">
            {g.dania.map((d) => (
              <li>
                <div class="dish__main">
                  <span class="dish__n">
                    {d.n}
                    {d.tag === 'sygnatura' && <span class="tag">Sygnatura</span>}
                    {d.tag === 'wege' && <span class="tag tag--wege">Wege</span>}
                  </span>
                  <span class="dish__o">{d.o}</span>
                </div>
                <span class="dish__leader" aria-hidden="true"></span>
                <span class="dish__c">{d.c}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <p class="mono-note reveal maxw-prose">
        Ceny w złotych. Alergeny omawiamy przy zamówieniu, a kuchnia dobierze zamienniki.
        Wersję wegetariańską większości dań przygotujemy, jeśli wspomnisz o tym przy rezerwacji.
        Do rachunku nie doliczamy opłaty serwisowej.
      </p>
    </div>
  </section>

  <!-- ===================== MENU DEGUSTACYJNE ===================== -->
  <section class="band band--zielen">
    <div class="wrap split split--wide-l">
      <div class="reveal">
        <p class="eyebrow">Menu degustacyjne</p>
        <h2 class="h2">{degustacja.nazwa}</h2>
        <p class="lede">{degustacja.opis}</p>
        <div class="facts" style="margin-top:2.5rem">
          <div><dt>{degustacja.cena}<span style="font-size:.4em"> zł</span></dt><dd>za osobę, siedem serwisów</dd></div>
          <div><dt>{degustacja.paira}<span style="font-size:.4em"> zł</span></dt><dd>parowanie win (opcja)</dd></div>
        </div>
        <a class="btn btn--gold mt-l" href={`${root}/rezerwacja/`}>Zarezerwuj degustację</a>
      </div>
      <div class="reveal">
        <ol class="divlist" style="counter-reset:s;list-style:none;padding:0;margin:0">
          {degustacja.serwisy.map((s, i) => (
            <div style="display:flex;gap:1.25rem;align-items:baseline">
              <span style="font-family:var(--serif);font-size:1.4rem;color:var(--zloto);min-width:2rem">{String(i + 1).padStart(2, '0')}</span>
              <span style="font-family:var(--serif);font-size:1.35rem">{s}</span>
            </div>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="band cta">
    <div class="cta__in wrap--w">
      <p class="eyebrow eyebrow--center reveal">Zapraszamy</p>
      <h2 class="reveal">Kartę najlepiej czytać<br />przy stoliku</h2>
      <p class="lede reveal">Zarezerwuj wieczór, resztą zajmiemy się my.</p>
      <a class="btn btn--gold reveal" href={`${root}/rezerwacja/`}>Rezerwuj stolik</a>
    </div>
  </section>
</Restauracja>
