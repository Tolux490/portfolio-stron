  .teach { display: grid; gap: 1px; margin-top: 2.6rem; background: rgba(248, 244, 238, 0.18); border: 1px solid rgba(248, 244, 238, 0.18); border-radius: 22px; overflow: hidden; }
  @media (min-width: 760px) { .teach { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .teach { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .teach article { background: var(--olive); padding: 1.6rem; display: grid; gap: 0.4rem; align-content: start; }
  .teach__n { font: 400 1.9rem/1 var(--ff-d); }
  .teach__s { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: #e2b89f; font-weight: 700; margin-bottom: 0.4rem; }
  .teach article p:last-child { color: #d9dccf; font-size: 0.94rem; }

  .pics { display: grid; grid-template-columns: 1.3fr 1fr 0.8fr; gap: 0.6rem; padding: 0.6rem; }
  .pics img { width: 100%; height: clamp(12rem, 30vw, 24rem); object-fit: cover; border-radius: 14px; }
  @media (max-width: 640px) { .pics { grid-template-columns: 1fr 1fr; } .pics img:first-child { grid-column: span 2; } }

  .revs { display: grid; gap: 2rem; margin-top: 2.4rem; }
  @media (min-width: 880px) { .revs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .revs blockquote { border-top: 1px solid var(--ink); padding-top: 1.2rem; }
  .revs p { font: 400 1.2rem/1.5 var(--ff-d); }
