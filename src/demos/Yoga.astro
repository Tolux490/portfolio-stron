---
import Curtain from '../components/Curtain.astro';
import DemoLang from '../components/DemoLang.astro';
// Studio Adem (demo): studio jogi w Maastricht. NL + EN + PL.
// Fikcyjne studio: adres, ceny, nauczyciele i opinie są przykładowe. Strony: src/pages/yoga/ (+ en/, pl/).

const { lang = 'nl' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f) => `${base}/img/yoga/${f}`;
const root = (l) => `${base}/yoga/${l === 'nl' ? '' : `${l}/`}`;
const tel = '+31430000001';
const telShow = '043 000 00 01';
// rozkład: [godzina, typ, nauczyciel, minuty, wolne miejsca]; poziom wynika z typu
const LEVEL = { vinyasa: 'all', lunch: 'all', hathaBeg: 'beg', yin: 'all', pilates: 'all', yinAdem: 'all', power: 'adv', rug: 'beg', hatha: 'all', herstel: 'all' };
const WEEK = [
  [['07:00', 'vinyasa', 'Iris', 60, 4], ['12:15', 'lunch', 'Bram', 45, 6], ['19:00', 'hathaBeg', 'Iris', 75, 2]],
  [['09:30', 'yin', 'Noor', 75, 8], ['18:00', 'pilates', 'Sanne', 60, 0], ['20:00', 'yinAdem', 'Noor', 75, 5]],
  [['07:00', 'power', 'Bram', 60, 3], ['12:15', 'lunch', 'Iris', 45, 7], ['19:00', 'rug', 'Sanne', 60, 1]],
  [['09:30', 'hatha', 'Iris', 75, 7], ['18:00', 'vinyasa', 'Bram', 60, 5], ['20:00', 'yin', 'Noor', 75, 0]],
  [['07:00', 'vinyasa', 'Iris', 60, 6], ['17:30', 'pilates', 'Sanne', 60, 4]],
  [['09:00', 'hathaBeg', 'Iris', 75, 3], ['10:45', 'power', 'Bram', 75, 2]],
  [['10:00', 'yin', 'Noor', 90, 6], ['17:00', 'herstel', 'Sanne', 75, 9]],
];

const T = {
  nl: {
    title: 'Studio Adem — yoga en pilates in Maastricht',
    desc: 'Yogastudio aan het Bassin in Maastricht. Kleine groepen, lessen voor beginners en gevorderden, yin, vinyasa en pilates. Proefweek voor €19.',
    nav: ['Rooster', 'Prijzen', 'Eerste les', 'Studio'], cta: 'Proefweek €19',
    h1: 'Yoga voor stijve ruggen en drukke hoofden.',
    lede: 'Kleine groepen van hooguit twaalf mensen in een lichte studio aan het Bassin. Nog nooit yoga gedaan? Dan ben je hier precies goed.',
    seeTable: 'Bekijk het rooster',
    facts: [['12', 'mensen per les, niet meer'], ['22', 'lessen per week'], ['Matten', 'en blokken liggen klaar']],
    sLab: 'Rooster', sH: 'Deze week in de studio',
    sLede: 'Kies een dag en een niveau. Reserveren kan tot een uur van tevoren, afmelden tot twee uur van tevoren.',
    days: ['Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag', 'Zondag'], short: ['Ma', 'Di', 'Wo', 'Do', 'Vr', 'Za', 'Zo'],
    levels: { any: 'Alle lessen', beg: 'Beginners', all: 'Voor iedereen', adv: 'Gevorderd' },
    types: { vinyasa: 'Vinyasa flow', lunch: 'Lunchyoga', hathaBeg: 'Hatha voor beginners', yin: 'Yin yoga', pilates: 'Pilates op de mat', yinAdem: 'Yin en ademwerk', power: 'Power vinyasa', rug: 'Yoga voor je rug', hatha: 'Hatha yoga', herstel: 'Herstel en ontspanning' },
    spots: '{n} plekken vrij', spot1: 'Nog 1 plek', full: 'Vol', reserve: 'Reserveer', wait: 'Wachtlijst', none: 'Geen lessen met dit niveau op deze dag.', today: 'vandaag',
    bH: 'Je reservering', bName: 'Naam', bEmail: 'E-mail', bFirst: 'Dit is mijn eerste les bij Adem', bSend: 'Bevestig', bWait: 'Zet me op de wachtlijst', bClose: 'Sluiten',
    doneH: 'Je plek is gereserveerd.', doneWait: 'Je staat op de wachtlijst. Komt er een plek vrij, dan krijg je meteen een mail.', doneP: 'Demoversie: er is niets verstuurd.',
    pLab: 'Prijzen', pH: 'Kies wat bij je week past',
    prices: [['Proefweek', '€19', 'Zeven dagen onbeperkt meedoen, voor nieuwe leden', true], ['Losse les', '€18', 'Handig als je af en toe komt'], ['10-rittenkaart', '€140', 'Vijf maanden geldig, ook voor een vriend'], ['Onbeperkt', '€89', 'per maand, maandelijks opzegbaar']],
    fLab: 'Eerste les', fH: 'Wat je kunt verwachten',
    first: [['Kom tien minuten eerder', 'Dan laten we je de studio zien en kies je rustig een plek.'], ['Neem niks mee', 'Matten, blokken, bolsters en dekens liggen klaar. Water kun je bij ons tappen.'], ['Vertel het als er iets is', 'Last van je rug, knie of zwanger? Zeg het voor de les, dan geven we je alternatieven.']],
    tLab: 'Docenten', tH: 'Wie je les geeft',
    teachers: [['Iris', 'Hatha en vinyasa', 'Geeft al vijftien jaar les en legt elke houding uit alsof je hem voor het eerst doet.'], ['Noor', 'Yin en ademwerk', 'Was fysiotherapeut. Haar avondlessen zijn de beste manier om je week af te sluiten.'], ['Bram', 'Power vinyasa', 'Voor wie wil zweten. Streng op techniek, nooit op flexibiliteit.'], ['Sanne', 'Pilates en rugyoga', 'Specialist in lessen voor mensen die veel zitten.']],
    rLab: 'Ervaringen', rH: 'Wat leden zeggen',
    reviews: [['Na drie maanden twee keer per week heb ik voor het eerst in jaren geen rugpijn meer na een werkdag.', 'Thomas, Wyck'], ['De groepen zijn echt klein. Iris kent na twee lessen je naam en weet waar je op moet letten.', 'Anna, Céramique'], ['Ik kwam voor de yin op zondagochtend en ben gebleven voor de hele sfeer.', 'Yara, Sint Pieter']],
    vLab: 'De studio', vH: 'Aan het water, vijf minuten van het station',
    addr: 'Bassin 000, 6211 AL Maastricht', bike: 'Fietsenstalling voor de deur, parkeergarage Bassin om de hoek.',
    route: 'Route in Google Maps',
    demo: 'Conceptwebsite voor een fictieve yogastudio, gemaakt door Vervo Studio.', credit: 'Website door Vervo Studio ↗',
  },
  en: {
    title: 'Studio Adem — yoga and pilates in Maastricht',
    desc: 'A yoga studio by the Bassin in Maastricht. Small groups, classes for beginners and experienced yogis, yin, vinyasa and pilates. Trial week for €19.',
    nav: ['Timetable', 'Prices', 'First class', 'Studio'], cta: 'Trial week €19',
    h1: 'Yoga for stiff backs and busy heads.',
    lede: 'Small groups of twelve people at most, in a bright studio by the Bassin. Never done yoga before? Then you’re in exactly the right place.',
    seeTable: 'See the timetable',
    facts: [['12', 'people per class, no more'], ['22', 'classes a week'], ['Mats', 'and blocks ready for you']],
    sLab: 'Timetable', sH: 'This week at the studio',
    sLede: 'Pick a day and a level. You can book up to an hour before class and cancel up to two hours before.',
    days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], short: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    levels: { any: 'All classes', beg: 'Beginners', all: 'Everyone', adv: 'Experienced' },
    types: { vinyasa: 'Vinyasa flow', lunch: 'Lunchtime yoga', hathaBeg: 'Hatha for beginners', yin: 'Yin yoga', pilates: 'Mat pilates', yinAdem: 'Yin and breathwork', power: 'Power vinyasa', rug: 'Yoga for your back', hatha: 'Hatha yoga', herstel: 'Restore and relax' },
    spots: '{n} places left', spot1: '1 place left', full: 'Full', reserve: 'Book', wait: 'Waiting list', none: 'No classes at this level on this day.', today: 'today',
    bH: 'Your booking', bName: 'Name', bEmail: 'Email', bFirst: 'This is my first class at Adem', bSend: 'Confirm', bWait: 'Put me on the waiting list', bClose: 'Close',
    doneH: 'Your place is booked.', doneWait: 'You’re on the waiting list. If a place opens up, you’ll get an email straight away.', doneP: 'Demo version: nothing was sent.',
    pLab: 'Prices', pH: 'Pick what fits your week',
    prices: [['Trial week', '€19', 'Seven days of unlimited classes, for new members', true], ['Single class', '€18', 'Handy if you come now and then'], ['10-class card', '€140', 'Valid for five months, can be shared with a friend'], ['Unlimited', '€89', 'a month, cancel any month']],
    fLab: 'First class', fH: 'What to expect',
    first: [['Come ten minutes early', 'We’ll show you around and you can choose your spot without rushing.'], ['Bring nothing', 'Mats, blocks, bolsters and blankets are ready. You can refill your water here.'], ['Tell us if anything’s up', 'Back or knee trouble, or pregnant? Mention it before class and we’ll give you alternatives.']],
    tLab: 'Teachers', tH: 'Who teaches you',
    teachers: [['Iris', 'Hatha and vinyasa', 'Has taught for fifteen years and explains every pose as if you’re doing it for the first time.'], ['Noor', 'Yin and breathwork', 'A former physiotherapist. Her evening classes are the best way to end your week.'], ['Bram', 'Power vinyasa', 'For those who want to sweat. Strict on technique, never on flexibility.'], ['Sanne', 'Pilates and back yoga', 'Specialises in classes for people who sit a lot.']],
    rLab: 'Reviews', rH: 'What members say',
    reviews: [['After three months of going twice a week, I finish a workday without back pain for the first time in years.', 'Thomas, Wyck'], ['The groups really are small. After two classes Iris knows your name and what to watch out for.', 'Anna, Céramique'], ['I came for the Sunday morning yin and stayed for the whole atmosphere.', 'Yara, Sint Pieter']],
    vLab: 'The studio', vH: 'By the water, five minutes from the station',
    addr: 'Bassin 000, 6211 AL Maastricht', bike: 'Bike racks outside, Bassin car park around the corner.',
    route: 'Directions in Google Maps',
    demo: 'Concept website for a fictional yoga studio, made by Vervo Studio.', credit: 'Website by Vervo Studio ↗',
  },
  pl: {
    title: 'Studio Adem — joga i pilates w Maastricht',
    desc: 'Studio jogi nad Bassin w Maastricht. Małe grupy, zajęcia dla początkujących i zaawansowanych, yin, vinyasa i pilates. Tydzień próbny za 19 €.',
    nav: ['Grafik', 'Cennik', 'Pierwsze zajęcia', 'Studio'], cta: 'Tydzień próbny 19 €',
    h1: 'Joga dla sztywnych pleców i zabieganych głów.',
    lede: 'Małe grupy, najwyżej dwanaście osób, w jasnym studio nad Bassin. Joga to dla Ciebie nowość? Właśnie z myślą o takich osobach prowadzimy zajęcia.',
    seeTable: 'Zobacz grafik',
    facts: [['12', 'osób na zajęciach, nie więcej'], ['22', 'zajęcia w tygodniu'], ['Maty', 'i klocki czekają na miejscu']],
    sLab: 'Grafik', sH: 'W tym tygodniu w studio',
    sLede: 'Wybierz dzień i poziom. Zapisać się można najpóźniej godzinę przed zajęciami, a odwołać rezerwację do dwóch godzin przed.',
    days: ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota', 'Niedziela'], short: ['Pn', 'Wt', 'Śr', 'Cz', 'Pt', 'Sb', 'Nd'],
    levels: { any: 'Wszystkie zajęcia', beg: 'Dla początkujących', all: 'Dla każdego', adv: 'Dla zaawansowanych' },
    types: { vinyasa: 'Vinyasa flow', lunch: 'Joga w przerwie na lunch', hathaBeg: 'Hatha dla początkujących', yin: 'Yin joga', pilates: 'Pilates na macie', yinAdem: 'Yin i praca z oddechem', power: 'Power vinyasa', rug: 'Joga na zdrowy kręgosłup', hatha: 'Hatha joga', herstel: 'Regeneracja i relaks' },
    spots: 'Wolne miejsca: {n}', spot1: 'Zostało 1 miejsce', full: 'Brak miejsc', reserve: 'Zapisz się', wait: 'Lista rezerwowa', none: 'Tego dnia nie ma zajęć na tym poziomie.', today: 'dziś',
    bH: 'Twoja rezerwacja', bName: 'Imię i nazwisko', bEmail: 'E-mail', bFirst: 'To moje pierwsze zajęcia w Adem', bSend: 'Potwierdź', bWait: 'Zapisz mnie na listę rezerwową', bClose: 'Zamknij',
    doneH: 'Miejsce jest zarezerwowane.', doneWait: 'Jesteś na liście rezerwowej. Gdy zwolni się miejsce, od razu dostaniesz maila.', doneP: 'Wersja pokazowa: nic nie zostało wysłane.',
    pLab: 'Cennik', pH: 'Wybierz to, co pasuje do Twojego tygodnia',
    prices: [['Tydzień próbny', '19 €', 'Siedem dni bez limitu zajęć, dla nowych osób', true], ['Pojedyncze zajęcia', '18 €', 'Wygodne, jeśli przychodzisz od czasu do czasu'], ['Karnet na 10 wejść', '140 €', 'Ważny pięć miesięcy, można dzielić z kimś bliskim'], ['Bez limitu', '89 €', 'miesięcznie, z miesięcznym okresem wypowiedzenia']],
    fLab: 'Pierwsze zajęcia', fH: 'Jak to wygląda',
    first: [['Przyjdź dziesięć minut wcześniej', 'Pokażemy Ci studio i spokojnie wybierzesz miejsce.'], ['Nic nie musisz zabierać', 'Maty, klocki, wałki i koce czekają na miejscu. Wodę można nalać u nas.'], ['Powiedz nam, jeśli coś dolega', 'Bolą plecy albo kolano, jesteś w ciąży? Powiedz przed zajęciami, a zaproponujemy inne warianty ćwiczeń.']],
    tLab: 'Nauczyciele', tH: 'Kto prowadzi zajęcia',
    teachers: [['Iris', 'Hatha i vinyasa', 'Uczy od piętnastu lat i tłumaczy każdą pozycję tak, jakby robiło się ją pierwszy raz.'], ['Noor', 'Yin i oddech', 'Wcześniej fizjoterapeutka. Jej wieczorne zajęcia to najlepszy sposób na zakończenie tygodnia.'], ['Bram', 'Power vinyasa', 'Dla tych, którzy chcą się spocić. Wymagający, jeśli chodzi o technikę, nigdy o rozciągnięcie.'], ['Sanne', 'Pilates i joga na kręgosłup', 'Specjalizuje się w zajęciach dla osób, które dużo siedzą.']],
    rLab: 'Opinie', rH: 'Co mówią nasi bywalcy',
    reviews: [['Po trzech miesiącach, dwa razy w tygodniu, pierwszy raz od lat kończę dzień pracy bez bólu pleców.', 'Thomas, Wyck'], ['Grupy są naprawdę małe. Po dwóch zajęciach Iris zna Twoje imię i wie, na co masz uważać.', 'Anna, Céramique'], ['Przyszłam na niedzielną yin, a zostałam dla całej atmosfery.', 'Yara, Sint Pieter']],
    vLab: 'Studio', vH: 'Nad wodą, pięć minut od dworca',
    addr: 'Bassin 000, 6211 AL Maastricht', bike: 'Stojaki na rowery przed wejściem, parking Bassin tuż obok.',
    route: 'Trasa w Google Maps',
    demo: 'Strona koncepcyjna fikcyjnego studia jogi, wykonana przez Vervo Studio.', credit: 'Strona: Vervo Studio ↗',
  },
};
const t = T[lang];
const cfg = {
  lang,
  week: WEEK.map((day) => day.map(([time, type, who, mins, spots]) => ({ time, type, name: t.types[type], who, mins, spots, level: LEVEL[type] }))),
  t: { days: t.days, short: t.short, levels: t.levels, spots: t.spots, spot1: t.spot1, full: t.full, reserve: t.reserve, wait: t.wait, none: t.none, today: t.today, doneH: t.doneH, doneWait: t.doneWait, bSend: t.bSend, bWait: t.bWait },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f1ebe2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Mulish:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <Curtain />
    <header class="hd" id="hd">
      <a class="hd__logo" href="#top">adem<small>yoga · pilates</small></a>
      <nav class="hd__nav">{['#rooster', '#prijzen', '#eerste-les', '#studio'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}</nav>
      <a class="btn btn--clay hd__cta" href="#prijzen">{t.cta}</a>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero__img" src={img('hero.webp')} alt="" fetchpriority="high" />
        <div class="hero__in">
          <h1>{t.h1}</h1>
          <p class="lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--light" href="#rooster">{t.seeTable}</a>
            <a class="btn btn--clay" href="#prijzen">{t.cta}</a>
          </div>
        </div>
      </section>

      <ul class="facts">{t.facts.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}</ul>

      <section class="sec" id="rooster">
        <div class="wrap">
          <div class="sched__head">
            <div>
              <p class="lab">{t.sLab}</p>
              <h2 class="h2">{t.sH}</h2>
              <p class="lede">{t.sLede}</p>
            </div>
            <div class="lvls" role="group" aria-label={t.sLab} data-lvls>
              {Object.entries(t.levels).map(([k, n], i) => <button type="button" data-lvl={k} aria-pressed={i === 0 ? 'true' : 'false'}>{n}</button>)}
            </div>
          </div>
          <div class="days" role="tablist" data-days>
            {t.short.map((d, i) => <button type="button" role="tab" data-day={i} aria-selected="false" aria-label={t.days[i]}><span>{d}</span></button>)}
          </div>
          <ul class="classes" data-classes aria-live="polite"></ul>
          <form class="booking" data-booking hidden novalidate>
            <div class="booking__top">
              <p class="booking__h">{t.bH}</p>
              <button type="button" class="booking__x" data-close aria-label={t.bClose}>✕</button>
            </div>
            <p class="booking__what" data-what></p>
            <div class="f2">
              <label class="f"><span>{t.bName}</span><input name="name" autocomplete="name" required /></label>
              <label class="f"><span>{t.bEmail}</span><input name="email" type="email" autocomplete="email" required /></label>
            </div>
            <label class="chk"><input type="checkbox" name="first" /><span>{t.bFirst}</span></label>
            <button class="btn btn--clay" type="submit" data-submit>{t.bSend}</button>
            <div class="done" data-done hidden><h3 data-done-h>{t.doneH}</h3><p>{t.doneP}</p></div>
          </form>
        </div>
      </section>

      <section class="sec sec--sand" id="prijzen">
        <div class="wrap">
          <p class="lab rv">{t.pLab}</p>
          <h2 class="h2 rv">{t.pH}</h2>
          <div class="prices">
            {t.prices.map(([n, p, d, hi]) => <article class={`rv${hi ? ' is-hi' : ''}`}><h3>{n}</h3><b>{p}</b><p>{d}</p></article>)}
          </div>
        </div>
      </section>

      <section class="sec" id="eerste-les">
        <div class="wrap first">
          <img class="first__img rv" src={img('zit.webp')} alt="" loading="lazy" />
          <div>
            <p class="lab rv">{t.fLab}</p>
            <h2 class="h2 rv">{t.fH}</h2>
            <ol class="first__list">{t.first.map(([h, p]) => <li class="rv"><h3>{h}</h3><p>{p}</p></li>)}</ol>
          </div>
        </div>
      </section>

      <section class="sec sec--dark">
        <div class="wrap">
          <p class="lab">{t.tLab}</p>
          <h2 class="h2">{t.tH}</h2>
          <div class="teach">
            {t.teachers.map(([n, s, d]) => <article><p class="teach__n">{n}</p><p class="teach__s">{s}</p><p>{d}</p></article>)}
          </div>
        </div>
      </section>

      <section class="pics" aria-hidden="true">
        <img src={img('les.webp')} alt="" loading="lazy" />
        <img src={img('hond.webp')} alt="" loading="lazy" />
        <img src={img('staand.webp')} alt="" loading="lazy" />
      </section>

      <section class="sec">
        <div class="wrap">
          <p class="lab rv">{t.rLab}</p>
          <h2 class="h2 rv">{t.rH}</h2>
          <div class="revs">{t.reviews.map(([q, w]) => <blockquote class="rv"><p>{q}</p><cite>{w}</cite></blockquote>)}</div>
        </div>
      </section>

      <section class="sec sec--sand" id="studio">
        <div class="wrap visit">
          <div>
            <p class="lab">{t.vLab}</p>
            <h2 class="h2">{t.vH}</h2>
          </div>
          <div class="visit__info">
            <p class="visit__addr">{t.addr}</p>
            <p>{t.bike}</p>
            <p><a href={`tel:${tel}`}>{telShow}</a> · <a href="https://maps.google.com/?q=Bassin+Maastricht" target="_blank" rel="noopener">{t.route} ↗</a></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap ft__in">
        <p class="ft__logo">adem</p>
        <p>Maastricht · KvK 00000000 · BTW NL000000000B01</p>
        <p>{t.demo} <a href={`${base}/`}>{t.credit}</a></p>
      </div>
    </footer>
    <div class="mbar"><a href="#rooster">{t.nav[0]}</a><a class="mbar__go" href="#prijzen">{t.cta}</a></div>
    <DemoLang lang={lang} links={[['nl', root('nl')], ['en', root('en')], ['pl', root('pl')]]} />
    <script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
  </body>
</html>

<style is:global>
  :root { --bg: #f1ebe2; --paper: #f8f4ee; --sand: #e6dccd; --ink: #2b2925; --mut: #716a60; --clay: #b0603a; --olive: #4d5741; --line: rgba(43, 41, 37, 0.14); --ff-d: 'Tenor Sans', Georgia, sans-serif; --ff: 'Mulish', system-ui, sans-serif; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; scroll-padding-top: 4.5rem; }
  body { background: var(--bg); color: var(--ink); font: 400 16.5px/1.7 var(--ff); overflow-x: hidden; }
  img { display: block; max-width: 100%; }
  a { color: inherit; }
