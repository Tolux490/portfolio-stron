  .mbar { position: fixed; z-index: 70; left: 0.8rem; right: 8.6rem; bottom: calc(0.8rem + env(safe-area-inset-bottom, 0)); display: grid; grid-template-columns: auto 1fr; gap: 0.4rem; }
  .mbar a { display: grid; place-items: center; padding: 0.95rem 1rem; border-radius: 999px; text-decoration: none; font: 600 0.92rem var(--ff); background: var(--paper); color: var(--ink); border: 1px solid var(--line); box-shadow: 0 14px 28px -14px rgba(0, 0, 0, 0.4); white-space: nowrap; }
  .mbar__go { background: var(--clay) !important; color: #fff !important; border-color: var(--clay) !important; }
  @media (min-width: 1000px) { .mbar { display: none; } .ft { padding-bottom: 3rem; } }
  .dlang { bottom: calc(0.9rem + env(safe-area-inset-bottom, 0)) !important; }
  @media (max-width: 999px) { .dlang { right: 0.8rem !important; } }
  @media (max-width: 599px) { .mbar { right: 0.8rem; } .dlang { bottom: calc(4.6rem + env(safe-area-inset-bottom, 0)) !important; } }
  @media (min-width: 1000px) { .dlang { bottom: 1.2rem !important; } }

  .rv { opacity: 0; transform: translateY(16px); transition: opacity 0.9s, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } html { scroll-behavior: auto; } }
</style>

<script>
  import { $, $$, readCfg, reveal, localNow } from '../scripts/demo-kit.js';
  const cfg = readCfg();
  const L = cfg.t;
  reveal();

  const hd = $('#hd');
  const onScroll = () => hd.classList.toggle('is-solid', scrollY > 60);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // grafik zajęć
  const { wd: today } = localNow();
  let day = today, lvl = 'any', picked = null;
  const list = $('[data-classes]'), booking = $('[data-booking]');
  $$('[data-days] button').forEach((b) => {
    if (+b.dataset.day === today) b.insertAdjacentHTML('beforeend', `<small>${L.today}</small>`);
  });
  const spotsTxt = (n) => (n === 0 ? L.full : n === 1 ? L.spot1 : L.spots.replace('{n}', String(n)));
  const render = () => {
    $$('[data-days] button').forEach((b) => b.setAttribute('aria-selected', String(+b.dataset.day === day)));
    $$('[data-lvl]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lvl === lvl)));
    const items = cfg.week[day].filter((c) => lvl === 'any' || c.level === lvl);
    if (!items.length) { list.innerHTML = `<li class="empty">${L.none}</li>`; return; }
    list.replaceChildren(...items.map((c) => {
      const li = document.createElement('li');
      li.className = 'cls';
      li.innerHTML = `<span class="cls__time"></span><div><p class="cls__name"></p><p class="cls__meta"></p></div><div class="cls__right"><span class="cls__spots"></span><button type="button" class="cls__btn"></button></div>`;
      li.querySelector('.cls__time').textContent = c.time;
      const nm = li.querySelector('.cls__name');
      nm.textContent = c.name;
      if (c.level !== 'all') nm.insertAdjacentHTML('beforeend', `<span class="cls__lvl cls__lvl--${c.level}">${L.levels[c.level]}</span>`);
      li.querySelector('.cls__meta').textContent = `${c.who} · ${c.mins} min`;
      const sp = li.querySelector('.cls__spots');
      sp.textContent = spotsTxt(c.spots);
      sp.classList.toggle('is-low', c.spots <= 2);
      const btn = li.querySelector('.cls__btn');
      btn.textContent = c.spots ? L.reserve : L.wait;
      btn.classList.toggle('is-wait', !c.spots);
      btn.addEventListener('click', () => open(c));
      return li;
    }));
  };
  const open = (c) => {
    picked = c;
    $('[data-what]').textContent = `${L.days[day]} ${c.time} · ${c.name} · ${c.who}`;
    $('[data-submit]').textContent = c.spots ? L.bSend : L.bWait;
    $('[data-done]').hidden = true;
    booking.hidden = false;
    booking.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    booking.elements.name.focus({ preventScroll: true });
  };
  $$('[data-days] button').forEach((b) => b.addEventListener('click', () => { day = +b.dataset.day; render(); }));
  $$('[data-lvl]').forEach((b) => b.addEventListener('click', () => { lvl = b.dataset.lvl; render(); }));
  $('[data-close]').addEventListener('click', () => { booking.hidden = true; });
  booking.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    const n = booking.elements.name, m = booking.elements.email;
    const badN = n.value.trim().length < 2, badM = !/^\S+@\S+\.\S+$/.test(m.value);
    n.classList.toggle('is-bad', badN); m.classList.toggle('is-bad', badM);
    if (badN || badM) { ok = false; (badN ? n : m).focus(); }
    if (!ok) return;
    $('[data-done-h]').textContent = picked && picked.spots ? L.doneH : L.doneWait;
    if (picked && picked.spots) { picked.spots -= 1; render(); }
    $('[data-done]').hidden = false;
  });
  render();
</script>
