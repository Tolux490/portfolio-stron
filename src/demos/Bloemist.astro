<script>
  import { $, $$, readCfg, reveal, openStatus, markToday, localNow, euro } from '../scripts/demo-kit.js';
  const cfg = readCfg();
  const L = cfg.t;
  const eur = euro(cfg.lang, 2);
  const eur0 = (n) => (Number.isInteger(n) ? euro(cfg.lang)(n) : eur(n));
  reveal();
  openStatus($('[data-status]'), { hours: cfg.hours, t: L, lang: cfg.lang });
  markToday($('[data-hours]'));

  // odliczanie do 14:00 (dostawa tego samego dnia, pn–sob)
  const cd = $('[data-cd]');
  const form = $('[data-build]');
  const todayOpt = form.querySelector('input[name=when][value=today]');
  const tick = () => {
    const { wd, min } = localNow();
    const can = wd < 6 && min < cfg.cutoff;
    if (can) {
      const left = cfg.cutoff - min, h = Math.floor(left / 60), m = left % 60;
      const s = h ? `${h} ${L.hr} ${m} ${L.mn}` : `${m} ${L.mn}`;
      cd.innerHTML = L.cdBefore.replace('{t}', `<b>${s}</b>`);
    } else {
      cd.textContent = L.cdAfter.replace('{day}', wd === 5 || wd === 6 ? L.monday : L.tomorrow);
    }
    todayOpt.disabled = !can;
    todayOpt.nextElementSibling.textContent = can ? L.when.today : `${L.when.today} · ${L.todayFull}`;
    if (!can && todayOpt.checked) { form.querySelector('input[name=when][value=tomorrow]').checked = true; update(); }
  };

  // boeket: podsumowanie na żywo
  const lines = $('[data-lines]'), total = $('[data-total]'), msg = $('[data-msg]'), chars = $('[data-chars]');
  const ph = form.card.placeholder;
  function update() {
    const size = cfg.sizes[form.size.value], mood = cfg.moods[form.mood.value];
    let sum = size.price;
    const rows = [[`${mood}, ${size.name.toLowerCase()}`, eur0(size.price)]];
    if (form.vase.checked) { sum += cfg.prices.vase; rows.push([L.vase, eur0(cfg.prices.vase)]); }
    const when = form.when.value;
    let del = 0;
    if (when !== 'pickup') {
      const z = (form.zip.value.match(/\d{4}/) || [''])[0];
      const inTown = !z || /^62\d\d$/.test(z);
      del = inTown ? (sum >= cfg.prices.freeFrom ? 0 : cfg.prices.delivery) : cfg.prices.deliveryOut;
    }
    rows.push([L.when[when], when === 'pickup' || del === 0 ? L.free : eur(del)]);
    sum += del;
    lines.replaceChildren(...rows.map(([a, b]) => { const li = document.createElement('li'); li.innerHTML = '<span></span><span></span>'; li.children[0].textContent = a; li.children[1].textContent = b; return li; }));
    total.textContent = eur0(Math.round(sum * 100) / 100);
    const v = form.card.value.trim();
    msg.textContent = v || ph; msg.classList.toggle('is-ph', !v);
    chars.textContent = String(140 - form.card.value.length);
    form.zip.closest('.zip').style.display = when === 'pickup' ? 'none' : '';
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  update(); tick(); setInterval(tick, 30000);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = $('[data-done]');
    d.hidden = false;
    d.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });
</script>
