  @keyframes heroZoom { to { transform: scale(1); } }
  .kicker { font: 600 0.74rem/1 var(--ff-b); letter-spacing: 0.24em; text-transform: uppercase; color: var(--brass2); margin-bottom: 1.2rem; }
