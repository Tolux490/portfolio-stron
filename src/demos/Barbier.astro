    teamLab: 'Team', teamH: 'Kies je barber',
    barbers: { yusuf: ['Yusuf', 'Fades en designs'], mila: ['Mila', 'Schaarwerk en lang haar'], daan: ['Daan', 'Baarden en shaves'] },
    bookWith: 'Boek bij',
    bookLab: 'Online boeken', bookH: 'Je stoel in 30 seconden',
    steps: ['Behandeling', 'Barber', 'Dag', 'Tijd', 'Gegevens'],
    anyBarber: 'Geen voorkeur', anyBarberSub: 'Eerste vrije stoel',
    closed: 'dicht', noSlots: 'Vol, kies een andere dag',
    name: 'Naam', phoneL: 'Telefoon (voor de herinnering)', confirm: 'Bevestig afspraak', back: 'Terug',
    summary: 'Jouw afspraak', total: 'Totaal', pickFirst: 'Kies eerst een behandeling',
    doneH: 'Gelukt, je stoel staat klaar.',
