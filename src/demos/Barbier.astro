  @media (max-width: 979px) { .book__steps { grid-auto-flow: column; overflow-x: auto; } .book__steps li { white-space: nowrap; font-size: 0.8rem; } }
  .book__form fieldset { border: 0; }
  .book__form legend { font: 400 1.6rem/1 var(--ff-d); text-transform: uppercase; margin-bottom: 1.2rem; }
  .chips { display: grid; gap: 0.6rem; }
  .chips--svc, .chips--barber { grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); }
  .chips--days { grid-template-columns: repeat(auto-fill, minmax(5.4rem, 1fr)); }
  .chips--times { grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr)); }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip > span { display: grid; gap: 0.15rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 2px; transition: border-color 0.2s, background 0.2s; height: 100%; }
  .chip b { font-weight: 600; font-size: 0.95rem; }
