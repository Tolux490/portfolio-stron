    teamLab: 'Team', teamH: 'Pick your barber',
    barbers: { yusuf: ['Yusuf', 'Fades and designs'], mila: ['Mila', 'Scissor work and long hair'], daan: ['Daan', 'Beards and shaves'] },
    bookWith: 'Book with',
    bookLab: 'Book online', bookH: 'Your chair in 30 seconds',
    steps: ['Service', 'Barber', 'Day', 'Time', 'Details'],
    anyBarber: 'No preference', anyBarberSub: 'First free chair',
    closed: 'closed', noSlots: 'Fully booked, pick another day',
    name: 'Name', phoneL: 'Phone (for the reminder)', confirm: 'Confirm booking', back: 'Back',
    summary: 'Your booking', total: 'Total', pickFirst: 'Pick a service first',
    doneH: 'Done, your chair is ready.',
    doneP: 'Demo version: nothing was sent. On the real site the shop gets the booking and you get a confirmation and a reminder on WhatsApp.',
    again: 'New booking',
    revLab: 'Reviews', revH: '4.9 from 380+ reviews',
    reviews: [
      ['Finally a barber where you don’t wait an hour. Booked on the train, in the chair at 5:30. The fade is spot on.', 'Thomas, Wyck'],
      ['Yusuf really takes the time to ask what you want. Best fade I’ve had in Maastricht.', 'Rachid'],
      ['Got a hot towel shave as a birthday present. Highly recommended, feels like an hour of holiday.', 'Jeroen M.'],
    ],
    visitLab: 'Visit', visitH: 'In the heart of Wyck, five minutes from the station',
    hoursH: 'Opening hours', days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    hoursNote: 'Late opening on Thursday until 21:00.',
    openNow: 'Open now', closedNow: 'Closed now', until: 'until', opensAt: 'opens',
    mapNote: 'The Google map only loads after you click, so no cookies upfront.', showMap: 'Show map',
    contactH: 'Contact', whatsapp: 'WhatsApp',
    demo: 'Concept website for a fictional barbershop, made by Vervo Studio.', credit: 'Website by Vervo Studio ↗', privacy: 'Privacy',
  },
  pl: {
    title: 'Scheermes — barber w Wyck, Maastricht',
    desc: 'Fade’y, strzyżenie, broda i golenie na gorąco w dzielnicy Wyck w Maastricht. Zarezerwuj fotel online w 30 sekund.',
    nav: ['Cennik', 'Realizacje', 'Barberzy', 'Kontakt'], book: 'Zarezerwuj fotel', call: 'Zadzwoń',
    kicker: 'Barbershop · Wyck, Maastricht',
    h1: ['Równo ostrzyżony.', 'Bez kolejki.'],
    lede: 'Fade’y, klasyczne cięcia i golenie z gorącym ręcznikiem. Rezerwujesz online, przychodzisz, a fotel już na Ciebie czeka.',
    seePrices: 'Zobacz cennik',
    stats: [['4,9', 'średnia ocena w Google'], ['380+', 'opinii'], ['3', 'barberów, 6 dni w tygodniu']],
    ticker: ['Skin fade', 'Klasyczne cięcia', 'Modelowanie brody', 'Golenie na gorąco', 'Strzyżenie dzieci', 'Buzz cut'],
    pricesLab: 'Cennik', pricesH: 'Stałe ceny, bez niespodzianek',
    services: {
      knip: ['Strzyżenie', 'Mycie, strzyżenie i stylizacja'],
      fade: ['Skin fade', 'Cieniowanie do zera, góra nożyczkami'],
      combo: ['Strzyżenie + broda', 'Pełen pakiet, nasz ulubiony'],
      baard: ['Trymowanie brody', 'Modelowanie, kontur brzytwą, olejek'],
      shave: ['Golenie na gorąco', 'Gorące ręczniki, brzytwa, balsam po goleniu'],
      buzz: ['Buzz cut', 'Jedna długość, równo wykończone'],
      kids: ['Strzyżenie dziecka', 'Do 12 lat'],
    },
    minutes: 'min', bookThis: 'Rezerwuj',
    workLab: 'Realizacje', workH: 'Prosto z fotela, z tego tygodnia',
    work: [['fade.webp', 'Mid fade z teksturą'], ['tattoo.webp', 'Skin fade z wygolonym wzorem'], ['knip.webp', 'Klasyczne cięcie nożyczkami'], ['baard.webp', 'Modelowanie brody'], ['scheren.webp', 'Golenie na gorąco']],
    teamLab: 'Barberzy', teamH: 'Wybierz swojego barbera',
    barbers: { yusuf: ['Yusuf', 'Fade’y i wzory'], mila: ['Mila', 'Nożyczki i dłuższe włosy'], daan: ['Daan', 'Brody i golenie'] },
    bookWith: 'Rezerwuj u:',
    bookLab: 'Rezerwacja online', bookH: 'Twój fotel w 30 sekund',
    steps: ['Usługa', 'Barber', 'Dzień', 'Godzina', 'Dane'],
    anyBarber: 'Bez znaczenia', anyBarberSub: 'Pierwszy wolny fotel',
    closed: 'nieczynne', noSlots: 'Brak wolnych terminów, wybierz inny dzień',
    name: 'Imię', phoneL: 'Telefon (do przypomnienia)', confirm: 'Potwierdź rezerwację', back: 'Wstecz',
    summary: 'Twoja wizyta', total: 'Razem', pickFirst: 'Najpierw wybierz usługę',
    doneH: 'Gotowe, fotel czeka.',
    doneP: 'Wersja pokazowa: nic nie zostało wysłane. Na prawdziwej stronie salon dostaje rezerwację, a Ty potwierdzenie i przypomnienie na WhatsAppie.',
    again: 'Nowa rezerwacja',
    revLab: 'Opinie', revH: '4,9 z ponad 380 opinii',
    reviews: [
      ['Wreszcie barber, u którego nie czekasz godziny. Zarezerwowałem w pociągu, o 17:30 siedziałem w fotelu. Fade idealny.', 'Thomas, Wyck'],
      ['Yusuf naprawdę dopytuje, czego chcesz. Najlepszy fade, jaki miałem w Maastricht.', 'Rachid'],
      ['Dostałem golenie na gorąco na urodziny. Polecam, czujesz się jak po godzinie urlopu.', 'Jeroen M.'],
    ],
    visitLab: 'Dojazd', visitH: 'W samym sercu Wyck, pięć minut od dworca',
    hoursH: 'Godziny otwarcia', days: ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota', 'Niedziela'],
    hoursNote: 'W czwartki otwarte dłużej, do 21:00.',
    openNow: 'Teraz otwarte', closedNow: 'Teraz zamknięte', until: 'do', opensAt: 'otwieramy',
    mapNote: 'Mapa Google ładuje się dopiero po kliknięciu, więc bez cookies na start.', showMap: 'Pokaż mapę',
    contactH: 'Kontakt', whatsapp: 'WhatsApp',
    demo: 'Strona koncepcyjna fikcyjnego barbershopu, wykonana przez Vervo Studio.', credit: 'Strona: Vervo Studio ↗', privacy: 'Prywatność',
  },
};
const t = T[lang];
// godziny: [otwarcie, zamknięcie] w minutach od północy, pon = 0
const HOURS = [[12 * 60, 19 * 60], [9 * 60, 19 * 60], [9 * 60, 19 * 60], [9 * 60, 21 * 60], [9 * 60, 19 * 60], [9 * 60, 17 * 60], null];
const fmt = (m) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
const cfg = { lang, services: SERVICES.map((s) => ({ ...s, name: t.services[s.id][0] })), barbers: BARBERS.map((b) => ({ id: b.id, name: t.barbers[b.id][0] })), hours: HOURS, t: { closed: t.closed, noSlots: t.noSlots, anyBarber: t.anyBarber, total: t.total, pickFirst: t.pickFirst, minutes: t.minutes, openNow: t.openNow, closedNow: t.closedNow, until: t.until, opensAt: t.opensAt, days: t.days } };
const mapEmbed = 'https://maps.google.com/maps?q=Wyck%20Maastricht&z=15&output=embed';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&display=swap" />
    <link rel="preload" as="image" href={img('hero.webp')} />
  </head>
  <body>
    <Curtain />
    <header class="hd" id="hd">
      <a class="hd__logo" href="#top">Scheermes</a>
      <nav class="hd__nav">
        {['#prijzen', '#werk', '#team', '#contact'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}
      </nav>
      <a class="btn btn--brass hd__cta" href="#boeken">{t.book}</a>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero__img" src={img('hero.webp')} alt="" fetchpriority="high" />
        <div class="hero__in">
          <p class="kicker">{t.kicker}</p>
          <h1><span>{t.h1[0]}</span><em>{t.h1[1]}</em></h1>
          <p class="hero__lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--brass" href="#boeken">{t.book}</a>
            <a class="btn btn--line" href="#prijzen">{t.seePrices}</a>
          </div>
          <p class="status" data-status></p>
        </div>
        <ul class="hero__stats">
          {t.stats.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}
        </ul>
      </section>

      <div class="ticker" aria-hidden="true">
        <div class="ticker__row">
          {[0, 1].map(() => t.ticker.map((w) => <span>{w}<i>✦</i></span>))}
        </div>
      </div>

      <section class="sec" id="prijzen">
        <div class="wrap">
          <p class="lab rv">{t.pricesLab}</p>
          <h2 class="h2 rv">{t.pricesH}</h2>
          <ul class="prices rv">
            {SERVICES.map((s) => (
              <li class="price">
                <div class="price__t">
                  <b>{t.services[s.id][0]}</b>
                  <span>{t.services[s.id][1]} · {s.min} {t.minutes}</span>
                </div>
                <span class="price__dots" aria-hidden="true"></span>
                <span class="price__p">€{s.price}</span>
                <a class="price__go" href="#boeken" data-pick-service={s.id}>{t.bookThis} →</a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="sec sec--work" id="werk">
        <div class="wrap">
          <p class="lab rv">{t.workLab}</p>
          <h2 class="h2 rv">{t.workH}</h2>
        </div>
        <div class="work" tabindex="0">
          {t.work.map(([f, c], i) => (
            <figure class={`work__i work__i--${i % 3}`}>
              <img src={img(f)} alt={c} loading="lazy" />
              <figcaption>{c}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="sec" id="team">
        <div class="wrap">
          <p class="lab rv">{t.teamLab}</p>
          <h2 class="h2 rv">{t.teamH}</h2>
          <div class="team">
            {BARBERS.map((b) => (
              <article class="barber rv">
                <img src={img(b.img)} alt={t.barbers[b.id][0]} loading="lazy" />
                <div class="barber__t">
                  <h3>{t.barbers[b.id][0]}</h3>
                  <p>{t.barbers[b.id][1]}</p>
                  <a href="#boeken" data-pick-barber={b.id}>{t.bookWith} {t.barbers[b.id][0]} →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="sec sec--book" id="boeken">
        <div class="wrap book">
          <div class="book__head">
            <p class="lab">{t.bookLab}</p>
            <h2 class="h2">{t.bookH}</h2>
            <ol class="book__steps" data-steps>
              {t.steps.map((s, i) => <li data-step-dot={i}><span>{i + 1}</span>{s}</li>)}
            </ol>
          </div>
          <form class="book__form" data-book novalidate>
            <fieldset data-step="0">
              <legend>{t.steps[0]}</legend>
              <div class="chips chips--svc">
                {SERVICES.map((s) => (
                  <label class="chip"><input type="radio" name="svc" value={s.id} /><span><b>{t.services[s.id][0]}</b><small>{s.min} {t.minutes} · €{s.price}</small></span></label>
                ))}
              </div>
            </fieldset>
            <fieldset data-step="1" hidden>
              <legend>{t.steps[1]}</legend>
              <div class="chips chips--barber">
                <label class="chip"><input type="radio" name="barber" value="any" /><span><b>{t.anyBarber}</b><small>{t.anyBarberSub}</small></span></label>
                {BARBERS.map((b) => (
                  <label class="chip chip--img"><input type="radio" name="barber" value={b.id} /><span><img src={img(b.img)} alt="" loading="lazy" /><b>{t.barbers[b.id][0]}</b><small>{t.barbers[b.id][1]}</small></span></label>
                ))}
              </div>
              <button type="button" class="link" data-back>{t.back}</button>
            </fieldset>
            <fieldset data-step="2" hidden>
              <legend>{t.steps[2]}</legend>
              <div class="chips chips--days" data-days></div>
              <button type="button" class="link" data-back>{t.back}</button>
            </fieldset>
            <fieldset data-step="3" hidden>
              <legend>{t.steps[3]}</legend>
              <div class="chips chips--times" data-times></div>
              <button type="button" class="link" data-back>{t.back}</button>
            </fieldset>
            <fieldset data-step="4" hidden>
              <legend>{t.steps[4]}</legend>
              <label class="field"><span>{t.name}</span><input name="naam" autocomplete="name" required /></label>
              <label class="field"><span>{t.phoneL}</span><input name="tel" type="tel" autocomplete="tel" required /></label>
              <button class="btn btn--brass btn--full" type="submit">{t.confirm}</button>
              <button type="button" class="link" data-back>{t.back}</button>
            </fieldset>
            <div class="done" data-done hidden>
              <p class="done__mark">✓</p>
              <h3>{t.doneH}</h3>
              <p class="done__what" data-done-what></p>
              <p class="done__note">{t.doneP}</p>
              <button type="button" class="btn btn--line" data-again>{t.again}</button>
            </div>
          </form>
          <aside class="book__sum" aria-live="polite">
            <p class="lab">{t.summary}</p>
            <div data-sum><p class="muted">{t.pickFirst}</p></div>
          </aside>
        </div>
      </section>

      <section class="sec" id="reviews">
        <div class="wrap">
          <p class="lab rv">{t.revLab}</p>
          <h2 class="h2 rv"><span class="stars" aria-hidden="true">★★★★★</span> {t.revH}</h2>
          <div class="revs">
            {t.reviews.map(([q, w]) => <blockquote class="rev rv"><p>“{q}”</p><cite>{w}</cite></blockquote>)}
          </div>
        </div>
      </section>

      <section class="sec sec--visit" id="contact">
        <div class="wrap visit">
          <div>
            <p class="lab rv">{t.visitLab}</p>
            <h2 class="h2 rv">{t.visitH}</h2>
            <h3 class="visit__h3">{t.hoursH}</h3>
            <table class="hours">
              <tbody>
                {HOURS.map((h, i) => <tr data-day={i}><th>{t.days[i]}</th><td>{h ? `${fmt(h[0])} – ${fmt(h[1])}` : t.closed}</td></tr>)}
              </tbody>
            </table>
            <p class="muted">{t.hoursNote}</p>
            <h3 class="visit__h3">{t.contactH}</h3>
            <p class="visit__addr">Rechtstraat · 6221 Maastricht<br /><a href={`tel:${tel}`}>{phone}</a></p>
          </div>
          <div class="map" data-map>
            <img src={img('stoel.webp')} alt="" loading="lazy" />
            <div class="map__over">
              <p>{t.mapNote}</p>
              <button class="btn btn--brass" type="button" data-map-btn data-src={mapEmbed}>{t.showMap}</button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap ft__in">
        <p class="ft__logo">Scheermes</p>
        <p>Rechtstraat · 6221 Maastricht · KvK 00000000 · BTW NL000000000B01</p>
        <p class="ft__demo">{t.demo} <a href={`${base}/`}>{t.credit}</a> · <a href="#top">{t.privacy}</a></p>
      </div>
    </footer>

    <div class="mbar">
      <a href={`tel:${tel}`}>{t.call}</a>
      <a href="#boeken" class="mbar__go">{t.book}</a>
    </div>
    <DemoLang lang={lang} links={[['nl', root('nl')], ['en', root('en')], ['pl', root('pl')]]} />
    <script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
  </body>
</html>

<style is:global>
  :root { --bg: #121110; --bg2: #1b1917; --fg: #efe6d8; --mut: #a39a8c; --line: rgba(239, 230, 216, 0.14); --brass: #c8a165; --brass2: #e0bd84; --ff-d: 'Anton', Impact, sans-serif; --ff-s: 'Instrument Serif', Georgia, serif; --ff-b: 'Inter Tight', system-ui, sans-serif; }
