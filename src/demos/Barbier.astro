  },
  en: {
    title: 'Scheermes — barbershop in Wyck, Maastricht',
    desc: 'Fades, cuts, beards and hot towel shaves in Wyck, Maastricht. Book your chair online in 30 seconds.',
    nav: ['Prices', 'Work', 'Team', 'Contact'], book: 'Book your chair', call: 'Call',
    kicker: 'Barbershop · Wyck, Maastricht',
    h1: ['Sharp cuts.', 'No waiting.'],
    lede: 'Fades, classic cuts and hot towel shaves. Book online, walk in, your chair is ready.',
