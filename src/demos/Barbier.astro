  .chip input:disabled + span { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }
  .chip--img > span { grid-template-columns: 3rem 1fr; column-gap: 0.8rem; align-items: center; }
  .chip--img img { grid-row: span 2; width: 3rem; height: 3rem; object-fit: cover; border-radius: 50%; filter: grayscale(1); }
  .chips--days .chip > span, .chips--times .chip > span { text-align: center; padding: 0.75rem 0.4rem; }
  .field { display: grid; gap: 0.35rem; margin-bottom: 0.9rem; font-size: 0.86rem; color: var(--mut); }
  .field input { background: transparent; border: 1px solid var(--line); border-radius: 2px; padding: 0.9rem 1rem; color: var(--fg); font: 400 1rem var(--ff-b); }
  .field input:focus { outline: none; border-color: var(--brass); }
  .field input.is-bad { border-color: #d9786b; }
  .book__sum { border: 1px solid var(--line); padding: 1.4rem; position: sticky; top: 5.5rem; }
  .sum__row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  .sum__row span:first-child { color: var(--mut); }
  .sum__tot { display: flex; justify-content: space-between; align-items: baseline; margin-top: 1rem; }
  .sum__tot b { font: 400 2rem/1 var(--ff-d); color: var(--brass2); }
  .done { text-align: left; }
  .done__mark { width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 50%; background: var(--brass); color: #16120c; font-size: 1.4rem; margin-bottom: 1.2rem; }
  .done h3 { font: 400 2rem/1 var(--ff-d); text-transform: uppercase; }
  .done__what { margin: 0.8rem 0; font-size: 1.05rem; }
  .done__note { color: var(--mut); font-size: 0.86rem; margin-bottom: 1.2rem; max-width: 34rem; }

  .stars { color: var(--brass2); font: 400 0.6em var(--ff-b); letter-spacing: 0.1em; vertical-align: middle; }
  .revs { display: grid; gap: 1.2rem; margin-top: 2.6rem; }
  @media (min-width: 860px) { .revs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .rev { border-top: 1px solid var(--brass); padding-top: 1.2rem; }
  .rev p { font: italic 400 1.35rem/1.35 var(--ff-s); }
  .rev cite { display: block; margin-top: 0.8rem; font-style: normal; color: var(--mut); font-size: 0.84rem; }

  .sec--visit { background: var(--bg2); }
  .visit { display: grid; gap: 2.4rem; }
  @media (min-width: 900px) { .visit { grid-template-columns: 1fr 1fr; align-items: start; } }
  .visit__h3 { font: 600 0.78rem/1 var(--ff-b); letter-spacing: 0.2em; text-transform: uppercase; color: var(--mut); margin: 2.2rem 0 0.8rem; }
  .hours { width: 100%; border-collapse: collapse; font-size: 0.95rem; max-width: 26rem; }
  .hours th, .hours td { text-align: left; padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-weight: 400; }
  .hours td { text-align: right; color: var(--mut); }
  .hours tr.is-today th, .hours tr.is-today td { color: var(--brass2); font-weight: 600; }
  .visit__addr { font-size: 1.05rem; }
  .visit__addr a { color: var(--brass2); }
  .map { position: relative; aspect-ratio: 4 / 3.4; overflow: hidden; background: #000; }
  .map img, .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .map img { opacity: 0.6; }
  .map__over { position: absolute; inset: auto 0 0; padding: 1.4rem; display: grid; gap: 0.8rem; justify-items: start; background: linear-gradient(transparent, rgba(0, 0, 0, 0.75)); font-size: 0.86rem; color: #ddd3c3; }

  .ft { border-top: 1px solid var(--line); padding: 3rem 0 6.5rem; font-size: 0.84rem; color: var(--mut); }
  .ft__in { display: grid; gap: 0.6rem; }
  .ft__logo { font: 400 2.4rem/1 var(--ff-d); text-transform: uppercase; color: var(--fg); }
  .ft__demo a { color: var(--brass); }
  @media (min-width: 1000px) { .ft { padding-bottom: 3rem; } }

  .mbar { position: fixed; z-index: 70; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 2fr; padding-bottom: env(safe-area-inset-bottom, 0); background: var(--bg); border-top: 1px solid var(--line); }
  .mbar a { padding: 1.05rem; text-align: center; text-decoration: none; font: 600 0.92rem var(--ff-b); }
  .mbar__go { background: var(--brass); color: #16120c; }
  @media (min-width: 1000px) { .mbar { display: none; } }

  .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.8s, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } .hero__img, .ticker__row { animation: none; } html { scroll-behavior: auto; } }
</style>

<script>
  const cfg = JSON.parse(document.getElementById('cfg').textContent);
  const T = cfg.t;
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];

  // nagłówek po przewinięciu
  const hd = $('#hd');
  const onScroll = () => hd.classList.toggle('is-solid', scrollY > 40);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // pojawianie się sekcji
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  $$('.rv').forEach((el) => io.observe(el));

  // czas w Maastricht (Europe/Amsterdam)
  const nowNL = () => {
    const p = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).map((x) => [x.type, x.value]));
    const wd = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(p.weekday);
    return { wd, min: +p.hour * 60 + +p.minute };
  };
  const fmt = (m) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  const { wd, min } = nowNL();
  $(`.hours tr[data-day="${wd}"]`)?.classList.add('is-today');
  const st = $('[data-status]');
  const h = cfg.hours[wd];
  if (h && min >= h[0] && min < h[1]) st.innerHTML = `<i></i>${T.openNow} · ${T.until} ${fmt(h[1])}`;
  else {
    let d = wd, label = '';
    for (let k = 0; k < 7; k++) { const dd = (wd + k) % 7, hh = cfg.hours[dd]; if (hh && (k > 0 || min < hh[0])) { label = `${k === 0 ? '' : T.days[dd].toLowerCase() + ' '}${fmt(hh[0])}`; break; } }
    st.classList.add('is-closed'); st.innerHTML = `<i></i>${T.closedNow} · ${T.opensAt} ${label}`;
  }

  // mapa po kliknięciu
  $('[data-map-btn]')?.addEventListener('click', (e) => {
    const f = document.createElement('iframe');
    f.src = e.currentTarget.dataset.src; f.loading = 'lazy'; f.title = 'Google Maps';
    $('[data-map]').replaceChildren(f);
  });

  // ---------- rezerwacja ----------
  const form = $('[data-book]');
  const steps = $$('fieldset', form);
  const dots = $$('[data-step-dot]');
  const state = { svc: null, barber: null, day: null, time: null };
  const svcOf = (id) => cfg.services.find((s) => s.id === id);
  const show = (i) => {
    steps.forEach((f, k) => (f.hidden = k !== i));
    $('[data-done]').hidden = true;
    dots.forEach((d, k) => { d.classList.toggle('is-on', k === i); d.classList.toggle('is-done', k < i); });
  };
  let cur = 0;
  const go = (i) => { cur = i; show(i); };

  // dni: najbliższe 10 dni z godzinami otwarcia
  const dayList = () => {
    const out = [];
    const base = new Date();
    for (let k = 0; out.length < 10 && k < 14; k++) {
      const d = new Date(base); d.setDate(base.getDate() + k);
      const idx = (d.getDay() + 6) % 7;
      out.push({ k, idx, date: d, open: !!cfg.hours[idx] });
    }
    return out;
  };
  const locale = { en: 'en-GB', nl: 'nl-NL', pl: 'pl-PL' }[cfg.lang];
  // pseudo-losowe zajęte terminy, stałe dla dnia + barbera
  const seeded = (s) => { let x = 0; for (const c of s) x = (x * 31 + c.charCodeAt(0)) >>> 0; return () => ((x = (x * 1103515245 + 12345) >>> 0) / 4294967296); };
  const renderDays = () => {
    const box = $('[data-days]');
    box.innerHTML = dayList().map((d) => {
      const lab = d.date.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' });
      return `<label class="chip"><input type="radio" name="day" value="${d.k}" ${d.open ? '' : 'disabled'} /><span><b>${lab}</b>${d.open ? '' : `<small>${T.closed}</small>`}</span></label>`;
    }).join('');
  };
  const renderTimes = () => {
    const d = dayList().find((x) => x.k === state.day);
    const hh = cfg.hours[d.idx];
    const dur = svcOf(state.svc).min;
    const rnd = seeded(`${d.date.toDateString()}-${state.barber}`);
    const { min } = nowNL();
    const slots = [];
    for (let m = hh[0]; m + dur <= hh[1]; m += 30) {
      const past = d.k === 0 && m <= min + 30;
      const taken = rnd() < (state.barber === 'any' ? 0.25 : 0.45);
      slots.push(`<label class="chip"><input type="radio" name="time" value="${m}" ${past || taken ? 'disabled' : ''} /><span><b>${fmt(m)}</b></span></label>`);
    }
    $('[data-times]').innerHTML = slots.join('') || `<p class="muted">${T.noSlots}</p>`;
  };
  const renderSum = () => {
    const s = state.svc && svcOf(state.svc);
    if (!s) { $('[data-sum]').innerHTML = `<p class="muted">${T.pickFirst}</p>`; return; }
    const b = state.barber ? (state.barber === 'any' ? T.anyBarber : cfg.barbers.find((x) => x.id === state.barber).name) : '–';
    const d = state.day != null ? dayList().find((x) => x.k === state.day).date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }) : '–';
    const tm = state.time != null ? fmt(state.time) : '–';
    $('[data-sum]').innerHTML = `
      <div class="sum__row"><span>${s.name}</span><span>${s.min} ${T.minutes}</span></div>
      <div class="sum__row"><span>Barber</span><span>${b}</span></div>
      <div class="sum__row"><span>📅</span><span>${d}</span></div>
      <div class="sum__row"><span>🕒</span><span>${tm}</span></div>
      <div class="sum__tot"><span>${T.total}</span><b>€${s.price}</b></div>`;
  };

  form.addEventListener('change', (e) => {
    const { name, value } = e.target;
    if (name === 'svc') { state.svc = value; renderSum(); go(1); }
    if (name === 'barber') { state.barber = value; state.day = null; state.time = null; renderDays(); renderSum(); go(2); }
    if (name === 'day') { state.day = +value; state.time = null; renderTimes(); renderSum(); go(3); }
    if (name === 'time') { state.time = +value; renderSum(); go(4); setTimeout(() => form.naam.focus({ preventScroll: true }), 50); }
  });
  $$('[data-back]', form).forEach((b) => b.addEventListener('click', () => go(Math.max(0, cur - 1))));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    ['naam', 'tel'].forEach((n) => { const bad = form[n].value.trim().length < 2; form[n].classList.toggle('is-bad', bad); if (bad) ok = false; });
    if (!ok) return;
    const s = svcOf(state.svc);
    const d = dayList().find((x) => x.k === state.day).date.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' });
    $('[data-done-what]').textContent = `${s.name} · ${d} · ${fmt(state.time)}`;
    steps.forEach((f) => (f.hidden = true));
    $('[data-done]').hidden = false;
    dots.forEach((x) => { x.classList.remove('is-on'); x.classList.add('is-done'); });
  });
  $('[data-again]').addEventListener('click', () => { form.reset(); Object.assign(state, { svc: null, barber: null, day: null, time: null }); renderSum(); go(0); });

  // skróty z cennika i zespołu
  $$('[data-pick-service]').forEach((a) => a.addEventListener('click', () => {
    const r = form.querySelector(`input[name="svc"][value="${a.dataset.pickService}"]`);
    r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true }));
  }));
  $$('[data-pick-barber]').forEach((a) => a.addEventListener('click', () => {
    if (!state.svc) { const r = form.querySelector('input[name="svc"][value="knip"]'); r.checked = true; state.svc = 'knip'; }
    const r = form.querySelector(`input[name="barber"][value="${a.dataset.pickBarber}"]`);
    r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true }));
  }));
  show(0);
</script>
