---
import Curtain from '../components/Curtain.astro';
import DemoLang from '../components/DemoLang.astro';
// Scheermes (demo): barbershop in Maastricht, NL + EN. Strony: src/pages/barbier/ (NL) i /en/ (EN).
// Fikcyjna firma: numery, adres i opinie są przykładowe.

const { lang = 'nl' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f) => `${base}/img/barbier/${f}`;
const root = (l) => `${base}/barbier/${l === 'nl' ? '' : `${l}/`}`;
const phone = '043 000 00 00';
const tel = '+31430000000';

const SERVICES = [
  { id: 'knip', min: 30, price: 32 },
  { id: 'fade', min: 40, price: 36 },
  { id: 'combo', min: 60, price: 52 },
  { id: 'baard', min: 20, price: 22 },
  { id: 'shave', min: 30, price: 34 },
  { id: 'buzz', min: 20, price: 22 },
  { id: 'kids', min: 25, price: 24 },
];
const BARBERS = [
  { id: 'yusuf', img: 'yusuf.webp' },
  { id: 'mila', img: 'mila.webp' },
  { id: 'daan', img: 'werk.webp' },
];

const T = {
  nl: {
    title: 'Scheermes — barbershop in Wyck, Maastricht',
