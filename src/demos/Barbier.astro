  @media (min-width: 980px) { .book { grid-template-columns: 1.1fr 1.6fr 0.9fr; align-items: start; } }
  .book__steps { list-style: none; margin-top: 2rem; display: grid; gap: 0.6rem; }
  .book__steps li { display: flex; align-items: center; gap: 0.7rem; color: var(--mut); font-size: 0.9rem; }
  .book__steps span { width: 1.7rem; height: 1.7rem; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); font-size: 0.76rem; }
