  .sw__b:hover { transform: scale(1.08); }
  .sw__b[aria-checked='true'] { box-shadow: 0 0 0 3px var(--bg2), 0 0 0 5px var(--ink); }
  .seg { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-top: 0.7rem; }
  .seg span { width: 5.6rem; font-size: 0.82rem; color: var(--mut); }
  .seg button { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 0.5rem 0.95rem; font: 500 0.84rem var(--ff-b); cursor: pointer; color: var(--ink); }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .studio__view { background: #fff; border-radius: 28px; padding: clamp(1.4rem, 4vw, 2.6rem); box-shadow: 0 30px 60px -40px rgba(43, 29, 34, 0.5); }
  .nails { display: flex; justify-content: center; align-items: flex-end; gap: clamp(0.4rem, 2vw, 1rem); height: clamp(11rem, 30vw, 15rem); }
  .nails svg { width: clamp(3rem, 11vw, 5rem); height: auto; transform: scale(var(--s)) rotate(var(--r)); transform-origin: bottom center; overflow: visible; filter: drop-shadow(0 10px 12px rgba(43, 29, 34, 0.18)); }
  .nail__base { fill: var(--c); transition: fill 0.35s; }
  .nails[data-finish='mat'] .nail__gloss, .nails:not([data-finish='chroom']) .nail__chrome { display: none; }
  .nails[data-finish='chroom'] .nail__gloss { opacity: 0.4; }
  .choice { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 0.9rem; align-items: center; margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .choice__dot { width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--c); box-shadow: inset 0 -5px 8px rgba(0, 0, 0, 0.12); }
  .choice small { display: block; color: var(--mut); font-size: 0.76rem; }
  .choice b { font: 600 1.1rem var(--ff-b); }
  .choice .btn { grid-column: 1 / -1; }
  @media (min-width: 560px) { .choice { grid-template-columns: auto 1fr auto; } .choice .btn { grid-column: auto; } }

  .gal { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; margin-top: 2.4rem; }
  @media (min-width: 900px) { .gal { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .gal figure:nth-child(odd) { transform: translateY(1.4rem); }
  .gal img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 18px; }
  .gal figcaption { font-size: 0.8rem; color: var(--mut); margin-top: 0.5rem; }

  .gift { background: var(--ink); color: var(--bg); padding: clamp(4rem, 8vw, 6rem) 0; }
  .gift .lede { color: #cbb9bd; }
  .gift .btn--ink { background: var(--bg); color: var(--ink); margin-top: 1.6rem; }
  .gift__in { display: grid; gap: 2.4rem; align-items: center; }
  @media (min-width: 860px) { .gift__in { grid-template-columns: 0.9fr 1.1fr; } }
  .gift__card { aspect-ratio: 1.6; border-radius: 22px; padding: 1.6rem; display: grid; align-content: space-between; background: linear-gradient(135deg, #f2d4cf, #e7b3a8 60%, #d48e88); color: var(--ink); max-width: 26rem; transform: rotate(-4deg); box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.6); }
  .gift__card span { font: 400 1.4rem var(--ff-d); }
  .gift__card em { color: var(--rose); font-style: normal; }
  .gift__card b { font: 400 3.4rem/1 var(--ff-d); }
  .gift__card small { letter-spacing: 0.2em; text-transform: uppercase; font-size: 0.7rem; }

  .book { display: grid; gap: 2.4rem; }
  @media (min-width: 900px) { .book { grid-template-columns: 1fr 1fr; } }
  .book > * { min-width: 0; }
  .book__img { margin-top: 2rem; border-radius: 22px; aspect-ratio: 16 / 10; object-fit: cover; width: 100%; filter: grayscale(0.2); }
  .form { background: #fff; border-radius: 26px; padding: clamp(1.3rem, 4vw, 2.2rem); border: 1px solid var(--line); display: grid; gap: 0.9rem; align-content: start; }
  .f { display: grid; gap: 0.35rem; font-size: 0.82rem; color: var(--mut); }
  .f input, .f select { font: 400 1rem var(--ff-b); color: var(--ink); background: var(--bg); border: 1px solid transparent; border-radius: 12px; padding: 0.85rem 0.9rem; width: 100%; }
  .f input:focus, .f select:focus { outline: none; border-color: var(--rose); }
  .f .is-bad { border-color: #c0392b; }
  .f2 { display: grid; gap: 0.9rem; }
  @media (min-width: 520px) { .f2 { grid-template-columns: 1fr 1fr; } }
  .done { background: var(--bg); border-radius: 16px; padding: 1.2rem; }
  .done h3 { font: 400 1.6rem/1.1 var(--ff-d); }
  .done p { color: var(--mut); font-size: 0.86rem; margin: 0.5rem 0; }
  .done pre { white-space: pre-wrap; font: 400 0.88rem/1.5 var(--ff-b); background: #dcf8c6; color: #1b2a17; padding: 0.9rem 1rem; border-radius: 12px 12px 12px 2px; }

  .stars { color: #c9973e; font: 400 0.5em var(--ff-b); letter-spacing: 0.12em; vertical-align: middle; }
  .revs { display: grid; gap: 1.2rem; margin-top: 2.4rem; }
  @media (min-width: 860px) { .revs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .revs blockquote { background: #fff; border-radius: 22px; padding: 1.5rem; border: 1px solid var(--line); }
  .revs p { font: 400 1.2rem/1.45 var(--ff-d); }
