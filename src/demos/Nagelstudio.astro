  .ft a { color: var(--rose); }
  .mbar { position: fixed; z-index: 70; left: 0.8rem; right: 7.6rem; bottom: calc(0.8rem + env(safe-area-inset-bottom, 0)); background: var(--ink); color: var(--bg); text-align: center; padding: 1rem; border-radius: 999px; text-decoration: none; font: 600 0.95rem var(--ff-b); box-shadow: 0 16px 30px -12px rgba(43, 29, 34, 0.6); }
  @media (min-width: 1000px) { .mbar { display: none; } .ft { padding-bottom: 3rem; } }
  .dlang { bottom: 0.9rem !important; }

  .rv { opacity: 0; transform: translateY(16px); transition: opacity 0.8s, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rv.is-in { opacity: 1; transform: none; }
  .gal figure.rv:nth-child(odd).is-in { transform: translateY(1.4rem); }
  @media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } html { scroll-behavior: auto; } }
</style>

<script>
  const cfg = JSON.parse(document.getElementById('cfg').textContent);
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];

  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  $$('.rv').forEach((el) => io.observe(el));

  // zakładki zabiegów
  $$('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    $$('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $$('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
  }));

  // studio kolorów
  const st = { color: cfg.colors[0], shape: 'amandel', finish: 'glans' };
  const nails = $('[data-nails]');
  const paint = () => {
    document.documentElement.style.setProperty('--c', st.color.hex);
    nails.dataset.finish = st.finish;
    $$('path', nails).forEach((p) => p.setAttribute('d', cfg.nail[st.shape]));
    $('[data-choice]').textContent = `${st.color.name} · ${cfg.shapes[st.shape]} · ${cfg.finishes[st.finish]}`;
  };
  $$('[data-color]').forEach((b) => b.addEventListener('click', () => {
    st.color = cfg.colors.find((c) => c.id === b.dataset.color);
    $$('[data-color]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    paint();
  }));
  $$('[data-shape]').forEach((b) => b.addEventListener('click', () => { st.shape = b.dataset.shape; $$('[data-shape]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); paint(); }));
  $$('[data-finish]').forEach((b) => b.addEventListener('click', () => { st.finish = b.dataset.finish; $$('[data-finish]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); paint(); }));
  $('[data-take]').addEventListener('click', () => { $('[data-color-select]').value = st.color.id; });
  paint();

  // formularz: data nie wcześniej niż jutro
  const form = $('[data-form]');
  const tm = new Date(); tm.setDate(tm.getDate() + 1);
  form.day.min = tm.toISOString().slice(0, 10);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    ['day', 'name', 'phone'].forEach((n) => { const bad = !form[n].value.trim(); form[n].classList.toggle('is-bad', bad); if (bad) ok = false; });
    if (!ok) return;
    const color = cfg.colors.find((c) => c.id === form.color.value);
    const d = new Date(form.day.value).toLocaleDateString({ en: 'en-GB', nl: 'nl-NL', pl: 'pl-PL' }[cfg.lang], { weekday: 'long', day: 'numeric', month: 'long' });
    const msg = cfg.lang === 'pl'
      ? `Dzień dobry! Proszę o termin na:${form.treat.value}\nKolor: ${color ? `${color.name}, ${cfg.shapes[st.shape]}, ${cfg.finishes[st.finish]}` : cfg.none}\nKiedy: ${d}, ${form.part.value.toLowerCase()}\nImię: ${form.name.value}`
      : cfg.lang === 'en'
      ? `Hi! I'd like to book: ${form.treat.value}\nColour: ${color ? `${color.name}, ${cfg.shapes[st.shape]}, ${cfg.finishes[st.finish]}` : cfg.none}\nWhen: ${d}, ${form.part.value.toLowerCase()}\nName: ${form.name.value}`
      : `Hoi! Ik wil graag een afspraak voor: ${form.treat.value}\nKleur: ${color ? `${color.name}, ${cfg.shapes[st.shape]}, ${cfg.finishes[st.finish]}` : cfg.none}\nWanneer: ${d}, ${form.part.value.toLowerCase()}\nNaam: ${form.name.value}`;
    $('[data-msg]').textContent = msg;
    $('[data-done]').hidden = false;
  });
</script>
