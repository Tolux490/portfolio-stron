  .sec--visit { background: #fff; border-top: 1px solid var(--line); }
  .visit { display: grid; gap: 2.4rem; }
  @media (min-width: 860px) { .visit { grid-template-columns: 1.2fr 1fr; align-items: end; } }
  .addr { margin-top: 1.4rem; font-size: 1.05rem; }
  .addr a { color: var(--rose); }
  .hours { width: 100%; border-collapse: collapse; }
  .hours th, .hours td { text-align: left; font-weight: 400; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
