  .quiz__bar span { display: block; height: 100%; width: 0; background: var(--lime); transition: width 0.4s; }
  .quiz__box { background: #1a1a1a; border: 1.5px solid #333; border-radius: 8px; padding: clamp(1.3rem, 4vw, 2.2rem); }
  .quiz__n { font: 700 0.74rem var(--ff); letter-spacing: 0.14em; text-transform: uppercase; color: var(--lime); }
  .quiz h3 { font: 800 clamp(1.5rem, 3.4vw, 2.1rem)/1.1 var(--ff); font-stretch: 112%; margin: 0.5rem 0 1.2rem; }
  .quiz__opts { display: grid; gap: 0.6rem; }
  .quiz__opts button { text-align: left; background: transparent; color: var(--bg); border: 1.5px solid #444; border-radius: 6px; padding: 1rem 1.1rem; font: 600 1rem var(--ff); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .quiz__opts button:hover { border-color: var(--lime); background: rgba(198, 244, 50, 0.08); }
  .quiz__res p { color: #c9c7c1; }
  .quiz__res ul { list-style: none; margin: 1rem 0 1.4rem; display: grid; gap: 0.4rem; }
  .quiz__res li::before { content: '→ '; color: var(--lime); }
  .quiz__act { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }

  .how { list-style: none; display: grid; gap: 1rem; margin-top: 2.6rem; counter-reset: s; }
  @media (min-width: 860px) { .how { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .how li { border-top: 3px solid var(--ink); padding-top: 1rem; }
  .how span { font: 800 0.9rem var(--ff); background: var(--lime); padding: 0.15rem 0.4rem; border: 1.5px solid var(--ink); }
  .how h3 { font: 800 1.3rem/1.1 var(--ff); font-stretch: 112%; margin: 0.9rem 0 0.4rem; text-transform: uppercase; }
  .how p { color: var(--mut); font-size: 0.94rem; }

  .sec--res { background: #fff; border-block: 1.5px solid var(--ink); }
  .res { display: grid; gap: 1rem; margin-top: 2.6rem; }
  @media (min-width: 900px) { .res { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .res__i { border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden; background: var(--bg); }
  .res__i img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .res__t { padding: 1.3rem; }
  .res__t b { display: block; font: 900 2.4rem/1 var(--ff); font-stretch: 125%; }
  .res__t span { font: 700 0.84rem var(--ff); background: var(--lime); padding: 0.1rem 0.35rem; }
  .res__t p { margin: 1rem 0 0.6rem; font-size: 0.95rem; }
  .res__t cite { font-style: normal; color: var(--mut); font-size: 0.84rem; }

  .coach { display: grid; background: var(--ink); color: var(--bg); }
  @media (min-width: 900px) { .coach { grid-template-columns: 1fr 1fr; } }
  .coach img { width: 100%; height: 100%; min-height: 22rem; object-fit: cover; }
  .coach__t { padding: clamp(2.4rem, 6vw, 5rem) clamp(1.2rem, 5vw, 4rem); align-self: center; }
  .coach .lab::before { border-color: var(--bg); }
  .coach__p { color: #cfcdc7; margin-top: 1rem; max-width: 34rem; }

  .faqw { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .faqw { grid-template-columns: 0.8fr 1.2fr; } }
  .faq details { border-bottom: 1.5px solid var(--ink); padding: 1.1rem 0; }
  .faq summary { cursor: pointer; font: 700 1.08rem/1.35 var(--ff); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::after { content: '+'; font-size: 1.4rem; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq p { color: var(--mut); margin-top: 0.7rem; }

  .sec--lime { background: var(--lime); border-top: 1.5px solid var(--ink); }
  .sec--lime .lab::before { background: var(--ink); }
  .sec--lime .lede { color: #2b2f1b; }
  .intake { display: grid; gap: 2.4rem; }
  @media (min-width: 900px) { .intake { grid-template-columns: 1fr 1fr; align-items: start; } }
  .intake > * { min-width: 0; }
  .intake__tel { margin-top: 1.4rem; font: 700 1.2rem var(--ff); }
  .form { background: #fff; border: 1.5px solid var(--ink); border-radius: 8px; padding: clamp(1.3rem, 4vw, 2rem); display: grid; gap: 1rem; box-shadow: 6px 6px 0 var(--ink); }
  .f { display: grid; gap: 0.35rem; font: 600 0.82rem var(--ff); border: 0; }
  .f input, .f select { font: 400 1rem var(--ff); border: 1.5px solid var(--ink); border-radius: 4px; padding: 0.85rem 0.9rem; background: #fff; width: 100%; }
