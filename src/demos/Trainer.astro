---
import Curtain from '../components/Curtain.astro';
import DemoLang from '../components/DemoLang.astro';
// Kern Personal Training (demo): trener personalny w Maastricht, NL + EN. Strony: src/pages/trainer/ (NL) i /en/ (EN).
// Fikcyjna firma: numery, adres, wyniki i opinie są przykładowe.

const { lang = 'nl' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f) => `${base}/img/trainer/${f}`;
const root = (l) => `${base}/trainer/${l === 'nl' ? '' : `${l}/`}`;
const tel = '+31430000000';

const T = {
  nl: {
    title: 'Kern Personal Training — sterker worden in Maastricht',
    desc: 'Personal training in een privéstudio in Maastricht-Randwyck, duo training en online coaching. Plan een gratis intake.',
    nav: ['Trajecten', 'Welk past bij mij?', 'Resultaten', 'FAQ'], cta: 'Gratis intake',
    kicker: 'Personal training · Maastricht',
    h1: ['Sterker.', 'Fitter.', 'Zonder giswerk.'],
    lede: 'Een plan dat past bij jouw lijf, agenda en doel. Trainen in een rustige privéstudio, met iemand die bijhoudt of je echt vooruitgaat.',
    second: 'Welk traject past bij mij?',
    stats: [['120+', 'klanten begeleid'], ['1 op 1', 'geen drukke sportschool'], ['4 weken', 'tussen elke meting']],
