      online: ['Online coaching', 'You train on your own, but never without a plan. Every week we look at your numbers and technique together.'],
    },
    goalLine: { afvallen: 'focused on fat loss and energy', sterk: 'focused on strength and technique', blessure: 'built up gently, together with your physio', sport: 'aimed at your sport and season' },
    freq: { '1': '1 session a week, plus a home plan', '2': '2 sessions a week', '3': '2 sessions a week, plus one on your own' },
    howLab: 'How it works', howH: 'How we build it up',
    how: [['Intake', 'A free 30-minute talk: goals, injuries, schedule.'], ['Measure', 'Strength, mobility and body composition as a starting point.'], ['Plan', 'Training and nutrition tailored to you, in the app on your phone.'], ['Every 4 weeks', 'Measure again and adjust. You see in black and white what works.']],
    rLab: 'Results', rH: 'Real progress, measured',
    results: [['squat.webp', '−9 kg', 'in 14 weeks', '“After my pregnancy I didn’t know where to start. Now I’m stronger than before.”', 'Eva, 34'], ['deadlift.webp', '60 → 120 kg', 'deadlift in 6 months', '“I thought I couldn’t get strong. Daan showed me it’s technique, not talent.”', 'Mark, 41'], ['core.webp', '0 days', 'of back pain since March', '“After a slipped disc I trained scared. Now I enjoy training again, pain-free.”', 'Sophie, 29']],
    coachLab: 'Your coach', coachH: 'Daan, personal trainer',
    coachP: ['For ten years I’ve trained people who say they’re “not sporty”. My favourite moment: when, after eight weeks, someone does an exercise without hesitation that used to scare them.', 'Certified personal trainer (EREPS level 5) and lifestyle coach. I work together with physiotherapists in Maastricht.'],
    fLab: 'FAQ', fH: 'Common questions',
    faq: [['I’m a complete beginner. Is that a problem?', 'Not at all. Most clients start with no experience. We begin at your level and build up gradually.'], ['Where do I train?', 'In our private studio in Maastricht-Randwyck, with free parking. Training at home is possible too, for a small extra fee.'], ['How soon will I see results?', 'You can measure the difference after 4 weeks and see it after 8 to 12. That’s why we measure every 4 weeks.'], ['Can I stop in between?', 'Yes. Session cards are valid for a year and online coaching can be cancelled monthly.']],
    iLab: 'Free intake', iH: 'Book your first meeting',
    iP: '30 minutes, no strings attached. You’ll hear from me within a day.',
    iName: 'Name', iPhone: 'Phone', iGoal: 'Goal', iWhen: 'When suits you?', when: ['Weekdays, daytime', 'Weekday evenings', 'Saturday'], iSend: 'Request intake',
    doneH: 'Great, I’ll be in touch soon!', doneP: 'Demo version: nothing was sent. On the real site the trainer receives your request straight away.',
    demo: 'Concept website for a fictional personal trainer, made by Vervo Studio.', credit: 'Website by Vervo Studio ↗',
  },
  pl: {
    title: 'Kern Personal Training — trener personalny w Maastricht',
    desc: 'Treningi personalne w prywatnym studiu w Maastricht-Randwyck, treningi w parze i prowadzenie online. Umów bezpłatną konsultację.',
    nav: ['Pakiety', 'Co do mnie pasuje?', 'Efekty', 'FAQ'], cta: 'Bezpłatna konsultacja',
    kicker: 'Trener personalny · Maastricht',
    h1: ['Silniej.', 'Sprawniej.', 'Bez zgadywania.'],
    lede: 'Plan dopasowany do Twojego ciała, grafiku i celu. Trenujesz w spokojnym, prywatnym studiu, z kimś, kto pilnuje Twoich postępów.',
    second: 'Który pakiet do mnie pasuje?',
    stats: [['120+', 'podopiecznych'], ['1 na 1', 'bez tłoku na siłowni'], ['co 4 tyg.', 'pomiar postępów']],
    pLab: 'Pakiety', pH: 'Wybierz, jak chcesz trenować',
    plans: [
      { n: '1 na 1', p: '65 €', u: 'za trening', tag: 'Najczęściej wybierany', d: 'Razem w studiu, każde ćwiczenie pod okiem trenera.', f: ['Konsultacja i pomiary', 'Plan treningowy na miarę', 'Wskazówki żywieniowe', 'Aplikacja z Twoim planem'], bundle: 'Karnet na 10 treningów: 590 €' },
      { n: 'W parze', p: '40 €', u: 'od osoby', d: 'Trening z partnerem lub znajomym, ta sama uwaga trenera.', f: ['Konsultacja dla obojga', 'Plan dla Was dwojga', 'Raźniej i skutecznie'], bundle: 'Karnet na 10 treningów: 360 € od osoby' },
      { n: 'Online', p: '89 €', u: 'miesięcznie', d: 'Trenujesz samodzielnie, z planem i cotygodniowym podsumowaniem.', f: ['Plan w aplikacji', 'Cotygodniowe podsumowanie', 'Uwagi do techniki na podstawie nagrań'], bundle: 'Rezygnujesz w dowolnym miesiącu' },
    ],
    qLab: 'Który pakiet do mnie pasuje?', qH: 'Trzy pytania, jedna podpowiedź',
    qs: [
      ['Jaki masz cel?', [['afvallen', 'Schudnąć'], ['sterk', 'Być silniejszym'], ['blessure', 'Wrócić do formy po kontuzji'], ['sport', 'Poprawić wyniki w moim sporcie']]],
      ['Jak często możesz trenować?', [['1', 'Raz w tygodniu'], ['2', 'Dwa razy w tygodniu'], ['3', 'Trzy razy lub częściej']]],
      ['Jak chcesz trenować?', [['naast', 'Z trenerem obok mnie'], ['samen', 'Razem ze znajomym lub partnerem'], ['online', 'Samodzielnie, z prowadzeniem online']]],
    ],
    qResult: 'Nasza rada', qBook: 'Umów bezpłatną konsultację', qAgain: 'Od nowa',
    advice: {
      naast: ['Trening personalny 1 na 1', 'Trenujesz z trenerem, który widzi każde powtórzenie. Najbezpieczniejsza i najszybsza droga do efektów.'],
      samen: ['Trening w parze', 'We dwoje łatwiej o motywację, a do tego wychodzi sporo taniej na osobę.'],
      online: ['Prowadzenie online', 'Trenujesz samodzielnie, ale nigdy bez planu. Co tydzień razem patrzymy na wyniki i technikę.'],
    },
    goalLine: { afvallen: 'z naciskiem na spalanie tkanki tłuszczowej i energię', sterk: 'z naciskiem na siłę i technikę', blessure: 'spokojnie, w porozumieniu z Twoim fizjoterapeutą', sport: 'pod Twoją dyscyplinę i sezon' },
    freq: { '1': '1 trening w tygodniu plus plan do domu', '2': '2 treningi w tygodniu', '3': '2 treningi w tygodniu plus jeden samodzielny' },
    howLab: 'Jak pracujemy', howH: 'Krok po kroku',
    how: [['Konsultacja', 'Bezpłatna, 30 minut: cele, kontuzje, grafik.'], ['Pomiary', 'Siła, mobilność i skład ciała jako punkt wyjścia.'], ['Plan', 'Trening i żywienie na miarę, w aplikacji w telefonie.'], ['Co 4 tygodnie', 'Znowu mierzymy i poprawiamy plan. Czarno na białym widzisz, co działa.']],
    rLab: 'Efekty', rH: 'Prawdziwe postępy, zmierzone',
    results: [['squat.webp', '−9 kg', 'w 14 tygodni', '„Po ciąży nie wiedziałam, od czego zacząć. Teraz jestem silniejsza niż przedtem.”', 'Eva, 34 lata'], ['deadlift.webp', '60 → 120 kg', 'w martwym ciągu w pół roku', '„Myślałem, że nie dam rady być silny. Daan pokazał mi, że to kwestia techniki, a nie talentu.”', 'Mark, 41 lat'], ['core.webp', '0 dni', 'z bólem pleców od marca', '„Po dyskopatii bałam się ćwiczyć. Dziś trenuję z przyjemnością i bez bólu.”', 'Sophie, 29 lat']],
    coachLab: 'Twój trener', coachH: 'Daan, trener personalny',
    coachP: ['Od dziesięciu lat trenuję ludzi, którzy mówią o sobie, że „nie są sportowcami”. Mój ulubiony moment: kiedy po ośmiu tygodniach ktoś bez wahania robi ćwiczenie, którego wcześniej się bał.', 'Certyfikowany trener personalny (EREPS poziom 5) i coach zdrowego stylu życia. Współpracuję z fizjoterapeutami w Maastricht.'],
    fLab: 'FAQ', fH: 'Często zadawane pytania',
    faq: [['Jestem zupełnie początkujący. Czy to problem?', 'Wręcz przeciwnie. Większość podopiecznych zaczyna bez doświadczenia. Startujemy od Twojego poziomu i spokojnie budujemy formę.'], ['Gdzie odbywają się treningi?', 'W naszym prywatnym studiu w Maastricht-Randwyck, z darmowym parkingiem. Możemy też trenować u Ciebie w domu, za niewielką dopłatą.'], ['Kiedy zobaczę efekty?', 'Po 4 tygodniach zmierzysz różnicę, po 8–12 ją zobaczysz. Dlatego mierzymy postępy co 4 tygodnie.'], ['Czy mogę przerwać w trakcie?', 'Tak. Karnety są ważne przez rok, a z prowadzenia online możesz zrezygnować w dowolnym miesiącu.']],
    iLab: 'Bezpłatna konsultacja', iH: 'Umów się na pierwsze spotkanie',
    iP: '30 minut, bez zobowiązań. Odezwę się w ciągu jednego dnia.',
    iName: 'Imię', iPhone: 'Telefon', iGoal: 'Cel', iWhen: 'Kiedy Ci pasuje?', when: ['W tygodniu, w dzień', 'W tygodniu, wieczorem', 'W sobotę'], iSend: 'Umów konsultację',
    doneH: 'Super, niedługo się odezwę!', doneP: 'Wersja pokazowa: nic nie zostało wysłane. Na prawdziwej stronie trener od razu dostaje Twoje zgłoszenie.',
    demo: 'Strona koncepcyjna fikcyjnego trenera personalnego, wykonana przez Vervo Studio.', credit: 'Strona: Vervo Studio ↗',
  },
