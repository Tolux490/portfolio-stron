  .rv { opacity: 0; transform: translateY(16px); transition: opacity 0.7s, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .rv { opacity: 1; transform: none; } html { scroll-behavior: auto; } }
</style>

<script>
  const cfg = JSON.parse(document.getElementById('cfg').textContent);
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  $$('.rv').forEach((el) => io.observe(el));

  // quiz: 3 pytania, potem rekomendacja
  const qs = $$('[data-q]');
  const ans = [];
  const bar = $('[data-bar]');
  const step = (i) => { qs.forEach((q, k) => (q.hidden = k !== i)); bar.style.width = `${(i / 3) * 100}%`; };
  qs.forEach((q, i) => $$('button', q).forEach((b) => b.addEventListener('click', () => {
    ans[i] = b.dataset.v;
    if (i < 2) return step(i + 1);
    qs.forEach((x) => (x.hidden = true));
    bar.style.width = '100%';
    const [goal, freq, how] = ans;
    const [h, p] = cfg.advice[how];
    $('[data-res-h]').textContent = h;
    $('[data-res-p]').textContent = p;
    $('[data-res-l]').innerHTML = `<li>${cfg.goalLine[goal]}</li><li>${cfg.freq[freq]}</li>`;
    $('[data-res]').hidden = false;
  })));
  $('[data-again]').addEventListener('click', () => { ans.length = 0; $('[data-res]').hidden = true; step(0); });
  $('[data-res-go]').addEventListener('click', () => { if (ans[0]) $('[data-form]').goal.value = ans[0]; });

  // formularz intake (demo)
  const form = $('[data-form]');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    ['name', 'phone'].forEach((n) => { const bad = form[n].value.trim().length < 2; form[n].classList.toggle('is-bad', bad); if (bad) ok = false; });
    if (ok) $('[data-done]').hidden = false;
  });
</script>
