      ['How often can you train?', [['1', 'Once a week'], ['2', 'Twice a week'], ['3', 'Three times or more']]],
      ['How do you want to be coached?', [['naast', 'Someone next to me in the studio'], ['samen', 'Together with a friend or partner'], ['online', 'On my own, with online coaching']]],
    ],
    qResult: 'Our advice', qBook: 'Book your free intake', qAgain: 'Start over',
    advice: {
