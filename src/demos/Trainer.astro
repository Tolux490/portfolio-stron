    plans: [
      { n: '1-op-1', p: '€65', u: 'per sessie', tag: 'Meest gekozen', d: 'Samen in de studio, elke oefening gecoacht.', f: ['Intake en meting', 'Trainingsplan op maat', 'Voedingsadvies', 'App met je schema'], bundle: 'Strippenkaart 10x: €590' },
      { n: 'Duo', p: '€40', u: 'per persoon', d: 'Trainen met een partner of vriend, zelfde aandacht.', f: ['Intake voor allebei', 'Plan voor jullie twee', 'Gezellig én effectief'], bundle: 'Strippenkaart 10x: €360 p.p.' },
      { n: 'Online', p: '€89', u: 'per maand', d: 'Zelf trainen met een plan en wekelijkse check-ins.', f: ['Schema in de app', 'Wekelijkse check-in', 'Video-feedback op techniek'], bundle: 'Maandelijks opzegbaar' },
    ],
    qLab: 'Welk traject past bij mij?', qH: 'Drie vragen, één advies',
    qs: [
      ['Wat is je doel?', [['afvallen', 'Afvallen'], ['sterk', 'Sterker worden'], ['blessure', 'Fit na een blessure'], ['sport', 'Beter in mijn sport']]],
      ['Hoe vaak kun je trainen?', [['1', '1 keer per week'], ['2', '2 keer per week'], ['3', '3 keer of vaker']]],
      ['Hoe wil je begeleid worden?', [['naast', 'Iemand naast me in de studio'], ['samen', 'Samen met een vriend of partner'], ['online', 'Zelf trainen, online coaching']]],
    ],
    qResult: 'Ons advies', qBook: 'Plan je gratis intake', qAgain: 'Opnieuw',
