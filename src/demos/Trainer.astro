const t = T[lang];
const cfg = { advice: t.advice, goalLine: t.goalLine, freq: t.freq, goals: t.qs[0][1] };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" />
  </head>
  <body>
    <Curtain />
    <header class="hd">
      <a class="hd__logo" href="#top">KERN<span>●</span></a>
      <nav class="hd__nav">{['#trajecten', '#quiz', '#resultaten', '#faq'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}</nav>
      <a class="btn btn--lime hd__cta" href="#intake">{t.cta}</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero__txt">
          <p class="kicker">{t.kicker}</p>
          <h1>{t.h1.map((w, i) => <span class={i === 2 ? 'is-acc' : ''}>{w}</span>)}</h1>
          <p class="lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--lime" href="#intake">{t.cta} →</a>
            <a class="btn btn--line" href="#quiz">{t.second}</a>
          </div>
        </div>
        <div class="hero__img">
          <img src={img('hero.webp')} alt="" fetchpriority="high" />
          <ul class="hero__stats">{t.stats.map(([b, s]) => <li><b>{b}</b><span>{s}</span></li>)}</ul>
        </div>
      </section>

      <section class="sec" id="trajecten">
        <div class="wrap">
          <p class="lab rv">{t.pLab}</p>
          <h2 class="h2 rv">{t.pH}</h2>
          <div class="plans">
            {t.plans.map((p, i) => (
              <article class={`plan rv${i === 0 ? ' plan--top' : ''}`}>
                {p.tag && <span class="plan__tag">{p.tag}</span>}
                <h3>{p.n}</h3>
                <p class="plan__price"><b>{p.p}</b> {p.u}</p>
                <p class="plan__d">{p.d}</p>
                <ul>{p.f.map((x) => <li>{x}</li>)}</ul>
                <p class="plan__b">{p.bundle}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="sec sec--dark" id="quiz">
        <div class="wrap quiz">
          <div>
            <p class="lab">{t.qLab}</p>
            <h2 class="h2">{t.qH}</h2>
            <div class="quiz__bar"><span data-bar></span></div>
          </div>
          <div class="quiz__box" data-quiz>
            {t.qs.map(([q, opts], i) => (
              <div class="quiz__q" data-q={i} hidden={i !== 0}>
                <p class="quiz__n">{i + 1} / 3</p>
                <h3>{q}</h3>
                <div class="quiz__opts">{opts.map(([v, l]) => <button type="button" data-v={v}>{l}</button>)}</div>
              </div>
            ))}
            <div class="quiz__res" data-res hidden>
              <p class="quiz__n">{t.qResult}</p>
              <h3 data-res-h></h3>
              <p data-res-p></p>
              <ul data-res-l></ul>
              <div class="quiz__act"><a class="btn btn--lime" href="#intake" data-res-go>{t.qBook} →</a><button type="button" class="link" data-again>{t.qAgain}</button></div>
            </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <div class="wrap">
          <p class="lab rv">{t.howLab}</p>
          <h2 class="h2 rv">{t.howH}</h2>
          <ol class="how">{t.how.map(([h, p], i) => <li class="rv"><span>0{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}</ol>
        </div>
      </section>

      <section class="sec sec--res" id="resultaten">
        <div class="wrap">
          <p class="lab rv">{t.rLab}</p>
          <h2 class="h2 rv">{t.rH}</h2>
          <div class="res">
            {t.results.map(([f, b, s, q, w]) => (
              <article class="res__i rv">
                <img src={img(f)} alt="" loading="lazy" />
                <div class="res__t"><b>{b}</b><span>{s}</span><p>{q}</p><cite>{w}</cite></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="coach">
        <img src={img('daan.webp')} alt={t.coachH} loading="lazy" />
        <div class="coach__t">
          <p class="lab">{t.coachLab}</p>
          <h2 class="h2">{t.coachH}</h2>
          {t.coachP.map((p) => <p class="coach__p">{p}</p>)}
        </div>
      </section>

      <section class="sec" id="faq">
        <div class="wrap faqw">
          <div><p class="lab rv">{t.fLab}</p><h2 class="h2 rv">{t.fH}</h2></div>
          <div class="faq">{t.faq.map(([q, a]) => <details class="rv"><summary>{q}</summary><p>{a}</p></details>)}</div>
        </div>
      </section>

      <section class="sec sec--lime" id="intake">
        <div class="wrap intake">
          <div>
            <p class="lab">{t.iLab}</p>
            <h2 class="h2">{t.iH}</h2>
            <p class="lede">{t.iP}</p>
            <p class="intake__tel">☎ <a href={`tel:${tel}`}>043 000 00 00</a></p>
          </div>
          <form class="form" data-form novalidate>
            <label class="f"><span>{t.iName}</span><input name="name" autocomplete="name" required /></label>
            <label class="f"><span>{t.iPhone}</span><input name="phone" type="tel" autocomplete="tel" required /></label>
            <label class="f"><span>{t.iGoal}</span><select name="goal">{t.qs[0][1].map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
            <fieldset class="f"><span>{t.iWhen}</span><div class="pills">{t.when.map((w, i) => <label><input type="radio" name="when" value={w} checked={i === 1} /><span>{w}</span></label>)}</div></fieldset>
            <button class="btn btn--dark" type="submit">{t.iSend} →</button>
            <div class="done" data-done hidden><h3>{t.doneH}</h3><p>{t.doneP}</p></div>
          </form>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap ft__in">
        <p class="ft__logo">KERN<span>●</span></p>
        <p>Randwyck · 6229 Maastricht · KvK 00000000</p>
        <p>{t.demo} <a href={`${base}/`}>{t.credit}</a></p>
      </div>
    </footer>
    <a class="mbar" href="#intake">{t.cta} →</a>
    <DemoLang lang={lang} links={[['nl', root('nl')], ['en', root('en')], ['pl', root('pl')]]} />
    <script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
  </body>
</html>

<style is:global>
  :root { --bg: #ebe9e4; --ink: #0d0d0d; --mut: #5f5d58; --lime: #c6f432; --line: rgba(13, 13, 13, 0.14); --ff: 'Archivo', system-ui, sans-serif; }
