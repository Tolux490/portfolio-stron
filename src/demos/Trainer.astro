      naast: ['1-op-1 personal training', 'Je traint naast een coach die elke herhaling ziet. Ideaal om veilig en snel resultaat te boeken.'],
      samen: ['Duo training', 'Samen trainen houdt je allebei gemotiveerd, en het scheelt per persoon flink in prijs.'],
      online: ['Online coaching', 'Je traint zelf, maar nooit zonder plan. Wekelijks kijken we samen naar je cijfers en techniek.'],
    },
    goalLine: { afvallen: 'met focus op vetverlies en energie', sterk: 'met focus op kracht en techniek', blessure: 'rustig opgebouwd, in overleg met je fysio', sport: 'gericht op jouw sport en seizoen' },
    freq: { '1': '1 sessie per week, plus een thuisschema', '2': '2 sessies per week', '3': '2 sessies per week, plus een eigen training' },
    howLab: 'Werkwijze', howH: 'Zo bouwen we het op',
    how: [['Intake', 'Gratis gesprek van 30 minuten: doelen, blessures, agenda.'], ['Meting', 'Kracht, mobiliteit en lichaamssamenstelling als startpunt.'], ['Plan', 'Training en voeding op maat, in de app op je telefoon.'], ['Elke 4 weken', 'Opnieuw meten en bijsturen. Je ziet zwart op wit wat werkt.']],
    rLab: 'Resultaten', rH: 'Echte vooruitgang, gemeten',
    results: [['squat.webp', '−9 kg', 'in 14 weken', '“Na mijn zwangerschap wist ik niet waar te beginnen. Nu ben ik sterker dan ervoor.”', 'Eva, 34'], ['deadlift.webp', '60 → 120 kg', 'deadlift in 6 maanden', '“Ik dacht dat ik niet sterk kon worden. Daan liet me zien dat het techniek is, geen talent.”', 'Mark, 41'], ['core.webp', '0 dagen', 'rugpijn sinds maart', '“Na een hernia trainde ik bang. Nu train ik weer met plezier, pijnvrij.”', 'Sophie, 29']],
    coachLab: 'Je coach', coachH: 'Daan, personal trainer',
    coachP: ['Ik train al tien jaar mensen die zeggen dat ze “niet sportief” zijn. Mijn favoriete moment: als iemand na acht weken zonder twijfel een oefening doet die eerst eng voelde.', 'Gecertificeerd personal trainer (EREPS niveau 5) en leefstijlcoach. Ik werk samen met fysiotherapeuten in Maastricht.'],
    fLab: 'FAQ', fH: 'Vaak gevraagd',
    faq: [['Ik ben echt een beginner. Is dat erg?', 'Juist niet. De meeste klanten beginnen zonder ervaring. We starten op jouw niveau en bouwen rustig op.'], ['Waar train ik?', 'In onze privéstudio in Maastricht-Randwyck, met gratis parkeren. Thuis trainen kan ook, met een kleine toeslag.'], ['Hoe snel zie ik resultaat?', 'Na 4 weken meet je het verschil, na 8 tot 12 weken zie je het. Daarom meten we elke 4 weken.'], ['Kan ik tussentijds stoppen?', 'Ja. Strippenkaarten zijn een jaar geldig en online coaching is maandelijks opzegbaar.']],
    iLab: 'Gratis intake', iH: 'Plan je kennismaking',
    iP: '30 minuten, vrijblijvend. Je hoort binnen een dag van me.',
    iName: 'Naam', iPhone: 'Telefoon', iGoal: 'Doel', iWhen: 'Wanneer schikt het?', when: ['Doordeweeks overdag', 'Doordeweeks ’s avonds', 'Zaterdag'], iSend: 'Intake aanvragen',
    doneH: 'Top, ik neem snel contact op!', doneP: 'Demoversie: er is niets verstuurd. In de echte site krijgt de trainer je aanvraag direct binnen.',
