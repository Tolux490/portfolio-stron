      { n: 'Duo', p: '€40', u: 'per person', d: 'Train with a partner or friend, same attention.', f: ['Intake for both', 'A plan for the two of you', 'Fun and effective'], bundle: '10-session card: €360 pp' },
      { n: 'Online', p: '€89', u: 'per month', d: 'Train on your own with a plan and weekly check-ins.', f: ['Plan in the app', 'Weekly check-in', 'Video feedback on technique'], bundle: 'Cancel monthly' },
    ],
    qLab: 'Which programme fits me?', qH: 'Three questions, one answer',
    qs: [
