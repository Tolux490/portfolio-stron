      ['Original parts or equivalents?', 'It’s your choice. We advise honestly: where an original (OEM) part is worth paying for, and where a good equivalent does the same job for less.'],
      ['Is the work guaranteed?', 'Yes. 24 months on labour plus the manufacturer’s warranty on parts. You receive the invoice and the repair report by email.'],
      ['Is there a courtesy car?', 'For bigger repairs we can provide a courtesy car by arrangement. Just ask when you book.'],
      ['How can I pay?', 'Cash, card, BLIK or bank transfer. Companies can get an invoice with deferred payment.'],
    ],
    ctaKicker: 'Ready?', ctaH: 'Book a visit and stop worrying about it', ctaP: 'Drop in when it suits you. A quote up front, a 24-month warranty and your car ready on time.',
    footService: 'Workshop', footMenu: 'Menu', footLinks: ['Services', 'Prices', 'Book a visit'],
    credit: 'Built by Vervo Studio ↗', privacy: 'Privacy policy',
    lbLabel: 'Enlarged photo', close: 'Close', prev: 'Previous', next: 'Next',
    js: {
      open: 'Open now', until: ' · today until ', closed: 'Closed now · book online any time', mapTitle: 'Map to OKTAN, Warsaw',
      fill: 'Please fill in this field', badPhone: 'Enter a valid number', consent: 'Please tick the data processing consent.', fields: 'Please complete the highlighted fields.',
      demo: 'Thank you! (demo mode: the request was not sent anywhere). Add a web3forms key to the business data to enable real sending.',
      sending: 'Sending…', ok: 'Thank you! Your request arrived. We’ll call you back to confirm the slot.', fail: 'Could not send. Call {phone} or email {mail}.',
      submit: 'Request a slot', subject: 'Visit',
    },
  },
};
const t = T[lang];
const nav = ['#uslugi', '#cennik', '#proces', `${root}/o-nas/`, '#galeria', '#opinie', '#kontakt'].map((href, i) => ({ href, label: t.nav[i] }));
const uslugi = t.uslugi.map(([tt, o], i) => ({ i: ICONS[i], t: tt, o }));
const cennikA = t.cennikA.map(([n, d], i) => ({ n, d, v: PRICES_A[i] }));
const cennikB = t.cennikB.map(([n, d], i) => ({ n, d, v: PRICES_B[i], flat: i === 5 }));
const galeria = GALLERY.map((s, i) => ({ s, a: t.galeria[i], big: i === 0 }));
const opinie = t.opinie.map(([k, tx], i) => ({ a: NAMES[i], g: STARS[i], k, t: tx }));
const uslugiForm = uslugi.map((u) => u.t).concat([t.other]);
const godziny = ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00'];
const star = 'M8 1.3l1.9 3.8 4.2.6-3 3 .7 4.2L8 12l-3.7 1.9.7-4.2-3-3 4.2-.6z';

const schema = {
  '@context': 'https://schema.org', '@type': 'AutoRepair', name: biz.name, telephone: biz.phone, email: biz.email,
  priceRange: biz.priceRange, url: Astro.url.origin + root + '/',
  image: new URL(img('warsztat-hero.webp'), Astro.url).href,
  address: { '@type': 'PostalAddress', streetAddress: biz.street, addressLocality: biz.city, postalCode: biz.zip, addressCountry: 'PL' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: biz.googleRating, reviewCount: biz.googleCount, bestRating: 5 },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="pl" href={new URL(`${plRoot}/`, Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(`${plRoot}/en/`, Astro.url).href} />
    <meta name="theme-color" content="#0e1013" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={t.ogTitle} />
    <meta property="og:description" content={t.ogDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={en ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image" content={new URL('/og/oktan.png', Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Curtain />
    <!-- ===================== NAGŁÓWEK ===================== -->
    <header class="top" id="top">
      <div class="wrap top__in">
        <a class="logo" href="#gora" aria-label={t.logoTop}>
          <span class="logo__dot"></span>
          <span>OKTAN<small>{t.logoSub}</small></span>
        </a>
        <nav class="nav" aria-label={t.navLabel}>
          {nav.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <div class="top__cta">
          <a class="top__tel" href={`tel:${tel}`}>{biz.phone}</a>
          <a class="btn btn--red" href="#umow">{t.book}</a>
        </div>
        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer"><span></span></button>
      </div>
    </header>

    <div class="drawer" id="drawer">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#umow">{t.book}</a>
      <div class="drawer__foot">
        <a href={`tel:${tel}`}>{biz.phone}</a>
        <span>{biz.street}, {biz.city}</span>
        <span>{t.hoursShort}</span>
      </div>
    </div>

    <main id="gora">
      <!-- ===================== HERO ===================== -->
      <section class="hero">
        <div class="hero__media">
          <Foto src="warsztat-hero.webp" alt={t.heroAlt} ratio="16/9" label="Hala serwisu" eager={true} />
        </div>
        <div class="wrap hero__in">
          <p class="hero__tag">{t.heroTag}</p>
          <h1>{t.h1} <span class="mark">{t.h1mark}</span></h1>
          <p class="hero__lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--red" href="#umow">{t.book}</a>
            <a class="btn btn--ghost" href={`tel:${tel}`}>{t.call}: {biz.phone}</a>
          </div>
          <div class="hero__chips">
            <span class="hero__chip"><b>{t.rating}<span class="mark">★</span></b> {t.chips[0]}</span>
            <span class="hero__chip"><b>18</b> {t.chips[1]}</span>
            <span class="hero__chip"><b>24</b> {t.chips[2]}</span>
          </div>
          <p class="hero__status" id="status" aria-live="polite"></p>
        </div>
      </section>

      <!-- ===================== PASEK ZAUFANIA ===================== -->
      <section class="trust">
        <div class="wrap trust__in">
          <div class="trust__cell"><span class="trust__num">18</span><span class="trust__lab">{t.trust[0]}</span></div>
          <div class="trust__cell"><span class="trust__num">40<span class="mark">k+</span></span><span class="trust__lab">{t.trust[1]}</span></div>
          <div class="trust__cell"><span class="trust__num">{t.rating}<span class="mark">★</span></span><span class="trust__lab">{t.trust[2]}</span></div>
          <div class="trust__cell"><span class="trust__num">24</span><span class="trust__lab">{t.trust[3]}</span></div>
        </div>
      </section>

      <!-- ===================== USŁUGI ===================== -->
      <section class="section" id="uslugi">
        <div class="wrap">
          <div class="head reveal">
            <div>
              <p class="kicker">{t.svcKicker}</p>
              <h2 class="h2">{t.svcH}</h2>
            </div>
            <a class="btn btn--ghost" href="#cennik">{t.seePrices}</a>
          </div>
          <div class="services">
            {uslugi.map((u) => (
              <article class="svc reveal">
                <span class="svc__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${ico[u.i]}"/>`}></svg></span>
                <h3>{u.t}</h3>
                <p>{u.o}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== CENNIK ===================== -->
      <section class="section section--alt" id="cennik">
        <div class="wrap">
          <div class="head reveal">
            <div>
              <p class="kicker">{t.priceKicker}</p>
              <h2 class="h2">{t.priceH}</h2>
            </div>
            <a class="btn btn--red" href="#umow">{t.priceCta}</a>
          </div>
          <div class="price-grid">
            {[cennikA, cennikB].map((col) => (
              <div class="price reveal">
                {col.map((p) => (
                  <div class="price__row">
                    <span class="price__name">{p.n}</span>
                    {p.d && <span class="price__desc">{p.d}</span>}
                    <span class="price__val">{en ? Number(p.v).toLocaleString('en-GB') : p.v}<span style="font-size:.6em">{t.cur}</span><small>{p.flat ? t.perHour : t.from}</small></span>
                  </div>
                ))}
              </div>
            ))}
          </div>
          <p class="note reveal mt-m">{t.priceNote}</p>
        </div>
      </section>

      <!-- ===================== PROCES ===================== -->
      <section class="section" id="proces">
        <div class="wrap">
          <div class="reveal" style="max-width:52ch">
            <p class="kicker">{t.procKicker}</p>
            <h2 class="h2">{t.procH}</h2>
          </div>
          <div class="steps mt-l">
            {t.proces.map(([tt, o], i) => (
              <div class="step reveal">
                <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{tt}</h3>
                <p>{o}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== DLACZEGO MY ===================== -->
      <section class="section section--alt">
        <div class="wrap split split--rev">
          <div class="reveal">
            <p class="kicker">{t.whyKicker}</p>
            <h2 class="h2">{t.whyH}</h2>
            <p class="lede">{t.whyLede}</p>
            <ul class="checks">
              {t.checks.map(([bb, ss]) => (
                <li>
                  <span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg></span>
                  <span><b>{bb}</b><span>{ss}</span></span>
                </li>
              ))}
            </ul>
          </div>
          <div class="split__media reveal">
            <Foto src="warsztat-galeria-6.webp" alt={t.mechAlt} ratio="4/3" label="Mechanik" />
            <span class="tagbox">{t.tagbox}</span>
          </div>
        </div>
      </section>

      <!-- ===================== GALERIA ===================== -->
      <section class="section" id="galeria">
        <div class="wrap">
          <div class="head reveal">
            <div>
              <p class="kicker">{t.galKicker}</p>
              <h2 class="h2">{t.galH}</h2>
            </div>
          </div>
          <div class="gallery">
            {galeria.map((g, i) => (
              <button class={`reveal${g.big ? ' big' : ''}`} type="button" data-lb={i} data-full={img(g.s)} data-alt={g.a} aria-label={`${t.zoom}: ${g.a}`}>
                <Foto src={g.s} alt={g.a} ratio={g.big ? '1/1' : '3/2'} label="Warsztat" />
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== OPINIE ===================== -->
      <section class="section section--alt" id="opinie">
        <div class="wrap">
          <div class="head reveal">
            <div>
              <p class="kicker">{t.revKicker}</p>
              <h2 class="h2">{t.revH}</h2>
            </div>
          </div>
          <div class="gsum reveal">
            <div class="gsum__score">{t.rating}</div>
            <div>
              <span class="stars" role="img" aria-label={`${t.rating} ${t.outOf}`}>
                {Array.from({ length: 5 }).map(() => <svg viewBox="0 0 16 16" aria-hidden="true"><path d={star} fill="currentColor"/></svg>)}
              </span>
              <div class="gsum__meta"><span class="glogo"><b>G</b><b>o</b><b>o</b><b>g</b><b>l</b><b>e</b></span><span>{t.reviewsN}</span></div>
            </div>
            <a class="btn btn--ghost" href={biz.googleUrl} target="_blank" rel="noopener" style="margin-left:auto">{t.seeGoogle}</a>
          </div>
          <div class="reviews">
            {opinie.map((o) => (
              <figure class="rev reveal">
                <div class="rev__top">
                  <span class="rev__ava" aria-hidden="true">{o.a.charAt(0)}</span>
                  <figcaption class="rev__who"><b>{o.a}</b><div>{o.k}</div></figcaption>
                </div>
                <span class="stars" role="img" aria-label={`${o.g} ${t.outOf}`}>
                  {Array.from({ length: 5 }).map((_, s) => <svg viewBox="0 0 16 16" class={s < o.g ? '' : 'off'} aria-hidden="true"><path d={star} fill="currentColor"/></svg>)}
                </span>
                <blockquote class="rev__t">{o.t}</blockquote>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== UMÓW WIZYTĘ ===================== -->
      <section class="section" id="umow">
        <div class="wrap">
          <div class="reveal" style="max-width:56ch">
            <p class="kicker">{t.bookKicker}</p>
            <h2 class="h2">{t.bookH}</h2>
            <p class="lede">{t.bookLede}</p>
          </div>
          <div class="book mt-l">
            <form class="reveal" id="bookForm" novalidate>
              <div class="row2">
                <label class="field"><span>{t.f.service}</span>
                  <select name="usluga" required>
                    <option value="">{t.f.choose}</option>
                    {uslugiForm.map((u) => <option value={u}>{u}</option>)}
                  </select>
                </label>
                <label class="field"><span>{t.f.car}</span>
                  <input type="text" name="auto" placeholder={t.f.carPh} required />
                </label>
              </div>
              <div class="row2">
                <label class="field"><span>{t.f.year} <em>{t.f.optional}</em></span>
                  <input type="text" name="rok" inputmode="numeric" placeholder={t.f.yearPh} />
                </label>
                <label class="field"><span>{t.f.day}</span>
                  <input type="date" name="data" required />
                </label>
              </div>
              <div class="row2">
                <label class="field"><span>{t.f.hour}</span>
                  <select name="godzina" required>
                    <option value="">{t.f.choose}</option>
                    {godziny.map((g) => <option value={g}>{g}</option>)}
                  </select>
                </label>
                <label class="field"><span>{t.f.phone}</span>
                  <input type="tel" name="telefon" autocomplete="tel" inputmode="tel" required />
                </label>
              </div>
              <label class="field"><span>{t.f.name}</span>
                <input type="text" name="imie" autocomplete="name" required />
              </label>
              <label class="field"><span>{t.f.issue} <em>{t.f.optional}</em></span>
                <textarea name="uwagi" rows="3" placeholder={t.f.issuePh}></textarea>
              </label>

              <div class="klauzula">
                <p>{t.gdpr(biz)}</p>
                <details><summary>{t.gdprMore}</summary>
                  <p>{t.gdprFull} <a href={`${root}/polityka-prywatnosci/`}>{t.privacyLow}</a>.</p>
                </details>
                <label class="consent">
                  <input type="checkbox" name="zgoda" value="tak" required />
                  <span>{t.consent}</span>
                </label>
              </div>

              <button class="btn btn--red btn--block btn--auto" type="submit" id="bookSubmit">{t.f.submit}</button>
              <p class="formstat" id="bookStat" role="status" aria-live="polite"></p>
            </form>

            <aside class="book__side reveal">
              <div>
                <h3>{t.sideCall}</h3>
                <p style="margin-top:.5rem"><a href={`tel:${tel}`} style="font-family:var(--font-display);font-weight:700;font-size:1.6rem">{biz.phone}</a></p>
                <p style="color:var(--muted);font-size:.85rem;margin-top:.3rem">{t.sideCallNote}</p>
              </div>
              <div>
                <h3>{t.hours}</h3>
                {biz.hours.map((h) => <p style="margin-top:.25rem">{h}</p>)}
              </div>
              <div>
                <h3>{t.good}</h3>
                <p style="color:var(--muted);font-size:.88rem">{t.good1}</p>
                <p style="color:var(--muted);font-size:.88rem">{t.good2}</p>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- ===================== KONTAKT + MAPA ===================== -->
      <section class="section section--alt" id="kontakt">
        <div class="wrap contact">
          <div class="reveal">
            <p class="kicker">{t.contactKicker}</p>
            <h2 class="h2">{biz.street}<br />{biz.zip} {biz.city}</h2>
            <p class="lede">{t.contactLede}</p>
            <div class="contact__links">
              <a href={`tel:${tel}`}>{biz.phone}</a>
              <a href={`mailto:${biz.email}`}>{biz.email}</a>
              <a href={biz.mapUrl} target="_blank" rel="noopener">{t.openMaps}</a>
            </div>
            <div class="hours">
              {t.week.map(([d, h]) => <div><span>{d}</span><span>{h}</span></div>)}
            </div>
          </div>
          <div class="reveal">
            <div class="mapbox" data-src={mapSrc}>
              <div class="mapbox__ph">
                <p>{t.mapNote[0]}<br />{t.mapNote[1]}</p>
                <button class="btn btn--red map-load" type="button">{t.showMap}</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== FAQ ===================== -->
      <section class="section">
        <div class="wrap" style="max-width:820px">
          <div class="reveal">
            <p class="kicker">FAQ</p>
            <h2 class="h2">{t.faqH}</h2>
          </div>
          <div class="faq reveal mt-m">
            {t.faq.map(([q, a]) => (
              <details><summary>{q}</summary><p>{a}</p></details>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== CTA ===================== -->
      <section class="section band">
        <div class="wrap">
          <p class="kicker kicker--center">{t.ctaKicker}</p>
          <h2>{t.ctaH}</h2>
          <p>{t.ctaP}</p>
          <div class="band__cta">
            <a class="btn btn--light" href="#umow">{t.book}</a>
            <a class="btn btn--outline-light" href={`tel:${tel}`}>{t.call}: {biz.phone}</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ===================== STOPKA ===================== -->
    <footer class="foot">
      <div class="wrap">
        <div class="foot__grid">
          <div>
            <span class="logo"><span class="logo__dot"></span><span>OKTAN<small>{t.logoSub}</small></span></span>
            <p class="foot__tag">{biz.tagline}</p>
          </div>
          <div>
            <h4>{t.footService}</h4>
            <ul>
              <li>{biz.street}</li>
              <li>{biz.zip} {biz.city}</li>
              <li><a href={`tel:${tel}`}>{biz.phone}</a></li>
              <li><a href={`mailto:${biz.email}`}>{biz.email}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.hours}</h4>
            <ul>{biz.hours.map((h) => <li>{h}</li>)}</ul>
            <h4 style="margin-top:1.5rem">{t.footMenu}</h4>
            <ul>
              <li><a href="#uslugi">{t.footLinks[0]}</a></li>
              <li><a href="#cennik">{t.footLinks[1]}</a></li>
              <li><a href="#umow">{t.footLinks[2]}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot__legal">
          <span>{biz.legalName} · NIP {biz.nip} · {biz.street}, {biz.zip} {biz.city}</span>
          <span><a href={`${base}/${en ? '' : 'pl/'}`}>{t.credit}</a> &nbsp;·&nbsp; <a href={`${root}/polityka-prywatnosci/`}>{t.privacy}</a></span>
        </div>
      </div>
    </footer>

    <div class="callbar">
      <a href="#umow">{t.book}</a>
      <a href={`tel:${tel}`}>{t.call}</a>
    </div>

    <!-- lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={t.lbLabel}>
      <button class="lightbox__x" id="lbX" aria-label={t.close}>✕</button>
      <button class="lightbox__nav prev" id="lbPrev" aria-label={t.prev}>‹</button>
      <img id="lbImg" src="" alt="" />
      <button class="lightbox__nav next" id="lbNext" aria-label={t.next}>›</button>
    </div>

    <DemoLang lang={lang} pl={`${plRoot}/`} en={`${plRoot}/en/`} />

    <script define:vars={{ formKey: biz.formKey, mail: biz.email, nazwa: biz.name, phone: biz.phone, L: t.js }}>
      // sticky header
      const top = document.getElementById('top');
      const onScroll = () => top?.classList.toggle('stuck', window.scrollY > 30);
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

      // mobilne menu
      const burger = document.getElementById('burger');
      const setMenu = (open) => {
        const o = open ?? !document.body.classList.contains('nav-open');
        document.body.classList.toggle('nav-open', o);
        burger?.setAttribute('aria-expanded', String(o));
      };
      burger?.addEventListener('click', () => setMenu());
      document.querySelectorAll('#drawer a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      // reveal
      const obs = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); } }), { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach((el, i) => { el.style.transitionDelay = (Math.min(i % 3, 2) * 70) + 'ms'; obs.observe(el); });

      // status otwarcia (pon-pt 8-18, sob 8-14)
      const st = document.getElementById('status');
      if (st) {
        const d = new Date(); const day = d.getDay(); const min = d.getHours() * 60 + d.getMinutes();
        let open = false, close = 0;
        if (day >= 1 && day <= 5) { open = min >= 480 && min < 1080; close = 1080; }
        else if (day === 6) { open = min >= 480 && min < 840; close = 840; }
        const fmt = (m) => Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0');
        st.innerHTML = open
          ? '<span class="dot dot--on"></span><b>' + L.open + '</b>' + L.until + fmt(close)
          : '<span class="dot dot--off"></span>' + L.closed;
      }

      // mapa
      document.querySelectorAll('.map-load').forEach((b) => b.addEventListener('click', () => {
        const box = b.closest('.mapbox'); if (!box) return;
        const f = document.createElement('iframe');
        f.src = box.getAttribute('data-src'); f.loading = 'lazy'; f.title = L.mapTitle;
        f.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
        box.appendChild(f); box.querySelector('.mapbox__ph')?.remove();
      }));

      // galeria / lightbox
      const btns = Array.from(document.querySelectorAll('[data-lb]'));
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lbImg');
      let idx = 0;
      const show = (i) => { idx = (i + btns.length) % btns.length; const b = btns[idx]; lbImg.src = b.dataset.full; lbImg.alt = b.dataset.alt; };
      const openLb = (i) => { show(i); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
      const closeLb = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
      btns.forEach((b, i) => b.addEventListener('click', () => openLb(i)));
      document.getElementById('lbX')?.addEventListener('click', closeLb);
      document.getElementById('lbPrev')?.addEventListener('click', () => show(idx - 1));
      document.getElementById('lbNext')?.addEventListener('click', () => show(idx + 1));
      lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
      window.addEventListener('keydown', (e) => { if (!lb.classList.contains('open')) return; if (e.key === 'Escape') closeLb(); if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });

      // formularz
      const form = document.getElementById('bookForm');
      const stat = document.getElementById('bookStat');
      const submit = document.getElementById('bookSubmit');
      const err = (pole, txt) => { const f = pole.closest('.field'); f?.classList.add('err'); if (!f?.querySelector('.msg')) { const s = document.createElement('span'); s.className = 'msg'; s.textContent = txt; f?.appendChild(s); } };
      const clear = () => { form.querySelectorAll('.field.err').forEach((f) => f.classList.remove('err')); form.querySelectorAll('.msg').forEach((m) => m.remove()); };
      form?.addEventListener('submit', async (e) => {
        e.preventDefault(); clear(); stat.textContent = ''; stat.className = 'formstat';
        let ok = true;
        form.querySelectorAll('[required]').forEach((p) => {
          if (p.type === 'checkbox') { if (!p.checked) ok = false; return; }
          if (!p.value.trim()) { err(p, L.fill); ok = false; }
        });
        const t = form.querySelector('[name="telefon"]');
        if (t?.value && t.value.replace(/[^\d]/g, '').length < 9) { err(t, L.badPhone); ok = false; }
        const zg = form.querySelector('[name="zgoda"]');
        if (zg && !zg.checked) { stat.textContent = L.consent; stat.classList.add('bad'); }
        if (!ok) { if (!stat.textContent) { stat.textContent = L.fields; stat.classList.add('bad'); } form.querySelector('.field.err input, .field.err select')?.focus(); return; }

        const dane = Object.fromEntries(new FormData(form).entries());
        if (!formKey) {
          submit.disabled = true;
          stat.textContent = L.demo;
          stat.classList.add('ok'); form.reset(); setTimeout(() => { submit.disabled = false; }, 400); return;
        }
        try {
          submit.disabled = true; submit.textContent = L.sending;
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ access_key: formKey, subject: `${L.subject} ${nazwa}: ${dane.usluga} — ${dane.auto} (${dane.data} ${dane.godzina})`, from_name: dane.imie, ...dane }),
          });
          const r = await res.json();
          if (r.success) { stat.textContent = L.ok; stat.classList.add('ok'); form.reset(); }
          else throw new Error(r.message || 'error');
        } catch (e2) {
          stat.textContent = L.fail.replace('{phone}', phone).replace('{mail}', mail); stat.classList.add('bad');
        } finally { submit.disabled = false; submit.textContent = L.submit; }
      });
    </script>
  </body>
</html>
