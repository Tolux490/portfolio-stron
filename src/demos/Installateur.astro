<script>
  import { $, $$, readCfg, reveal, openStatus, demoForm } from '../scripts/demo-kit.js';
  const cfg = readCfg();
  reveal();
  openStatus($('[data-status]'), { hours: cfg.hours, t: cfg.t, lang: cfg.lang });

  // wybór problemu
  const tool = $('[data-tool]');
  const pick = (k) => {
    $$('[data-prob]', tool).forEach((b) => b.setAttribute('aria-checked', String(b.dataset.prob === k)));
    $$('[data-panel]', tool).forEach((p) => (p.hidden = p.dataset.panel !== k));
  };
  $$('[data-prob]', tool).forEach((b) => b.addEventListener('click', () => pick(b.dataset.prob)));
  // strzałki w grupie radio
  tool.querySelector('[role=radiogroup]').addEventListener('keydown', (e) => {
    if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(e.key)) return;
    e.preventDefault();
    const list = $$('[data-prob]', tool);
    const i = list.findIndex((b) => b.getAttribute('aria-checked') === 'true');
    const n = list[(i + (e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length];
    pick(n.dataset.prob); n.focus();
  });

  // „Vraag dit aan” → formularz z wybranym problemem
  const form = $('[data-form]');
  $$('[data-ask]').forEach((a) => a.addEventListener('click', () => {
    const p = $('[data-pick]');
    p.textContent = `${cfg.t.picked}: ${cfg.probs[a.dataset.ask]}`;
    p.hidden = false;
    form.elements.what.dataset.prob = a.dataset.ask;
  }));

  // postcode: Parkstad i okolice (6350–6469)
  const zipForm = $('[data-zip]'), out = $('[data-zip-out]');
  zipForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const m = zipForm.zip.value.match(/\d{4}/);
    out.className = 'zip__out';
    if (!m) { out.textContent = cfg.t.zipBad; return; }
    const n = +m[0];
    if (n >= 6350 && n <= 6469) {
      const min = 25 + (Math.abs(n - 6411) % 7) * 4;
      out.textContent = cfg.t.zipYes.replace('{min}', String(min));
      out.classList.add('is-yes');
    } else { out.textContent = cfg.t.zipNo; out.classList.add('is-no'); }
  });

  demoForm(form);
</script>
