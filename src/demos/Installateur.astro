const cfg = { lang, hours: HOURS, probs: Object.fromEntries(PROBLEMS.map((k) => [k, t.probs[k][0]])), t: { openNow: t.openNow, closedNow: t.closedNow, until: t.until, opensAt: t.opensAt, days: t.days, zipYes: t.zipYes, zipNo: t.zipNo, zipBad: t.zipBad, picked: t.picked } };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0f1f2e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;500;600;700;800&family=Overpass+Mono:wght@500;600&display=swap" />
  </head>
  <body>
    <Curtain />
    <div class="bar"><span><i></i>{t.bar}</span><a href={`tel:${tel}`}>{t.barCall}</a></div>
    <header class="hd" id="hd">
      <a class="hd__logo" href="#top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c3.9 5 6.5 8.6 6.5 11.8a6.5 6.5 0 0 1-13 0C5.5 11.1 8.1 7.5 12 2.5z" /></svg>Bron<small>installatietechniek</small></a>
      <nav class="hd__nav">{['#storing', '#diensten', '#badkamers', '#werkgebied'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}</nav>
      <a class="btn btn--blue hd__cta" href="#afspraak">{t.plan}</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero__txt">
          <h1>{t.h1}</h1>
          <p class="lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--orange" href={`tel:${tel}`}>☎ {t.call}</a>
            <a class="btn btn--line" href="#storing">{t.pH}</a>
          </div>
