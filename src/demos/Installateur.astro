const tel = '+31450000000';
const telShow = '045 000 00 00';
// kantoor: ma–vr 7:30–17:00 (minuty od północy), storingsdienst 24/7
const HOURS = [[450, 1020], [450, 1020], [450, 1020], [450, 1020], [450, 1020], null, null];
