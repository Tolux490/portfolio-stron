---
// Ogrodowa 3 — strona główna (PL: /restauracja/, EN: /restauracja/en/).
import Restauracja from '../../layouts/Restauracja.astro';
import Foto from '../../components/Foto.astro';
import Bottle3D from '../../components/rest/Bottle3D.astro';
import GoogleReviews from '../../components/rest/GoogleReviews.astro';
import MapaRest from '../../components/rest/MapaRest.astro';
import { restauracja as bizPl, inLang } from '../../data/firmy.js';
import * as PL from '../../data/restauracja.js';
import * as EN from '../../data/restauracja-en.js';

const { lang = 'pl' } = Astro.props;
const en = lang === 'en';
const biz = inLang(bizPl, lang);
const { menu, wydarzenia, galeria } = en ? EN : PL;
const tel = biz.phone.replace(/[^+\d]/g, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/restauracja${en ? '/en' : ''}`;

const wybor = [menu[0], menu[2]]; // Na początek + Dania główne
const paskoweFoto = galeria.slice(0, 8);
const ocena = en ? String(biz.googleRating) : biz.googleRating.toString().replace('.', ',');

const t = en ? {
  title: 'Ogrodowa 3 · Seasonal cooking and natural wines, Wołomin',
  desc: 'An intimate restaurant in Wołomin, near Warsaw. A seasonal menu, natural wines and tasting dinners. Book a candlelit table for the evening.',
  heroAlt: 'The Ogrodowa 3 dining room in the evening, candles and fireplace',
  kicker: 'Seasonal cooking · Natural wines · Wołomin',
  h1: ['An evening, candlelight', 'and wine you remember'],
  lede: 'We cook with produce from within forty kilometres and write the menu with the seasons. Just over a dozen tables and one evening to really slow down.',
  book: 'Book a table', seeMenu: 'See the menu', scroll: 'scroll',
  introP: 'A place where dinner lasts the whole evening, not fifteen minutes',
  introLede: 'We run a small restaurant on Ogrodowa Street. No rush and no loud music. Wood, candles, a glass of good wine and a plate with a real supplier behind it.',
  pickKicker: 'From the menu', pickH2: 'What is worth coming for', fullMenu: 'Full menu →',
  signature: 'Signature', veg: 'Veg',
  pickNote: 'Prices in PLN. We can prepare a vegetarian version of most dishes if you mention it when booking.',
  chefAlt: 'The Ogrodowa 3 head chef at the pass', chefCap: 'The pass, 19:00',
  kitchenKicker: 'Kitchen', kitchenH2: ['Suppliers from within', 'forty kilometres'],
  kitchenLede: 'Vegetables from a farm in Kobyłka, bread from the bakery on Legionów Street, fish twice a week. If a supplier does not have something, it is not on the menu that day.',
  facts: ['seats in the dining room', 'km · delivery radius', 'menus a year'],
  meetKitchen: 'Meet the kitchen →',
  wineKicker: 'Wine cellar', wineH2: ['Natural wines', 'from small vineyards'],
  wineLede: 'Our sommelier runs the wine list: Poland, Moravia, Burgenland, Georgia. A glass from PLN 26, with advice and no pretension. There is a match for every dish.',
  wineList: 'Wine list →', wineAlt: 'Glasses of natural wine in the dining room',
  evKicker: 'Evenings', evH2: 'Reasons to stay longer', allEv: 'All evenings →',
  stripKicker: 'Dining room and plates', stripH2: 'Take a look inside', prev: 'Previous', next: 'Next', allGallery: 'Full gallery →',
  revKicker: 'Guest reviews', revH2: `Rated ${ocena} on Google`, moreRev: 'More reviews →',
  rezKicker: 'Reservations', rezH2: ['Book a table', 'for the evening'],
  rezLede: 'With just over a dozen tables, calling is quickest. We answer from 15:00. Groups of more than eight and private evenings are arranged by email.',
  hours: 'Opening hours', address: 'Address', formLink: 'Booking form →',
  s: { open: 'Open', last: 'last orders at', lastOrders: 'Last orders', ends: 'kitchen closes at', later: 'Opening today at', done: 'The kitchen is closed for today', closed: 'Closed today · we cook Wednesday to Sunday' },
} : {
  title: 'Ogrodowa 3 · Kuchnia sezonowa i wina naturalne, Wołomin',
  desc: 'Kameralna restauracja w Wołominie. Karta sezonowa, wina naturalne, kolacje degustacyjne. Rezerwuj stolik wieczorem przy świecach.',
  heroAlt: 'Sala restauracji Ogrodowa 3 wieczorem, świece i kominek',
  kicker: 'Kuchnia sezonowa · Wina naturalne · Wołomin',
  h1: ['Wieczór, świece', 'i wino, które pamiętasz'],
  lede: 'Gotujemy z produktów z promienia czterdziestu kilometrów, a kartę piszemy wraz z sezonem. Kilkanaście stolików i jeden wieczór, żeby naprawdę zwolnić.',
  book: 'Rezerwuj stolik', seeMenu: 'Zobacz kartę', scroll: 'przewiń',
  introP: 'Miejsce, w którym kolacja trwa cały wieczór, a nie kwadrans',
  introLede: 'Prowadzimy małą restaurację przy Ogrodowej. Bez pośpiechu i bez głośnej muzyki. Drewno, świece, kieliszek dobrego wina i talerz, za którym stoi konkretny dostawca.',
  pickKicker: 'Wybór z karty', pickH2: 'To, po co warto przyjść', fullMenu: 'Pełna karta →',
  signature: 'Sygnatura', veg: 'Wege',
  pickNote: 'Ceny w złotych. Wersję wegetariańską większości dań przygotujemy, jeśli wspomnisz o tym przy rezerwacji.',
  chefAlt: 'Szef kuchni Ogrodowej 3 przy wydawce', chefCap: 'Wydawka, godzina 19:00',
  kitchenKicker: 'Kuchnia', kitchenH2: ['Dostawcy z promienia', 'czterdziestu kilometrów'],
  kitchenLede: 'Warzywa z gospodarstwa w Kobyłce, pieczywo z piekarni na Legionów, ryby dwa razy w tygodniu. Kiedy czegoś nie ma u dostawcy, tego dnia nie ma tego w karcie.',
  facts: ['miejsca na sali', 'km · promień dostaw', 'karty w roku'],
  meetKitchen: 'Poznaj kuchnię →',
  wineKicker: 'Piwniczka', wineH2: ['Wina naturalne', 'z małych winnic'],
  wineLede: 'Kartę win prowadzi nasza sommelierka: Polska, Morawy, Burgenland, Gruzja. Kieliszek od 26 zł, doradzamy bez zadęcia. Do każdego dania znajdzie się para.',
  wineList: 'Karta win →', wineAlt: 'Kieliszki wina naturalnego na sali',
  evKicker: 'Wieczory', evH2: 'Powody, żeby zostać dłużej', allEv: 'Wszystkie wieczory →',
  stripKicker: 'Sala i talerze', stripH2: 'Zajrzyj do środka', prev: 'Poprzednie', next: 'Następne', allGallery: 'Cała galeria →',
  revKicker: 'Opinie gości', revH2: `Ocena ${ocena} na Google`, moreRev: 'Więcej opinii →',
  rezKicker: 'Rezerwacja', rezH2: ['Zarezerwuj stolik', 'na wieczór'],
  rezLede: 'Przy kilkunastu stolikach najszybszy jest telefon. Odbieramy od 15:00. Grupy powyżej ośmiu osób i wieczory na wyłączność ustalamy mailowo.',
  hours: 'Godziny', address: 'Adres', formLink: 'Formularz rezerwacji →',
  s: { open: 'Otwarte', last: 'ostatnie zamówienia o', lastOrders: 'Ostatnie zamówienia', ends: 'kuchnia kończy o', later: 'Dziś otwieramy o', done: 'Kuchnia na dziś zamknięta', closed: 'Dziś zamknięte · gotujemy od środy do niedzieli' },
};
---
<Restauracja title={t.title} description={t.desc} current="home" lang={lang} path="">

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero__bg">
      <Foto src="restauracja/hero-sala.webp" alt={t.heroAlt} ratio="16/9" label="Sala wieczorem" eager={true} />
    </div>
    <div class="hero__veil"></div>
    <Bottle3D />
    <div class="wrap hero__in">
      <p class="hero__kicker">{t.kicker}</p>
      <h1>{t.h1[0]}<br /><em>{t.h1[1]}</em></h1>
      <p class="hero__lede">{t.lede}</p>
      <div class="hero__cta">
        <a class="btn btn--gold" href={`${root}/rezerwacja/`}>{t.book}</a>
        <a class="btn btn--outline" href={`${root}/menu/`}>{t.seeMenu}</a>
      </div>
      <p class="hero__status" id="status" aria-live="polite" data-s={JSON.stringify(t.s)}></p>
    </div>
    <span class="hero__scroll">{t.scroll}</span>
  </section>

  <!-- ===================== INTRO / FILOZOFIA ===================== -->
  <section class="band band--tight">
    <div class="wrap--w center reveal">
      <p class="eyebrow eyebrow--center">Ogrodowa 3</p>
      <p class="h3" style="font-family:var(--serif);line-height:1.3;max-width:22ch;margin-inline:auto">{t.introP}</p>
      <p class="lede" style="margin-inline:auto;text-align:center">{t.introLede}</p>
    </div>
  </section>

  <!-- ===================== WYBÓR Z KARTY ===================== -->
  <section class="band band--krem">
    <div class="wrap">
      <div class="menu-head reveal">
        <div>
          <p class="eyebrow">{t.pickKicker}</p>
          <h2 class="h2">{t.pickH2}</h2>
        </div>
        <a class="btn btn--outline" href={`${root}/menu/`}>{t.fullMenu}</a>
      </div>

      {wybor.map((g) => (
        <div class="course reveal">
          <div class="course__top">
            <span class="course__name">{g.grupa}</span>
          </div>
          <ul class="dish">
            {g.dania.slice(0, 4).map((d) => (
              <li>
                <div class="dish__main">
                  <span class="dish__n">{d.n}{d.tag === 'sygnatura' && <span class="tag">{t.signature}</span>}{d.tag === 'wege' && <span class="tag tag--wege">{t.veg}</span>}</span>
                  <span class="dish__o">{d.o}</span>
                </div>
                <span class="dish__leader" aria-hidden="true"></span>
                <span class="dish__c">{d.c}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="mono-note reveal">{t.pickNote}</p>
    </div>
  </section>

  <!-- ===================== KUCHNIA / DOSTAWCY ===================== -->
  <section class="band">
    <div class="wrap split split--wide-r">
      <div class="split__media figure reveal">
        <Foto src="restauracja/szef-kuchni.webp" alt={t.chefAlt} ratio="3/2" label="Szef kuchni" />
        <span class="figure__cap">{t.chefCap}</span>
      </div>
      <div class="reveal">
        <p class="eyebrow">{t.kitchenKicker}</p>
        <h2 class="h2">{t.kitchenH2[0]}<br />{t.kitchenH2[1]}</h2>
        <p class="lede">{t.kitchenLede}</p>
        <dl class="facts">
          <div><dt>34</dt><dd>{t.facts[0]}</dd></div>
          <div><dt>40</dt><dd>{t.facts[1]}</dd></div>
          <div><dt>52</dt><dd>{t.facts[2]}</dd></div>
        </dl>
        <a class="btn btn--outline mt-l" href={`${root}/o-nas/`}>{t.meetKitchen}</a>
      </div>
    </div>
  </section>

  <!-- ===================== WINO ===================== -->
  <section class="band band--zielen">
    <div class="wrap split split--wide-l">
      <div class="reveal">
        <p class="eyebrow">{t.wineKicker}</p>
        <h2 class="h2">{t.wineH2[0]}<br />{t.wineH2[1]}</h2>
        <p class="lede">{t.wineLede}</p>
        <a class="btn btn--outline mt-m" href={`${root}/wina/`}>{t.wineList}</a>
      </div>
      <div class="split__media figure reveal">
        <Foto src="restauracja/wino-kieliszki.webp" alt={t.wineAlt} ratio="4/5" label="Wino" />
      </div>
    </div>
  </section>

  <!-- ===================== WIECZORY ===================== -->
  <section class="band">
    <div class="wrap">
      <div class="menu-head reveal">
        <div>
          <p class="eyebrow">{t.evKicker}</p>
          <h2 class="h2">{t.evH2}</h2>
        </div>
        <a class="btn btn--outline" href={`${root}/wydarzenia/`}>{t.allEv}</a>
      </div>
      <div class="cards cards--3">
        {wydarzenia.slice(0, 3).map((w) => (
          <article class="card reveal">
            <span class="card__k">{w.kiedy}</span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
            <span class="card__m">{w.m}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PASEK GALERII ===================== -->
  <section class="band band--tight">
    <div class="wrap strip-head reveal">
      <div>
        <p class="eyebrow">{t.stripKicker}</p>
        <h2 class="h2">{t.stripH2}</h2>
      </div>
      <div class="strip-arrows">
        <button id="stripPrev" aria-label={t.prev} type="button">←</button>
        <button id="stripNext" aria-label={t.next} type="button">→</button>
      </div>
    </div>
    <div class="strip" id="strip" tabindex="0">
      {paskoweFoto.map((f) => (
        <div class="strip__item">
          <Foto src={`restauracja/${f.src}.webp`} alt={f.alt} ratio={f.ratio} label={f.tag} />
        </div>
      ))}
    </div>
    <div class="wrap center" style="margin-top:2rem">
      <a class="btn btn--outline reveal" href={`${root}/galeria/`}>{t.allGallery}</a>
    </div>
  </section>

  <!-- ===================== OPINIE GOOGLE ===================== -->
  <section class="band band--krem">
    <div class="wrap">
      <div class="center reveal" style="margin-bottom:2.5rem">
        <p class="eyebrow eyebrow--center">{t.revKicker}</p>
        <h2 class="h2">{t.revH2}</h2>
      </div>
      <GoogleReviews limit={3} cols3={true} lang={lang} />
      <div class="center" style="margin-top:2.5rem">
        <a class="btn btn--outline reveal" href={`${root}/opinie/`}>{t.moreRev}</a>
      </div>
    </div>
  </section>

  <!-- ===================== REZERWACJA + MAPA ===================== -->
  <section class="band">
    <div class="wrap rez-grid">
      <div class="reveal">
        <p class="eyebrow">{t.rezKicker}</p>
        <h2 class="h2">{t.rezH2[0]}<br />{t.rezH2[1]}</h2>
        <p class="lede">{t.rezLede}</p>
        <a class="btn btn--gold mt-m" href={`tel:${tel}`}>{biz.phone}</a>
        <div class="divlist mt-l">
          <div>
            <h4 style="font-family:var(--sans);font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;color:var(--zloto);margin-bottom:.6rem">{t.hours}</h4>
            {biz.hours.map((h) => <p style="color:var(--krem-2)">{h}</p>)}
          </div>
          <div>
            <h4 style="font-family:var(--sans);font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;color:var(--zloto);margin-bottom:.6rem">{t.address}</h4>
            <p style="color:var(--krem-2)">{biz.street}, {biz.zip} {biz.city}</p>
            <a class="ulink" href={biz.mapUrl} target="_blank" rel="noopener" style="color:var(--zloto-jasne)">Google Maps →</a>
          </div>
        </div>
        <a class="btn btn--outline mt-l" href={`${root}/rezerwacja/`}>{t.formLink}</a>
      </div>
      <div class="reveal">
        <MapaRest lang={lang} />
      </div>
    </div>
  </section>

  <script>
    // status kuchni: śr–sob 16–22, nd 12–18; ostatnie zamówienie 45 min przed
    const grafik: Record<number, [number, number] | null> = {
      0: [720, 1080], 1: null, 2: null, 3: [960, 1320], 4: [960, 1320], 5: [960, 1320], 6: [960, 1320],
    };
    const status = document.getElementById('status');
    if (status) {
      const s = JSON.parse(status.dataset.s || '{}');
      const t = new Date();
      const dzis = grafik[t.getDay()];
      const min = t.getHours() * 60 + t.getMinutes();
      const fmt = (m: number) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
      if (dzis && min >= dzis[0] && min < dzis[1] - 45) status.innerHTML = `<strong>${s.open}</strong> · ${s.last} ${fmt(dzis[1] - 45)}`;
      else if (dzis && min >= dzis[1] - 45 && min < dzis[1]) status.innerHTML = `<strong>${s.lastOrders}</strong> · ${s.ends} ${fmt(dzis[1])}`;
      else if (dzis && min < dzis[0]) status.innerHTML = `<strong>${s.later}</strong> ${fmt(dzis[0])}`;
      else if (dzis) status.innerHTML = s.done;
      else status.innerHTML = s.closed;
    }

    // pasek galerii — strzałki
    const strip = document.getElementById('strip');
    const krok = () => (strip?.querySelector('.strip__item') as HTMLElement | null)?.offsetWidth || 360;
    document.getElementById('stripPrev')?.addEventListener('click', () => strip?.scrollBy({ left: -krok() - 16, behavior: 'smooth' }));
    document.getElementById('stripNext')?.addEventListener('click', () => strip?.scrollBy({ left: krok() + 16, behavior: 'smooth' }));
  </script>
</Restauracja>
