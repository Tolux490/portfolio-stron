---
// Ogrodowa 3 — galeria (PL: /restauracja/galeria/, EN: /restauracja/en/galeria/).
import Restauracja from '../../layouts/Restauracja.astro';
import Foto from '../../components/Foto.astro';
import * as PL from '../../data/restauracja.js';
import * as EN from '../../data/restauracja-en.js';

const { lang = 'pl' } = Astro.props;
const en = lang === 'en';
const { galeria } = en ? EN : PL;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/restauracja${en ? '/en' : ''}`;
const full = (s) => `${base}/img/restauracja/${s}.webp`;

const t = en ? {
  title: 'Gallery · Ogrodowa 3, Wołomin',
  desc: 'The dining room, plates, kitchen and wines of Ogrodowa 3 in Wołomin. Take a look inside before you book a table.',
  kicker: 'Gallery', h1: 'Take a look inside',
  lede: 'A candlelit dining room, plates straight from the pass, wines from the cellar. Click a photo to enlarge it.',
  enlarge: 'Enlarge', book: 'Book a table', lb: 'Enlarged photo', close: 'Close', prev: 'Previous', next: 'Next',
} : {
  title: 'Galeria · Ogrodowa 3, Wołomin',
  desc: 'Sala, talerze, kuchnia i wina restauracji Ogrodowa 3 w Wołominie. Zajrzyj do środka, zanim zarezerwujesz stolik.',
  kicker: 'Galeria', h1: 'Zajrzyj do środka',
  lede: 'Sala przy świecach, talerze prosto z wydawki, wina z piwniczki. Kliknij zdjęcie, żeby powiększyć.',
  enlarge: 'Powiększ', book: 'Zarezerwuj stolik', lb: 'Powiększone zdjęcie', close: 'Zamknij', prev: 'Poprzednie', next: 'Następne',
};
---
<Restauracja title={t.title} description={t.desc} current="galeria" ogImage="restauracja/wnetrze-kominek.webp" lang={lang} path="galeria/">

  <section class="pagehead">
    <div class="wrap">
      <p class="eyebrow reveal">{t.kicker}</p>
      <h1 class="reveal">{t.h1}</h1>
      <p class="lede reveal">{t.lede}</p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="wrap">
      <div class="masonry" id="masonry">
        {galeria.map((f, i) => (
          <figure class="reveal">
            <button type="button" data-lightbox={i} data-full={full(f.src)} data-alt={f.alt} aria-label={`${t.enlarge}: ${f.alt}`}>
              <Foto src={`restauracja/${f.src}.webp`} alt={f.alt} ratio={f.ratio} label={f.tag} />
            </button>
            <figcaption>{f.tag}</figcaption>
          </figure>
        ))}
      </div>
      <div class="center mt-l">
        <a class="btn btn--gold reveal" href={`${root}/rezerwacja/`}>{t.book}</a>
      </div>
    </div>
  </section>

  <!-- lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={t.lb}>
    <button class="lightbox__close" id="lbClose" aria-label={t.close}>✕</button>
    <button class="lightbox__nav lightbox__nav--prev" id="lbPrev" aria-label={t.prev}>‹</button>
    <img id="lbImg" src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" id="lbNext" aria-label={t.next}>›</button>
  </div>

  <script>
    const btns = Array.from(document.querySelectorAll('[data-lightbox]')) as HTMLButtonElement[];
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lbImg') as HTMLImageElement;
    let idx = 0;

    const show = (i: number) => {
      idx = (i + btns.length) % btns.length;
      const b = btns[idx];
      lbImg.src = b.dataset.full || '';
      lbImg.alt = b.dataset.alt || '';
    };
    const open = (i: number) => { show(i); lb?.classList.add('is-open'); document.body.style.overflow = 'hidden'; };
    const close = () => { lb?.classList.remove('is-open'); document.body.style.overflow = ''; };

    btns.forEach((b, i) => b.addEventListener('click', () => open(i)));
    document.getElementById('lbClose')?.addEventListener('click', close);
    document.getElementById('lbPrev')?.addEventListener('click', () => show(idx - 1));
    document.getElementById('lbNext')?.addEventListener('click', () => show(idx + 1));
    lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
    window.addEventListener('keydown', (e) => {
      if (!lb?.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  </script>
</Restauracja>
