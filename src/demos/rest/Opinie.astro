---
// Ogrodowa 3 — opinie gości (PL: /restauracja/opinie/, EN: /restauracja/en/opinie/).
import Restauracja from '../../layouts/Restauracja.astro';
import GoogleReviews from '../../components/rest/GoogleReviews.astro';
import Stars from '../../components/rest/Stars.astro';
import { restauracja as biz } from '../../data/firmy.js';
import { opinie } from '../../data/restauracja.js';

const { lang = 'pl' } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/restauracja${en ? '/en' : ''}`;
const ocena = en ? String(biz.googleRating) : biz.googleRating.toString().replace('.', ',');

// rozkład ocen (na bazie widocznych opinii; oceny są takie same w obu językach)
const rozklad = [5, 4, 3, 2, 1].map((g) => ({
  g,
  n: opinie.filter((o) => o.g === g).length,
}));
const maxN = Math.max(...rozklad.map((r) => r.n), 1);

const t = en ? {
  title: 'Guest reviews · Ogrodowa 3, Wołomin',
  desc: `Rated ${biz.googleRating} from ${biz.googleCount} Google reviews. Read what guests say about Ogrodowa 3 in Wołomin.`,
  kicker: 'Reviews', h1: 'What guests say',
  lede: 'We do not ask for reviews; guests write them on their own. Below is what they left on our Google listing.',
  basedOn: `based on ${biz.googleCount} Google reviews`,
  note: 'Reviews come from our Google listing (for this demo they are fictional). Have you been to see us? We would be glad if you left a few words.',
  add: 'Write a Google review', book: 'Book a table',
} : {
  title: 'Opinie gości · Ogrodowa 3, Wołomin',
  desc: `Ocena ${biz.googleRating} na ${biz.googleCount} opinii Google. Przeczytaj, co goście mówią o restauracji Ogrodowa 3 w Wołominie.`,
  kicker: 'Opinie', h1: 'Co mówią goście',
  lede: 'Nie prosimy o opinie, goście piszą je sami. Poniżej to, co zostawili na naszej wizytówce Google.',
  basedOn: `na podstawie ${biz.googleCount} opinii Google`,
  note: 'Opinie pochodzą z wizytówki Google (na potrzeby tego demo są fikcyjne). Byłeś u nas? Będzie nam miło, jeśli zostawisz kilka słów.',
  add: 'Dodaj opinię na Google', book: 'Zarezerwuj stolik',
};
---
<Restauracja title={t.title} description={t.desc} current="opinie" ogImage="restauracja/stol-nakrycie.webp" lang={lang} path="opinie/">

  <section class="pagehead">
    <div class="wrap">
      <p class="eyebrow reveal">{t.kicker}</p>
      <h1 class="reveal">{t.h1}</h1>
      <p class="lede reveal">{t.lede}</p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="wrap">
      <!-- podsumowanie z rozkładem -->
      <div class="split reveal" style="align-items:center;margin-bottom:3rem">
        <div class="center" style="border:1px solid var(--linia);border-radius:3px;padding:2.5rem">
          <div class="gsum__score" style="font-size:4.5rem">{ocena}</div>
          <div style="display:flex;justify-content:center;margin:.5rem 0"><Stars g={biz.googleRating} lang={lang} /></div>
          <p class="mono-note">{t.basedOn}</p>
        </div>
        <div>
          {rozklad.map((r) => (
            <div style="display:flex;align-items:center;gap:1rem;margin:.55rem 0">
              <span style="font-size:.8rem;color:var(--cichy);min-width:2.5rem">{r.g} ★</span>
              <span style="flex:1;height:6px;background:var(--linia);border-radius:20px;overflow:hidden">
                <span style={`display:block;height:100%;width:${(r.n / maxN) * 100}%;background:var(--zloto);border-radius:20px`}></span>
              </span>
              <span style="font-size:.8rem;color:var(--cichy);min-width:1.5rem;text-align:right">{r.n}</span>
            </div>
          ))}
        </div>
      </div>

      <GoogleReviews limit={opinie.length} cols3={true} lang={lang} />

      <p class="mono-note reveal maxw-prose" style="margin-top:2.5rem">{t.note}</p>
      <div class="center mt-l">
        <a class="btn btn--outline reveal" href={biz.googleUrl} target="_blank" rel="noopener" style="margin-right:.5rem">{t.add}</a>
        <a class="btn btn--gold reveal" href={`${root}/rezerwacja/`}>{t.book}</a>
      </div>
    </div>
  </section>
</Restauracja>
