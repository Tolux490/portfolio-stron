---
import Curtain from '../components/Curtain.astro';
import DemoLang from '../components/DemoLang.astro';
// Kwast & Kleur (demo): firma malarska w Maastricht, NL + EN. Strony: src/pages/schilder/ (NL) i /en/ (EN).
// Fikcyjna firma: numery, adres, ceny i opinie są przykładowe.

const { lang = 'nl' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f) => `${base}/img/schilder/${f}`;
const root = (l) => `${base}/schilder/${l === 'nl' ? '' : `${l}/`}`;
const tel = '+31430000000';

// stawki do kalkulatora (EUR, z VAT), orientacyjne
const RATES = { wall: 13, ceiling: 16, door: 85, frameOut: 175, facade: 24, darkPct: 0.12 };
const CHIPS = [['#e9e4d8', 'Kalkwit'], ['#c9b79c', 'Zandsteen'], ['#8a9a7b', 'Mergelgroen'], ['#3f5b4f', 'Maasgroen'], ['#1e3d33', 'Bosgroen'], ['#d39b2a', 'Oker'], ['#a9573a', 'Terracotta'], ['#2d3540', 'Leisteen']];
const T = {
