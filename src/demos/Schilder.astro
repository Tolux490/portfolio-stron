<script>
  const cfg = JSON.parse(document.getElementById('cfg').textContent);
  const R = cfg.rates, L = cfg.t;
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  $$('.rv').forEach((el) => io.observe(el));

  // kalkulator ceny
  const calc = $('[data-calc]');
  let mode = 'in';
  const nf = new Intl.NumberFormat({ en: 'en-IE', nl: 'nl-NL', pl: 'pl-PL' }[cfg.lang], { maximumFractionDigits: 0 });
  const val = (n) => +calc[n].value;
  const compute = () => {
    let sum = mode === 'in'
      ? val('walls') * R.wall + val('ceilings') * R.ceiling + val('doors') * R.door
      : val('frames') * R.frameOut + val('facade') * R.facade;
    if (calc.dark.checked) sum *= 1 + R.darkPct;
    const area = mode === 'in' ? val('walls') + val('ceilings') + val('doors') * 4 : val('frames') * 6 + val('facade');
    const days = Math.max(1, Math.round(area / 45));
    const lo = Math.round((sum * 0.9) / 10) * 10, hi = Math.round((sum * 1.12) / 10) * 10;
    $('[data-res]').textContent = sum ? `€ ${nf.format(lo)} – ${nf.format(hi)}` : '€ –';
    $('[data-days]').textContent = sum ? (days > 1 ? `${days - 1}–${days + 1}` : '1') : '–';
    $$('input[type=range]', calc).forEach((r) => (calc.querySelector(`[data-out="${r.name}"]`).textContent = `${r.value} ${r.dataset.unit}`));
    return { lo, hi };
  };
  calc.addEventListener('input', compute);
  $$('[data-tab]', calc).forEach((b) => b.addEventListener('click', () => {
    mode = b.dataset.tab;
    $$('[data-tab]', calc).forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $$('[data-panel]', calc).forEach((p) => (p.hidden = p.dataset.panel !== mode));
    compute();
  }));
  compute();
  $('[data-take]').addEventListener('click', () => {
    const { lo, hi } = compute();
    const parts = mode === 'in'
      ? [`${L.walls} ${val('walls')} ${L.m2}`, `${L.ceilings} ${val('ceilings')} ${L.m2}`, `${L.doors} ${val('doors')} ${L.pcs}`]
      : [`${L.frames} ${val('frames')} ${L.pcs}`, `${L.facade} ${val('facade')} ${L.m2}`];
    if (calc.dark.checked) parts.push(L.dark);
    $('[data-form]').what.value = `${L.prefix}: ${parts.join(', ')} (€ ${nf.format(lo)} – ${nf.format(hi)})`;
  });

  // formularz oferty (demo)
  const form = $('[data-form]');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    ['name', 'phone'].forEach((n) => { const bad = form[n].value.trim().length < 2; form[n].classList.toggle('is-bad', bad); if (bad) ok = false; });
    if (ok) $('[data-done]').hidden = false;
  });
</script>
