    tabIn: 'Binnen', tabOut: 'Buiten',
    walls: 'Muren', ceilings: 'Plafonds', doors: 'Deuren en kozijnen binnen', frames: 'Kozijnen buiten', facade: 'Gevel', m2: 'm²', pcs: 'stuks',
    dark: 'Van licht naar donker (of andersom)', paint: 'Verf en materiaal inbegrepen',
    result: 'Indicatie', incl: 'incl. btw', days: 'Ongeveer', daysU: 'werkdagen',
