    cLede: 'Fill in what needs painting. You see an estimate right away; you get the exact price after a free visit.',
    tabIn: 'Indoor', tabOut: 'Outdoor',
    walls: 'Walls', ceilings: 'Ceilings', doors: 'Indoor doors and frames', frames: 'Outdoor window frames', facade: 'Facade', m2: 'm²', pcs: 'pcs',
    dark: 'Light to dark (or the other way round)', paint: 'Paint and materials included',
    result: 'Estimate', incl: 'incl. VAT', days: 'About', daysU: 'working days',
    btwNote: 'Labour on homes older than 2 years is taxed at 9% VAT in the Netherlands. The exact amount is in your quote.',
    takeCalc: 'Request a quote with this estimate',
    sLab: 'Services', sH: 'What we can do for you',
    services: [['groen.webp', 'Interior painting', 'Walls, ceilings, stairs and doors. Latex or chalk paint, crisp right into the corners.'], ['gevel.webp', 'Exterior painting', 'Window frames, doors and facades. Sanded and primed properly before the top coat.'], ['woonkamer.webp', 'Colour advice', 'Torn between two shades? We paint sample patches on your wall, free with every job.'], ['wit.webp', 'Maintenance plan', 'A check of your exterior every 6 years, so you never pay for wood rot.']],
    kLab: 'Colour advice', kH: 'Colours that suit Limburg',
    kP: 'Our favourites for homes in Maastricht and the Heuvelland: warm, calm and lovely next to marl stone and brick.',
    pLab: 'Projects', pH: 'Recently finished',
    projects: [['groen.webp', 'Living room in Maas green', 'Wyck · 3 days'], ['geel.webp', 'Bright reading corner', 'Sint Pieter · 2 days'], ['slaapkamer.webp', 'Bedroom, walls and ceiling', 'Heer · 2 days'], ['gang.webp', 'Hallway and stairs', 'Meerssen · 4 days'], ['gevel.webp', 'Window frames and facade', 'Gulpen · 6 days']],
    wLab: 'How we work', wH: 'What to expect',
    how: [['Visit', 'We come by for free, measure up and talk colours.'], ['Fixed price', 'Within 2 working days, a quote with a fixed price and a start date.'], ['Painting', 'Everything gets covered. We tidy up every day before we leave.'], ['Handover', 'We walk through it together. Only when you’re happy do we send the invoice.']],
    rLab: 'Reviews', rH: 'What clients say',
    reviews: [['Started exactly on the agreed day and finished a day early. Not a single drop on the floor.', 'The Hermans family, Heer'], ['The colour advice was worth gold. We doubted for months; after the sample patches we knew straight away.', 'Ingrid, Wyck'], ['The fixed price really was the final price. You don’t see that often.', 'Bas, Meerssen']],
    oLab: 'Free quote', oH: 'Tell us what needs painting',
    oP: 'You’ll hear from us within one working day. Photos help, but aren’t required.',
    fName: 'Name', fPhone: 'Phone', fZip: 'Postcode', fWhat: 'What needs doing?', fWhatPh: 'E.g. living room and hallway, walls and ceiling, colour not chosen yet', fPhotos: 'Photos (optional)', fWhen: 'Preferred timing', when: ['As soon as possible', 'Within 1 to 2 months', 'Later this year'], send: 'Request a quote',
    doneH: 'Thank you! We’ll call you within one working day.', doneP: 'Demo version: nothing was sent. On the real site the request goes straight to the company.',
    calcPrefix: 'My estimate',
    demo: 'Concept website for a fictional painting company, made by Vervo Studio.', credit: 'Website by Vervo Studio ↗',
  },
  pl: {
    title: 'Kwast & Kleur — firma malarska w Maastricht i okolicach',
    desc: 'Malowanie wnętrz i elewacji w Maastricht i Heuvelland. Stała cena z góry, 2 lata gwarancji. Sprawdź od razu orientacyjny koszt.',
    nav: ['Usługi', 'Ile to kosztuje?', 'Realizacje', 'Jak pracujemy'], quote: 'Bezpłatna wycena', calcBtn: 'Oblicz koszt',
    kicker: 'Firma malarska · Maastricht i Heuvelland',
    h1: 'Malarze, którzy kończą w dniu, który obiecali.',
    lede: 'Malowanie wnętrz i elewacji za cenę ustaloną z góry. Wszystko zabezpieczamy, pracujemy czysto i zostawiamy dom w lepszym stanie, niż go zastaliśmy.',
    rating: '4,8 z 96 opinii',
    usp: ['Stała cena z góry', '2 lata gwarancji', 'Sprzątamy po sobie', 'Wnętrza malujemy też zimą'],
    cLab: 'Orientacyjny koszt', cH: 'Ile to mniej więcej kosztuje?',
    cLede: 'Zaznacz, co trzeba pomalować, a od razu zobaczysz orientacyjną kwotę. Dokładną cenę podamy po bezpłatnych oględzinach.',
    tabIn: 'Wnętrza', tabOut: 'Na zewnątrz',
    walls: 'Ściany', ceilings: 'Sufity', doors: 'Drzwi i ościeżnice wewnątrz', frames: 'Ramy okienne na zewnątrz', facade: 'Elewacja', m2: 'm²', pcs: 'szt.',
    dark: 'Z jasnego na ciemny (albo odwrotnie)', paint: 'Farba i materiały w cenie',
    result: 'Szacunek', incl: 'z VAT', days: 'Około', daysU: 'dni roboczych',
    btwNote: 'W Holandii robocizna przy domach starszych niż 2 lata ma obniżony VAT 9%. Dokładną kwotę podamy w wycenie.',
    takeCalc: 'Poproś o wycenę z tym szacunkiem',
    sLab: 'Usługi', sH: 'W czym możemy pomóc',
    services: [['groen.webp', 'Malowanie wnętrz', 'Ściany, sufity, schody i drzwi. Farba lateksowa lub kredowa, równo aż po same narożniki.'], ['gevel.webp', 'Malowanie na zewnątrz', 'Ramy okienne, drzwi i elewacje. Najpierw porządne szlifowanie i podkład, dopiero potem lakier.'], ['woonkamer.webp', 'Doradztwo kolorystyczne', 'Wahasz się między dwoma odcieniami? Malujemy próbki na ścianie, gratis przy każdym zleceniu.'], ['wit.webp', 'Plan konserwacji', 'Przegląd stolarki zewnętrznej co 6 lat, żeby nigdy nie trzeba było płacić za zgniłe drewno.']],
    kLab: 'Doradztwo kolorystyczne', kH: 'Kolory, które pasują do Limburgii',
    kP: 'Nasze ulubione odcienie do domów w Maastricht i Heuvelland: ciepłe, spokojne i ładnie grające z marglem i cegłą.',
    pLab: 'Realizacje', pH: 'Ostatnio oddane',
    projects: [['groen.webp', 'Salon w zieleni znad Mozy', 'Wyck · 3 dni'], ['geel.webp', 'Jasny kącik do czytania', 'Sint Pieter · 2 dni'], ['slaapkamer.webp', 'Sypialnia, ściany i sufit', 'Heer · 2 dni'], ['gang.webp', 'Korytarz i schody', 'Meerssen · 4 dni'], ['gevel.webp', 'Ramy okienne i elewacja', 'Gulpen · 6 dni']],
    wLab: 'Jak pracujemy', wH: 'Jak to wygląda',
    how: [['Oględziny', 'Przyjeżdżamy bezpłatnie, mierzymy i rozmawiamy o kolorach.'], ['Stała cena', 'W ciągu 2 dni roboczych dostajesz wycenę ze stałą ceną i datą startu.'], ['Malowanie', 'Wszystko zabezpieczamy. Codziennie sprzątamy przed wyjściem.'], ['Odbiór', 'Razem wszystko sprawdzamy. Fakturę wystawiamy dopiero wtedy, gdy wszystko Ci się podoba.']],
    rLab: 'Opinie', rH: 'Co mówią klienci',
    reviews: [['Zaczęli dokładnie w umówiony dzień i skończyli dzień wcześniej. Ani jednej kropli na podłodze.', 'Rodzina Hermans, Heer'], ['Porada kolorystyczna była na wagę złota. Wahaliśmy się miesiącami, a po próbkach na ścianie od razu wiedzieliśmy.', 'Ingrid, Wyck'], ['Stała cena naprawdę okazała się ceną końcową. Rzadko się to zdarza.', 'Bas, Meerssen']],
    oLab: 'Bezpłatna wycena', oH: 'Napisz, co trzeba pomalować',
    oP: 'Odezwiemy się w ciągu jednego dnia roboczego. Zdjęcia pomagają, ale nie są konieczne.',
    fName: 'Imię i nazwisko', fPhone: 'Telefon', fZip: 'Kod pocztowy', fWhat: 'Co trzeba zrobić?', fWhatPh: 'Np. salon i przedpokój, ściany i sufit, kolor jeszcze niewybrany', fPhotos: 'Zdjęcia (opcjonalnie)', fWhen: 'Preferowany termin', when: ['Jak najszybciej', 'W ciągu 1–2 miesięcy', 'Później w tym roku'], send: 'Poproś o wycenę',
    doneH: 'Dziękujemy! Zadzwonimy w ciągu jednego dnia roboczego.', doneP: 'Wersja pokazowa: nic nie zostało wysłane. Na prawdziwej stronie zgłoszenie trafia od razu do firmy.',
    calcPrefix: 'Mój szacunek',
    demo: 'Strona koncepcyjna fikcyjnej firmy malarskiej, wykonana przez Vervo Studio.', credit: 'Strona: Vervo Studio ↗',
  },
};
const t = T[lang];
const cfg = { lang, rates: RATES, t: { m2: t.m2, pcs: t.pcs, walls: t.walls, ceilings: t.ceilings, doors: t.doors, frames: t.frames, facade: t.facade, dark: t.dark, prefix: t.calcPrefix } };
const range = (name, label, min, max, val, unit) => ({ name, label, min, max, val, unit });
const IN = [range('walls', t.walls, 0, 300, 80, t.m2), range('ceilings', t.ceilings, 0, 150, 30, t.m2), range('doors', t.doors, 0, 20, 2, t.pcs)];
const OUT = [range('frames', t.frames, 0, 30, 8, t.pcs), range('facade', t.facade, 0, 250, 0, t.m2)];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1e3d33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Figtree:wght@400;500;600&display=swap" />
  </head>
  <body>
    <Curtain />
    <div class="topbar">
      <span>{t.usp[0]} · {t.usp[1]}</span>
      <a href={`tel:${tel}`}>☎ 043 000 00 00</a>
    </div>
    <header class="hd">
      <a class="hd__logo" href="#top"><i aria-hidden="true"></i>Kwast <b>&</b> Kleur</a>
      <nav class="hd__nav">{['#diensten', '#prijs', '#projecten', '#werkwijze'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}</nav>
      <a class="btn btn--ochre hd__cta" href="#offerte">{t.quote}</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero__txt">
          <p class="kicker">{t.kicker}</p>
          <h1>{t.h1}</h1>
          <p class="lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--green" href="#prijs">{t.calcBtn}</a>
            <a class="btn btn--line" href="#offerte">{t.quote}</a>
          </div>
          <p class="rating"><span>★★★★★</span> {t.rating}</p>
        </div>
        <div class="hero__img">
          <img src={img('hero.webp')} alt="" fetchpriority="high" />
          <div class="chips" aria-hidden="true">{CHIPS.slice(2, 6).map(([c, n]) => <div class="chip" style={`--c:${c}`}><span>{n}</span></div>)}</div>
        </div>
      </section>

      <ul class="usp">{t.usp.map((u) => <li>✓ {u}</li>)}</ul>

      <section class="sec sec--calc" id="prijs">
        <div class="wrap calc">
          <div>
            <p class="lab">{t.cLab}</p>
            <h2 class="h2">{t.cH}</h2>
            <p class="lede">{t.cLede}</p>
            <img class="calc__img" src={img('roller.webp')} alt="" loading="lazy" />
          </div>
          <form class="calc__box" data-calc>
            <div class="tabs" role="tablist">
              <button type="button" role="tab" aria-selected="true" data-tab="in">{t.tabIn}</button>
              <button type="button" role="tab" aria-selected="false" data-tab="out">{t.tabOut}</button>
            </div>
            <div data-panel="in">
              {IN.map((r) => <label class="rng"><span><b>{r.label}</b><output data-out={r.name}>{r.val} {r.unit}</output></span><input type="range" name={r.name} min={r.min} max={r.max} value={r.val} data-unit={r.unit} /></label>)}
            </div>
            <div data-panel="out" hidden>
              {OUT.map((r) => <label class="rng"><span><b>{r.label}</b><output data-out={r.name}>{r.val} {r.unit}</output></span><input type="range" name={r.name} min={r.min} max={r.max} value={r.val} data-unit={r.unit} /></label>)}
            </div>
            <label class="tog"><input type="checkbox" name="dark" /><span>{t.dark}</span></label>
            <p class="tog tog--fixed">✓ {t.paint}</p>
            <div class="res">
              <p class="res__l">{t.result} <small>{t.incl}</small></p>
              <p class="res__v" data-res>€ –</p>
              <p class="res__d">{t.days} <b data-days>–</b> {t.daysU}</p>
            </div>
            <p class="note">{t.btwNote}</p>
            <a class="btn btn--ochre btn--full" href="#offerte" data-take>{t.takeCalc}</a>
          </form>
        </div>
      </section>

      <section class="sec" id="diensten">
        <div class="wrap">
          <p class="lab rv">{t.sLab}</p>
          <h2 class="h2 rv">{t.sH}</h2>
          <div class="svc">
            {t.services.map(([f, h, p]) => <article class="rv"><img src={img(f)} alt="" loading="lazy" /><h3>{h}</h3><p>{p}</p></article>)}
          </div>
        </div>
      </section>

      <section class="sec sec--kleur">
        <div class="wrap kleur">
          <div>
            <p class="lab">{t.kLab}</p>
            <h2 class="h2">{t.kH}</h2>
            <p class="lede">{t.kP}</p>
          </div>
          <div class="fan">{CHIPS.map(([c, n], i) => <div class="fan__c rv" style={`--c:${c};--i:${i}`}><span>{n}</span><small>{c.toUpperCase()}</small></div>)}</div>
        </div>
      </section>

      <section class="sec" id="projecten">
        <div class="wrap">
          <p class="lab rv">{t.pLab}</p>
          <h2 class="h2 rv">{t.pH}</h2>
        </div>
        <div class="proj" tabindex="0">
          {t.projects.map(([f, h, m]) => <figure><img src={img(f)} alt={h} loading="lazy" /><figcaption><b>{h}</b><span>{m}</span></figcaption></figure>)}
        </div>
      </section>

      <section class="sec sec--how" id="werkwijze">
        <div class="wrap">
          <p class="lab rv">{t.wLab}</p>
          <h2 class="h2 rv">{t.wH}</h2>
          <ol class="how">{t.how.map(([h, p], i) => <li class="rv"><span>{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}</ol>
        </div>
      </section>

      <section class="sec">
        <div class="wrap">
          <p class="lab rv">{t.rLab}</p>
          <h2 class="h2 rv">{t.rH}</h2>
          <div class="revs">{t.reviews.map(([q, w]) => <blockquote class="rv"><span>★★★★★</span><p>{q}</p><cite>{w}</cite></blockquote>)}</div>
        </div>
      </section>

      <section class="sec sec--offer" id="offerte">
        <div class="wrap offer">
          <div>
            <p class="lab">{t.oLab}</p>
            <h2 class="h2">{t.oH}</h2>
            <p class="lede">{t.oP}</p>
            <p class="offer__tel"><a href={`tel:${tel}`}>☎ 043 000 00 00</a></p>
          </div>
          <form class="form" data-form novalidate>
            <div class="f2">
              <label class="f"><span>{t.fName}</span><input name="name" autocomplete="name" required /></label>
              <label class="f"><span>{t.fPhone}</span><input name="phone" type="tel" autocomplete="tel" required /></label>
            </div>
            <label class="f"><span>{t.fZip}</span><input name="zip" autocomplete="postal-code" placeholder="6211 AB" /></label>
            <label class="f"><span>{t.fWhat}</span><textarea name="what" rows="4" placeholder={t.fWhatPh}></textarea></label>
