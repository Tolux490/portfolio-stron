    services: [['groen.webp', 'Binnenschilderwerk', 'Muren, plafonds, trappen en deuren. Latex of krijtverf, strak tot in de hoeken.'], ['gevel.webp', 'Buitenschilderwerk', 'Kozijnen, deuren en gevels. Eerst goed schuren en gronden, dan pas lakken.'], ['woonkamer.webp', 'Kleuradvies', 'Twijfel je tussen twee tinten? We zetten proefvlakken op de muur, gratis bij elke klus.'], ['wit.webp', 'Onderhoudsplan', 'Elke 6 jaar je buitenwerk laten checken, zodat je nooit voor houtrot betaalt.']],
    kLab: 'Kleuradvies', kH: 'Kleuren die passen bij Limburg',
    kP: 'Onze favorieten voor huizen in Maastricht en het Heuvelland: warm, rustig en mooi bij mergel en baksteen.',
    pLab: 'Projecten', pH: 'Recent opgeleverd',
    projects: [['groen.webp', 'Woonkamer in Maasgroen', 'Wyck · 3 dagen'], ['geel.webp', 'Lichte zithoek', 'Sint Pieter · 2 dagen'], ['slaapkamer.webp', 'Slaapkamer, muren en plafond', 'Heer · 2 dagen'], ['gang.webp', 'Hal en trap', 'Meerssen · 4 dagen'], ['gevel.webp', 'Kozijnen en gevel', 'Gulpen · 6 dagen']],
    wLab: 'Werkwijze', wH: 'Zo gaat het',
    how: [['Bezoek', 'We komen gratis langs, meten op en bespreken kleuren.'], ['Vaste prijs', 'Binnen 2 werkdagen een offerte met een vaste prijs en startdatum.'], ['Schilderen', 'Alles wordt afgedekt. Elke dag ruimen we op voordat we gaan.'], ['Oplevering', 'Samen lopen we alles na. Pas als jij tevreden bent, sturen we de factuur.']],
    rLab: 'Reviews', rH: 'Wat klanten zeggen',
    reviews: [['Precies op de afgesproken dag begonnen en een dag eerder klaar. Geen spatje op de vloer.', 'Familie Hermans, Heer'], ['Het kleuradvies was goud waard. We twijfelden maanden, na de proefvlakken wisten we het meteen.', 'Ingrid, Wyck'], ['Vaste prijs was ook echt de eindprijs. Dat maak je niet vaak mee.', 'Bas, Meerssen']],
    oLab: 'Gratis offerte', oH: 'Vertel wat er geschilderd moet worden',
    oP: 'Je hoort binnen één werkdag van ons. Foto’s helpen, maar zijn niet nodig.',
    fName: 'Naam', fPhone: 'Telefoon', fZip: 'Postcode', fWhat: 'Wat moet er gebeuren?', fWhatPh: 'Bijv. woonkamer en hal, muren en plafond, kleur nog niet gekozen', fPhotos: 'Foto’s (optioneel)', fWhen: 'Gewenste periode', when: ['Zo snel mogelijk', 'Binnen 1 tot 2 maanden', 'Later dit jaar'], send: 'Offerte aanvragen',
    doneH: 'Bedankt! We bellen je binnen één werkdag.', doneP: 'Demoversie: er is niets verstuurd. In de echte site komt je aanvraag direct binnen bij het bedrijf.',
    calcPrefix: 'Mijn berekening',
    demo: 'Conceptwebsite voor een fictief schildersbedrijf, gemaakt door Vervo Studio.', credit: 'Website door Vervo Studio ↗',
  },
  en: {
    title: 'Kwast & Kleur — painters in Maastricht and the Heuvelland',
    desc: 'Interior and exterior painting in Maastricht and the Heuvelland. Fixed price upfront, 2-year guarantee. Get an instant price estimate.',
    nav: ['Services', 'Price estimate', 'Projects', 'How we work'], quote: 'Free quote', calcBtn: 'Estimate your price',
