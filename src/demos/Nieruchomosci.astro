  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="pl" href={new URL(`${plRoot}/`, Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(`${plRoot}/en/`, Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.ogDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={en ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image" content={new URL('/og/nieruchomosci.png', Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': biz.schemaType,
      name: biz.name,
      telephone: biz.phone,
      email: biz.email,
      address: { '@type': 'PostalAddress', streetAddress: biz.street, addressLocality: biz.city, postalCode: biz.zip, addressCountry: 'PL' },
      openingHours: biz.openingHours,
      sameAs: [biz.facebook, biz.instagram],
      url: Astro.url.origin,
    })} />
  </head>

  <body>
    <header class="hdr" id="hdr">
      <div class="wrap hdr__in">
        <a class="hdr__mark" href="#gora">Kontur</a>
        <nav class="hdr__nav" aria-label={t.navLabel}>
          {nawigacja.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <a class="hdr__tel" href={`tel:${tel}`}>{biz.phone}</a>
      </div>
    </header>

    <!-- ============ HERO — bez zdjęcia, sama typografia i siatka ============ -->
    <section class="hero" id="gora">
      <div class="wrap">
        <p class="hero__kicker">{t.kicker}</p>
        <h1>{t.h1[0]}<br />{t.h1[1]}</h1>
        <div class="hero__stopa">
          <p class="hero__lede">{t.lede}</p>
          <a class="btn btn--pelny" href="#oferty">{t.seeOffers}</a>
        </div>
      </div>
      <div class="hero__pasek">
        <div class="wrap hero__liczby">
          <div><span class="hero__l-wart" id="liczbaOfert">6</span><span class="hero__l-opis">{t.stats[0]}</span></div>
          <div><span class="hero__l-wart">2%</span><span class="hero__l-opis">{t.stats[1]}</span></div>
          <div><span class="hero__l-wart">41</span><span class="hero__l-opis">{t.stats[2]}</span></div>
          <div><span class="hero__l-wart">5</span><span class="hero__l-opis">{t.stats[3]}</span></div>
        </div>
      </div>
    </section>

    <!-- ============ OFERTY z filtrami i sortowaniem ============ -->
    <section id="oferty" class="band">
      <div class="wrap">
        <div class="sekcja__glowa reveal">
          <div>
            <p class="label">{t.offersLabel}</p>
            <h2 class="h2">{t.offersH2}</h2>
          </div>
          <p class="sekcja__licznik" id="licznikOfert"></p>
        </div>

        <div class="narzedzia reveal">
          <div class="filtry" role="group" aria-label={t.filterLabel}>
            <button class="chip is-active" data-typ="wszystko">{t.chips[0]}</button>
            <button class="chip" data-typ="Mieszkanie">{t.chips[1]}</button>
            <button class="chip" data-typ="Dom">{t.chips[2]}</button>
            <button class="chip" data-typ="Działka">{t.chips[3]}</button>
            <button class="chip chip--zapisane" id="chipZapisane" data-typ="zapisane" aria-pressed="false">
              {t.saved} <span id="licznikZapisanych">0</span>
            </button>
          </div>

          <div class="narzedzia__prawa">
            <label class="suwak">
              <span>{t.upTo} <strong id="etykietaCeny">{kwota(1200000)}</strong></span>
              <input type="range" id="suwakCeny" min="250000" max="1200000" step="10000" value="1200000" aria-label={t.priceLabel} />
            </label>
            <label class="sortowanie">
              <span>{t.sort}</span>
              <select id="sortowanie">
                <option value="cena-asc">{t.sorts[0]}</option>
                <option value="cena-desc">{t.sorts[1]}</option>
                <option value="m-desc">{t.sorts[2]}</option>
                <option value="mkw-asc">{t.sorts[3]}</option>
              </select>
            </label>
            <div class="widok" role="group" aria-label={t.viewLabel}>
              <button class="widok__btn is-active" data-widok="siatka" aria-label={t.viewGrid}>▦</button>
              <button class="widok__btn" data-widok="lista" aria-label={t.viewList}>☰</button>
            </div>
          </div>
        </div>

        <div class="oferty" id="listaOfert">
          {oferty.map((o) => (
            <article class="oferta reveal" data-typ={o.kat} data-cena={o.cena} data-m={o.m} data-id={o.id}>
              <div class="oferta__media">
                <button class="oferta__otworz" type="button" data-otworz={o.id} aria-label={`${t.details}: ${o.typ}, ${o.gdzie}`}>
                  <Foto src={o.fotos[0]} alt={`${o.typ} — ${o.gdzie}`} ratio="3/2" label={`${o.typ} · ${o.gdzie}`} />
                </button>
                <button class="serce" type="button" data-serce={o.id} aria-label={t.save} aria-pressed="false">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M12 20.3 4.6 13a4.6 4.6 0 1 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 1 1 19.4 13z"/>
                  </svg>
                </button>
                <span class="oferta__zdjec">{o.fotos.length} {zdjecia(o.fotos.length)}</span>
              </div>

              <div class="oferta__ciało">
                <p class="oferta__typ">{o.typ} · {o.stan}</p>
                <h3><button type="button" data-otworz={o.id}>{o.gdzie}</button></h3>
                <dl class="metryka">
                  <div><dt>{t.area}</dt><dd>{o.m} m²</dd></div>
                  {o.pok > 0 && <div><dt>{t.rooms}</dt><dd>{o.pok}</dd></div>}
                  <div><dt>{t.floor}</dt><dd>{o.pietro}</dd></div>
                  <div><dt>{t.perM}</dt><dd>{kwota(Math.round(o.cena / o.m))}</dd></div>
                </dl>
                <div class="oferta__stopa">
                  <p class="oferta__cena">{kwota(o.cena)}</p>
                  <button class="oferta__btn" type="button" data-otworz={o.id}>{t.more}</button>
                </div>
                <label class="porownaj">
                  <input type="checkbox" data-porownaj={o.id} />
                  <span>{t.compare}</span>
                </label>
              </div>
            </article>
          ))}
        </div>
        <p class="pusto" id="pusto" hidden>{t.empty}</p>
        <p class="drobne">{t.fine}</p>
      </div>
    </section>

    <!-- ============ ZASADY ============ -->
    <section id="zasady" class="band band--kreska">
      <div class="wrap">
        <p class="label reveal">{t.rulesLabel}</p>
        <h2 class="h2 reveal">{t.rulesH2}</h2>
        <dl class="zasady">
          {t.zasady.map((z) => (
            <div class="reveal">
              <dt>{z.t}</dt>
              <dd>{z.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ ZESPÓŁ ============ -->
    <section id="zespol" class="band">
      <div class="wrap zespol">
        <div class="reveal">
          <p class="label">{t.teamLabel}</p>
          <h2 class="h2">{t.teamH2[0]}<br />{t.teamH2[1]}</h2>
          <p class="lede">{t.teamLede}</p>
        </div>
        <div class="zespol__osoby">
          {zespol.map((o) => (
            <div class="osoba reveal">
              <h3>{o.imie}</h3>
              <p>{o.rola}</p>
              <a href={`tel:${o.tel.replace(/[^+\d]/g, '')}`}>{o.tel}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ UMAWIANIE OGLĄDANIA ============ -->
    <section id="oglad" class="band band--ciemny">
      <div class="wrap oglad">
        <div class="reveal">
          <p class="label">{t.viewLabel2}</p>
          <h2 class="h2">{t.viewH2[0]}<br />{t.viewH2[1]}</h2>
          <p class="lede">{t.viewLede}</p>
          <p class="oglad__alt">
            {t.viewAlt} <a href={`tel:${tel}`}>{biz.phone}</a>
          </p>
        </div>

        <form class="form reveal" id="formOglad" novalidate>
          <div class="form__rzad">
            <label class="pole">
              <span>{t.f.property}</span>
              <select name="nieruchomosc" id="polaNieruchomosc" required>
                <option value="">{t.f.pick}</option>
                {oferty.map((o) => (
                  <option value={o.id}>{o.typ} — {o.gdzie}</option>
                ))}
                <option value="inne">{t.f.other}</option>
              </select>
            </label>
          </div>

          <div class="form__rzad form__rzad--dwa">
            <label class="pole">
              <span>{t.f.day}</span>
              <input type="date" name="dzien" id="polaDzien" required />
            </label>
            <label class="pole">
              <span>{t.f.hour}</span>
              <select name="godzina" required>
                <option value="">{t.f.choose}</option>
                {godziny.map((g) => <option value={g}>{g}</option>)}
              </select>
            </label>
          </div>

          <div class="form__rzad form__rzad--dwa">
            <label class="pole">
              <span>{t.f.name}</span>
              <input type="text" name="imie" autocomplete="name" required />
            </label>
            <label class="pole">
              <span>{t.f.phone}</span>
              <input type="tel" name="telefon" autocomplete="tel" inputmode="tel" required />
            </label>
          </div>

          <div class="form__rzad">
            <label class="pole">
              <span>{t.f.email} <em>{t.f.optional}</em></span>
              <input type="email" name="email" autocomplete="email" />
            </label>
          </div>

          <div class="form__rzad">
            <label class="pole">
              <span>{t.f.notes} <em>{t.f.optional}</em></span>
              <textarea name="uwagi" rows="3" placeholder={t.f.notesPh}></textarea>
            </label>
          </div>

          <!-- Klauzula informacyjna musi być podana W MOMENCIE zbierania danych (art. 13 RODO) -->
          <div class="klauzula">
            {en ? (
              <p>
                The controller of your data is {biz.legalName}, {biz.street}, {biz.zip} {biz.city}, Poland,
                tax ID (NIP) {biz.nip}. We process the data from this form only to arrange and confirm
                the viewing. The legal basis is taking steps at your request before entering into a contract
                (Article 6(1)(b) GDPR) and our legitimate interest in corresponding with you (Article 6(1)(f) GDPR).
              </p>
            ) : (
              <p>
                Administratorem Twoich danych jest {biz.legalName}, {biz.street}, {biz.zip} {biz.city},
                NIP {biz.nip}. Dane z tego formularza przetwarzamy wyłącznie po to, żeby umówić
                i potwierdzić oglądanie — podstawą są działania podejmowane na Twoje żądanie przed
                zawarciem umowy (art. 6 ust. 1 lit. b RODO) oraz nasz prawnie uzasadniony interes
                w prowadzeniu korespondencji (art. 6 ust. 1 lit. f RODO).
              </p>
            )}
            <details>
              <summary>{t.f.more}</summary>
              {en ? (
                <p>
                  Providing your data is voluntary, but without a name and phone number we cannot book a time.
                  We keep the data for 12 months from the last contact or, if a sale goes ahead, for the period
                  required by tax law. Recipients may include the hosting provider and the form-handling provider,
                  acting under a data processing agreement. You have the right to access, correct and delete your
                  data, to restrict processing, to data portability, to object and to lodge a complaint with the
                  Polish supervisory authority (UODO). We do not profile you or make automated decisions. Details:
                  <a href={`${root}/polityka-prywatnosci/`}>{t.f.privacy}</a>.
                </p>
              ) : (
                <p>
                  Podanie danych jest dobrowolne, ale bez imienia i telefonu nie umówimy terminu.
                  Dane przechowujemy 12 miesięcy od ostatniego kontaktu, a jeśli dojdzie do transakcji —
                  przez okres wymagany przepisami podatkowymi. Odbiorcami mogą być dostawca hostingu
                  i dostawca usługi obsługi formularza, działający na podstawie umowy powierzenia.
                  Masz prawo dostępu do danych, sprostowania, usunięcia, ograniczenia przetwarzania,
                  przenoszenia, sprzeciwu oraz skargi do Prezesa UODO. Nie profilujemy i nie podejmujemy
                  decyzji automatycznie. Szczegóły:
                  <a href={`${root}/polityka-prywatnosci/`}>{t.f.privacy}</a>.
                </p>
              )}
            </details>

            <label class="zgoda">
              <input type="checkbox" name="zgoda_marketing" value="tak" />
              <span>{t.f.consent}</span>
            </label>
          </div>

          <button class="btn btn--jasny form__wyslij" type="submit" id="formWyslij">{t.f.submit}</button>
          <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- ============ MIEJSCE ============ -->
    <section class="band">
      <div class="wrap miejsce">
        <div class="reveal">
          <p class="label">{t.officeLabel}</p>
          <address class="miejsce__adres">{biz.street}<br />{biz.zip} {biz.city}</address>
          <div class="miejsce__godziny">{biz.hours.map((h) => <p>{h}</p>)}</div>
          <div class="miejsce__linki">
            <a href={biz.mapUrl} target="_blank" rel="noopener">Google Maps →</a>
            <a href={biz.instagram} target="_blank" rel="noopener">Instagram →</a>
            <a href={biz.facebook} target="_blank" rel="noopener">Facebook →</a>
            <a href={`mailto:${biz.email}`}>{biz.email} →</a>
          </div>
        </div>
        <div class="mapa reveal" id="mapa" data-src={mapEmbed}>
          <div class="mapa__zaslepka" id="mapaZaslepka">
            <p>{t.mapNote[0]}<br />{t.mapNote[1]}</p>
            <button class="btn btn--pelny" id="mapaPokaz" type="button">{t.showMap}</button>
          </div>
        </div>
      </div>
    </section>

    <footer class="stopka">
      <div class="wrap stopka__dol">
        <span>{biz.legalName} · NIP {biz.nip} · {biz.street}, {biz.zip} {biz.city} · {biz.phone}</span>
        <span><a href={`${base}/${en ? '' : 'pl/'}`}>{t.credit}</a> &nbsp;·&nbsp; <a href={`${root}/polityka-prywatnosci/`}>{t.privacy}</a></span>
      </div>
    </footer>

    <!-- pasek porównania -->
    <div class="porBar" id="porBar" hidden>
      <div class="wrap porBar__in">
        <span id="porBarTekst">{t.porNone}</span>
        <div class="porBar__akcje">
          <button class="porBar__czysc" id="porCzysc" type="button">{t.clear}</button>
          <button class="btn btn--pelny porBar__go" id="porPokaz" type="button">{t.compareBtn}</button>
        </div>
      </div>
    </div>

    <!-- panel szczegółów oferty -->
    <div class="panel" id="panel" hidden role="dialog" aria-modal="true" aria-label={t.panelLabel}>
      <div class="panel__tlo" id="panelTlo"></div>
      <div class="panel__karta" id="panelKarta" tabindex="-1">
        <button class="panel__zamknij" id="panelZamknij" aria-label={t.close}>✕</button>
        <div class="panel__tresc" id="panelTresc"></div>
      </div>
    </div>

    <div class="pasek">
      <a href="#oglad">{t.book}</a>
      <a href={`tel:${tel}`}>{t.call}</a>
    </div>

    <DemoLang lang={lang} pl={`${plRoot}/`} en={`${plRoot}/en/`} />
  </body>
</html>

<style is:global>
  /* =========================================================
     KONTUR — minimalizm. Jeden krój, dwie wagi, zero koloru.
     Rytm buduje siatka, światło i włoskowe linie.
     ========================================================= */
  :root {
    --papier: #fbfbfa;
    --papier-2: #f2f2f0;
    --atrament: #101112;
    --atrament-2: #16181a;
    --szary: #6e7276;
    --szary-jasny: rgba(251, 251, 250, 0.58);
    --linia: #e2e2df;
    --linia-jasna: rgba(251, 251, 250, 0.16);
    --font: 'Schibsted Grotesk', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--papier); color: var(--atrament);
    font-family: var(--font); font-size: 0.97rem; font-weight: 400; line-height: 1.6;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid var(--atrament); outline-offset: 3px; }
  h1, h2, h3 { font-weight: 500; line-height: 1.06; letter-spacing: -0.028em; margin: 0; text-wrap: balance; overflow-wrap: break-word; }
  p { margin: 0; text-wrap: pretty; }

  .wrap { width: min(100% - 3rem, 1200px); margin-inline: auto; }
  .band { padding-block: clamp(4rem, 9vw, 7.5rem); }
  .band--kreska { border-top: 1px solid var(--linia); }
  .band--ciemny { background: var(--atrament); color: var(--papier); }

  .label {
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--szary); margin-bottom: 1.1rem;
  }
  .band--ciemny .label { color: var(--szary-jasny); }

  .h2 { font-size: clamp(1.9rem, 4.2vw, 3rem); }
  .lede { color: var(--szary); max-width: 48ch; margin-top: 1.25rem; }
  .band--ciemny .lede { color: var(--szary-jasny); }
  .drobne { font-family: var(--mono); font-size: 0.72rem; color: var(--szary); margin-top: 2.5rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    padding: 0.95rem 1.8rem; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.06em;
    border: 1px solid var(--atrament); transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .btn--pelny { background: var(--atrament); color: var(--papier); }
  .btn--pelny:hover { background: transparent; color: var(--atrament); }
  .btn--jasny { background: var(--papier); color: var(--atrament); border-color: var(--papier); }
  .btn--jasny:hover { background: transparent; color: var(--papier); }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
  .reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
    .reveal { opacity: 1; transform: none; }
  }

  .ph { display: grid; place-items: center; text-align: center; padding: 1rem; background: var(--papier-2); color: var(--szary); font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.08em; }

  /* ---------- nagłówek ---------- */
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 60; padding-block: 1.4rem; transition: all 0.35s var(--ease); border-bottom: 1px solid transparent; }
  .hdr.is-stuck { background: rgba(251, 251, 250, 0.93); backdrop-filter: blur(12px); padding-block: 0.8rem; border-bottom-color: var(--linia); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .hdr__mark { font-size: 1.15rem; font-weight: 500; letter-spacing: -0.02em; }
  .hdr__nav { display: none; gap: 2rem; }
  .hdr__nav a { font-size: 0.84rem; color: var(--szary); transition: color 0.3s var(--ease); }
  .hdr__nav a:hover { color: var(--atrament); }
  .hdr__tel { display: none; font-family: var(--mono); font-size: 0.8rem; }
  @media (min-width: 980px) { .hdr__nav, .hdr__tel { display: flex; } }

  /* ---------- hero ---------- */
  .hero { padding-top: clamp(8rem, 20vh, 13rem); }
  .hero__kicker { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--szary); margin-bottom: 2rem; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 4.6rem); }
  .hero__stopa { display: grid; gap: 2rem; margin-top: clamp(3rem, 8vw, 5rem); padding-bottom: clamp(3rem, 8vw, 5rem); }
  @media (min-width: 880px) { .hero__stopa { grid-template-columns: 1fr auto; align-items: end; } }
  .hero__lede { color: var(--szary); max-width: 44ch; }
  .hero__pasek { border-top: 1px solid var(--linia); border-bottom: 1px solid var(--linia); }
  .hero__liczby { display: grid; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .hero__liczby { grid-template-columns: repeat(4, 1fr); } }
  .hero__liczby > div { padding: 1.5rem 1.5rem 1.5rem 0; border-right: 1px solid var(--linia); display: flex; flex-direction: column; gap: 0.4rem; }
  .hero__liczby > div:nth-child(2n) { padding-right: 0; }
  @media (min-width: 720px) { .hero__liczby > div { padding-right: 1.5rem; } .hero__liczby > div:nth-child(2n) { padding-right: 1.5rem; } .hero__liczby > div:last-child { border-right: 0; padding-right: 0; } }
  .hero__liczby > div:nth-child(2n) { border-right: 0; }
