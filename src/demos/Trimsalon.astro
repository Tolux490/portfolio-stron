<script>
  import { $, readCfg, reveal, openStatus, markToday, demoForm, euro } from '../scripts/demo-kit.js';
  const cfg = readCfg();
  const L = cfg.t, P = cfg.price, N = cfg.names;
  const eur = euro(cfg.lang);
  reveal();
  openStatus($('[data-status]'), { hours: cfg.hours, t: L, lang: cfg.lang });
  markToday($('[data-hours]'));

  const calc = $('[data-calc]');
  const dur = (m) => (m < 60 ? `${m} ${L.min}` : `${Math.floor(m / 60)}${m % 60 ? `:${String(m % 60).padStart(2, '0')}` : ''} ${L.hour}`);
  let last = null;
  const compute = () => {
    const s = calc.elements.size.value, c = calc.elements.coat.value, j = calc.elements.job.value;
    let price = P.size[s][0] * P.coat[c][0] * P.job[j][0];
    let mins = P.size[s][1] * P.coat[c][1] * P.job[j][1];
    const ex = Object.keys(P.extras).filter((k) => calc.elements[k].checked);
    ex.forEach((k) => { price += P.extras[k]; mins += 10; });
    price = Math.round(price / 2.5) * 2.5;
    mins = Math.round(mins / 15) * 15;
    $('[data-price]').textContent = eur(price);
    $('[data-time]').textContent = dur(mins);
    $('[data-tip]').textContent = L.tip[c];
    last = { text: `${N.size[s]} · ${N.coat[c]} · ${N.job[j]}${ex.length ? ` + ${ex.map((k) => N.extras[k].toLowerCase()).join(', ')}` : ''}`, price: eur(price) };
  };
  calc.addEventListener('change', compute);
  compute();
  $('[data-take]').addEventListener('click', () => {
    const p = $('[data-pick]');
    p.textContent = `${L.pickedPre}: ${last.text} (${L.approx} ${last.price})`;
    p.hidden = false;
  });

  demoForm($('[data-form]'), { required: ['dog', 'name', 'phone'] });
</script>
