    jobs: { was: ['Bath and blow-dry', 'fresh and soft, no cut'], trim: ['Full groom', 'bath, cut and shape'], pluk: ['Hand stripping', 'for wire-haired terriers'] },
    extras: { nagels: 'Nail clipping', tanden: 'Teeth brushing', klit: 'Detangling treatment' },
    res: 'Price', resTime: 'Time', min: 'min', hour: 'h', approx: 'about',
    tip: { kort: 'Short-haired dogs shed most in spring and autumn. A bath with a de-shed takes a lot of hair off your sofa.', lang: 'Long coats tangle quickly behind the ears and under the legs. A groom every 6 to 8 weeks keeps them tidy.', krul: 'Curly coats keep growing. A groom every 6 weeks prevents matting and keeps the skin healthy.', dubbel: 'We never shave a double coat short: it protects against both cold and heat. We comb out the undercoat instead.' },
    take: 'Book this groom',
    fLab: 'First visit', fH: 'Never been to a groomer?',
    first: [['Say hello', 'Pop in for 15 minutes to sniff around and hear the sounds. Free for adult dogs, €15 for puppies including a short bath.'], ['Taking it slow', 'We take breaks when needed. Better to split a groom in two than have a dog leave scared.'], ['Photo when done', 'You get a WhatsApp message with a photo when your dog is ready, so there’s no waiting around.']],
    gLab: 'Regulars', gH: 'They like coming back',
    dogs: [['tafel.webp', 'Bobbie', 'French bulldog · every 8 weeks'], ['corgi.webp', 'Luna', 'Corgi · bath and de-shed'], ['aussie.webp', 'Max', 'Australian shepherd · double coat'], ['speeltje.webp', 'Saar', 'Golden retriever · with her cuddly toy'], ['duo.webp', 'Pip and Joep', 'Always come in together'], ['trui.webp', 'Kees', 'Brings his own jumper']],
    rLab: 'Reviews', rH: 'What owners say',
    reviews: [['Our Joep used to shake in the car park. Now he trots in wagging his tail. That says it all.', 'Ilse, Sittard'], ['Very clear about the price upfront, and the WhatsApp photo is a lovely little extra.', 'Ruud, Geleen'], ['They take their time with our old Saar and her stiff hips. She’s even allowed to lie down for a bit halfway through.', 'The Hendriks family, Born']],
    bLab: 'Book', bH: 'Book a groom',
    bLede: 'Leave your details and we’ll call you back the same day to pick a time.',
    fDog: 'Your dog’s name', fBreed: 'Breed or cross', fName: 'Your name', fPhone: 'Phone', fDay: 'Preferred day', anyDay: 'Any day', fNote: 'Anything we should know?', fNotePh: 'E.g. scared of the dryer, sensitive paws', send: 'Request a groom',
    doneH: 'Great! We’ll call you back today.', doneP: 'Demo version: nothing was sent. On the real site the request goes straight to the salon.',
    pickedPre: 'Estimate', hoursH: 'Opening hours', days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], closed: 'Closed',
    openNow: 'Open now', closedNow: 'Closed now', until: 'until', opensAt: 'opens', parking: 'Free parking right outside',
    demo: 'Concept website for a fictional dog grooming salon, made by Vervo Studio.', credit: 'Website by Vervo Studio ↗', call: 'Call',
  },
  pl: {
    title: 'Trimsalon Pluis — spokojny salon pielęgnacji psów w Sittard',
    desc: 'Strzyżenie, kąpiel i trymowanie w Sittard. Jeden pies naraz, bez klatek i bez pośpiechu. Sprawdź od razu, ile kosztuje wizyta Twojego psa.',
    nav: ['Cennik', 'Pierwsza wizyta', 'Stali klienci', 'Wizyta'], book: 'Umów wizytę',
    h1: 'Strzyżenie dla psów, które najchętniej zostałyby w domu.',
    lede: 'Spokojny salon w Sittard. Jeden pies naraz, bez klatek i bez pośpiechu. Twój pies wraca do domu czysty, puszysty i zrelaksowany.',
    stick1: ['Jeden pies', 'naraz'], stick2: 'Wizyta zapoznawcza szczeniaka 15 €',
    rating: '4,9 z 186 opinii',
    cLab: 'Ile to kosztuje?', cH: 'Oblicz cenę dla swojego psa',
    cLede: 'Wybierz wielkość psa, rodzaj sierści i zabieg. Każda cena obejmuje kąpiel, suszenie, czyszczenie uszu oraz kokardkę albo bandanę.',
    qSize: 'Jak duży jest Twój pies?', qCoat: 'Jaka sierść?', qJob: 'Co trzeba zrobić?', qExtra: 'Dodatki',
    sizes: { s: ['Mały', 'do 10 kg'], m: ['Średni', '10–25 kg'], l: ['Duży', '25–40 kg'], xl: ['Bardzo duży', 'od 40 kg'] },
    coats: { kort: ['Krótka', 'labrador, beagle'], lang: ['Długa', 'shih tzu, cocker'], krul: ['Kręcona', 'pudel, doodle'], dubbel: ['Z podszerstkiem', 'husky, owczarek'] },
    jobs: { was: ['Kąpiel i suszenie', 'czysto i miękko, bez strzyżenia'], trim: ['Pełna pielęgnacja', 'kąpiel, strzyżenie, fason'], pluk: ['Trymowanie', 'dla szorstkowłosych terierów'] },
    extras: { nagels: 'Obcinanie pazurów', tanden: 'Mycie zębów', klit: 'Rozczesywanie kołtunów' },
    res: 'Cena', resTime: 'Czas', min: 'min', hour: 'godz.', approx: 'około',
    tip: { kort: 'Psy krótkowłose linieją głównie wiosną i jesienią. Kąpiel z wyczesaniem podszerstka to dużo mniej sierści na kanapie.', lang: 'Długa sierść szybko się kołtuni za uszami i pod łapami. Pielęgnacja co 6–8 tygodni utrzymuje porządek.', krul: 'Kręcona sierść ciągle rośnie. Strzyżenie co 6 tygodni zapobiega filcowaniu i dba o skórę.', dubbel: 'Psów z podszerstkiem nigdy nie golimy na krótko, bo sierść chroni je przed zimnem i upałem. Zamiast tego wyczesujemy podszerstek.' },
    take: 'Umów tę wizytę',
    fLab: 'Pierwsza wizyta', fH: 'Pies jeszcze nigdy nie był u groomera?',
    first: [['Zapoznanie', 'Wpadnijcie na 15 minut, żeby pies mógł wszystko obwąchać i osłuchać się z dźwiękami. Dla dorosłych psów gratis, dla szczeniąt 15 € razem z krótką kąpielą.'], ['Bez pośpiechu', 'Robimy przerwy, kiedy trzeba. Lepiej podzielić wizytę na dwie niż wypuścić przestraszonego psa.'], ['Zdjęcie na koniec', 'Kiedy pies jest gotowy, dostajesz wiadomość na WhatsAppie ze zdjęciem, więc nie musisz czekać na miejscu.']],
    gLab: 'Stali klienci', gH: 'Lubią do nas wracać',
    dogs: [['tafel.webp', 'Bobbie', 'Buldog francuski · co 8 tygodni'], ['corgi.webp', 'Luna', 'Corgi · kąpiel i wyczesanie'], ['aussie.webp', 'Max', 'Owczarek australijski · z podszerstkiem'], ['speeltje.webp', 'Saar', 'Golden retriever · ze swoją przytulanką'], ['duo.webp', 'Pip i Joep', 'Zawsze przychodzą razem'], ['trui.webp', 'Kees', 'Przychodzi we własnym sweterku']],
    rLab: 'Opinie', rH: 'Co mówią właściciele',
    reviews: [['Nasz Joep kiedyś trząsł się już na parkingu. Teraz wchodzi do środka, merdając ogonem. To mówi samo za siebie.', 'Ilse, Sittard'], ['Cena jasno podana z góry, a zdjęcie na WhatsAppie to bardzo miły dodatek.', 'Ruud, Geleen'], ['Mają cierpliwość do naszej starszej Saar i jej sztywnych bioder. Może nawet w trakcie na chwilę się położyć.', 'Rodzina Hendriks, Born']],
    bLab: 'Wizyta', bH: 'Umów wizytę',
    bLede: 'Zostaw dane, a oddzwonimy jeszcze tego samego dnia, żeby ustalić godzinę.',
    fDog: 'Imię psa', fBreed: 'Rasa lub mieszaniec', fName: 'Imię i nazwisko', fPhone: 'Telefon', fDay: 'Preferowany dzień', anyDay: 'Obojętnie', fNote: 'Coś, o czym powinniśmy wiedzieć?', fNotePh: 'Np. boi się suszarki, ma wrażliwe łapy', send: 'Poproś o termin',
    doneH: 'Super! Oddzwonimy jeszcze dziś.', doneP: 'Wersja pokazowa: nic nie zostało wysłane. Na prawdziwej stronie zgłoszenie trafia od razu do salonu.',
    pickedPre: 'Wycena', hoursH: 'Godziny otwarcia', days: ['Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota', 'Niedziela'], closed: 'Zamknięte',
    openNow: 'Teraz otwarte', closedNow: 'Teraz zamknięte', until: 'do', opensAt: 'otwieramy', parking: 'Bezpłatny parking pod drzwiami',
    demo: 'Strona koncepcyjna fikcyjnego salonu dla psów, wykonana przez Vervo Studio.', credit: 'Strona: Vervo Studio ↗', call: 'Zadzwoń',
  },
};
const t = T[lang];
const fmtH = (m) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
const SIZE_SCALE = { s: 0.6, m: 0.75, l: 0.9, xl: 1.05 };
const cfg = {
  lang, hours: HOURS, price: PRICE,
  names: { size: Object.fromEntries(Object.entries(t.sizes).map(([k, v]) => [k, v[0]])), coat: Object.fromEntries(Object.entries(t.coats).map(([k, v]) => [k, v[0]])), job: Object.fromEntries(Object.entries(t.jobs).map(([k, v]) => [k, v[0]])), extras: t.extras },
  t: { openNow: t.openNow, closedNow: t.closedNow, until: t.until, opensAt: t.opensAt, days: t.days, min: t.min, hour: t.hour, approx: t.approx, tip: t.tip, pickedPre: t.pickedPre },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="nl" href={new URL(root('nl'), Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(root('en'), Astro.url).href} />
    <link rel="alternate" hreflang="pl" href={new URL(root('pl'), Astro.url).href} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:image" content={new URL(img('hero.webp'), Astro.url).href} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fff4e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" />
  </head>
  <body>
    <Curtain />
    <header class="hd" id="hd">
      <a class="hd__logo" href="#top"><span class="hd__paw" aria-hidden="true"></span>pluis</a>
      <nav class="hd__nav">{['#prijzen', '#eerste-keer', '#vaste-klanten', '#afspraak'].map((h, i) => <a href={h}>{t.nav[i]}</a>)}</nav>
      <a class="btn btn--orange hd__cta" href="#afspraak">{t.book}</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero__txt">
          <h1>{t.h1}</h1>
          <p class="lede">{t.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--orange" href="#afspraak">{t.book}</a>
            <a class="btn btn--blue" href="#prijzen">{t.cH}</a>
          </div>
          <p class="rating"><span aria-hidden="true">★★★★★</span> {t.rating}</p>
        </div>
        <div class="hero__pic">
          <div class="blob"><img src={img('hero.webp')} alt="" fetchpriority="high" /></div>
          <p class="stick stick--a"><b>{t.stick1[0]}</b>{t.stick1[1]}</p>
          <p class="stick stick--b">{t.stick2}</p>
        </div>
      </section>

      <section class="sec sec--calc" id="prijzen">
        <div class="wrap">
          <p class="lab">{t.cLab}</p>
          <h2 class="h2">{t.cH}</h2>
          <p class="lede">{t.cLede}</p>
          <form class="calc" data-calc>
            <div class="calc__q">
              <fieldset><legend>{t.qSize}</legend>
                <div class="opts opts--4">
                  {Object.entries(t.sizes).map(([k, [n, s]], i) => <label class="opt"><input type="radio" name="size" value={k} checked={i === 1} /><span><svg viewBox="0 0 24 24" style={`--d:${SIZE_SCALE[k]}`} aria-hidden="true" set:html={DOG} /><b>{n}</b><small>{s}</small></span></label>)}
                </div>
              </fieldset>
              <fieldset><legend>{t.qCoat}</legend>
                <div class="opts opts--4">
                  {Object.entries(t.coats).map(([k, [n, s]], i) => <label class="opt"><input type="radio" name="coat" value={k} checked={i === 1} /><span><i class={`coat coat--${k}`} aria-hidden="true"></i><b>{n}</b><small>{s}</small></span></label>)}
                </div>
              </fieldset>
              <fieldset><legend>{t.qJob}</legend>
                <div class="opts opts--3">
                  {Object.entries(t.jobs).map(([k, [n, s]], i) => <label class="opt opt--row"><input type="radio" name="job" value={k} checked={i === 1} /><span><b>{n}</b><small>{s}</small></span></label>)}
                </div>
              </fieldset>
              <fieldset><legend>{t.qExtra}</legend>
                <div class="extras">
                  {Object.entries(t.extras).map(([k, n]) => <label class="ex"><input type="checkbox" name={k} /><span>{n} <em>+ €{PRICE.extras[k]}</em></span></label>)}
                </div>
              </fieldset>
            </div>
            <aside class="calc__res">
              <div class="calc__nums">
                <p><small>{t.res}</small><b data-price>€ –</b></p>
                <p><small>{t.resTime}</small><b data-time>–</b></p>
              </div>
              <p class="calc__tip" data-tip></p>
              <a class="btn btn--orange btn--full" href="#afspraak" data-take>{t.take}</a>
            </aside>
          </form>
        </div>
      </section>

      <section class="sec" id="eerste-keer">
        <div class="wrap">
          <p class="lab rv">{t.fLab}</p>
          <h2 class="h2 rv">{t.fH}</h2>
          <ol class="first">{t.first.map(([h, p], i) => <li class="rv"><span>{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}</ol>
        </div>
      </section>

      <section class="sec sec--dogs" id="vaste-klanten">
        <div class="wrap">
          <p class="lab rv">{t.gLab}</p>
          <h2 class="h2 rv">{t.gH}</h2>
