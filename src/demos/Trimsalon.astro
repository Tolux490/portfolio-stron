---
import Curtain from '../components/Curtain.astro';
import DemoLang from '../components/DemoLang.astro';
// Trimsalon Pluis (demo): salon dla psów w Sittard. NL + EN + PL.
// Fikcyjna firma: adres, ceny i opinie są przykładowe. Strony: src/pages/trimsalon/ (+ en/, pl/).

const { lang = 'nl' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f) => `${base}/img/trimsalon/${f}`;
const root = (l) => `${base}/trimsalon/${l === 'nl' ? '' : `${l}/`}`;
const tel = '+31460000000';
const telShow = '046 000 00 00';
// di–vr 9:00–17:30, za 9:00–15:00
const HOURS = [null, [540, 1050], [540, 1050], [540, 1050], [540, 1050], [540, 900], null];
// cennik: pełne strzyżenie wg wielkości, mnożniki sierści i zabiegu, dodatki
const PRICE = {
  size: { s: [38, 60], m: [48, 90], l: [62, 120], xl: [78, 150] },
  coat: { kort: [0.8, 0.8], lang: [1, 1], krul: [1.2, 1.2], dubbel: [1.15, 1.25] },
  job: { was: [0.62, 0.6], trim: [1, 1], pluk: [1.18, 1.3] },
  extras: { nagels: 8, tanden: 10, klit: 15 },
};
const DOG = '<path d="M15.6 5.2l1.2-1.4.9 1.7h1.4c.9 0 1.6.6 1.9 1.4l.5 1.4c.2.6-.2 1.2-.8 1.2h-1.4l-.3 1.3V18c0 .6-.4 1-1 1h-.8c-.6 0-1-.4-1-1v-3.4H9.6V18c0 .6-.4 1-1 1h-.8c-.6 0-1-.4-1-1v-4.6l-.8-.9-1.6 2.3c-.3.4-.9.3-1-.2-.3-1.4.2-2.9 1.3-3.8L6.2 10c.7-.6 1.6-.9 2.5-.9h5.6l.5-2.4c.1-.6.4-1.1.8-1.5z"/>';

const T = {
  nl: {
    title: 'Trimsalon Pluis — rustige trimsalon voor honden in Sittard',
    desc: 'Trimmen, wassen en plukken in Sittard. Eén hond tegelijk, geen kooien en geen haast. Bereken direct wat een trimbeurt voor jouw hond kost.',
    nav: ['Prijzen', 'Eerste keer', 'Vaste klanten', 'Afspraak'], book: 'Afspraak maken',
    h1: 'Trimmen voor honden die eigenlijk liever thuis blijven.',
    lede: 'Een rustige trimsalon in Sittard. Eén hond tegelijk, geen kooien en geen haast. Je hond gaat fris, zacht en ontspannen weer naar huis.',
