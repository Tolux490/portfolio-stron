    gLab: 'Vaste klanten', gH: 'Ze komen graag terug',
    dogs: [['tafel.webp', 'Bobbie', 'Franse bulldog · elke 8 weken'], ['corgi.webp', 'Luna', 'Corgi · wassen en ontwollen'], ['aussie.webp', 'Max', 'Australian shepherd · dubbele vacht'], ['speeltje.webp', 'Saar', 'Golden retriever · met haar knuffel'], ['duo.webp', 'Pip en Joep', 'Altijd samen op de afspraak'], ['trui.webp', 'Kees', 'Neemt zijn eigen trui mee']],
    rLab: 'Reviews', rH: 'Wat baasjes zeggen',
