    qSize: 'Hoe groot is je hond?', qCoat: 'Wat voor vacht?', qJob: 'Wat moet er gebeuren?', qExtra: 'Extra’s',
    sizes: { s: ['Klein', 'tot 10 kg'], m: ['Middel', '10 – 25 kg'], l: ['Groot', '25 – 40 kg'], xl: ['Extra groot', 'vanaf 40 kg'] },
    coats: { kort: ['Kort', 'labrador, beagle'], lang: ['Lang', 'shih tzu, cocker'], krul: ['Krullend', 'poedel, doodle'], dubbel: ['Dubbele vacht', 'husky, herder'] },
    jobs: { was: ['Wassen en föhnen', 'fris en zacht, niet geknipt'], trim: ['Complete trimbeurt', 'wassen, knippen, model'], pluk: ['Plukken', 'voor ruwharige terriërs'] },
    extras: { nagels: 'Nagels knippen', tanden: 'Tanden poetsen', klit: 'Anti-klit behandeling' },
    res: 'Prijs', resTime: 'Duur', min: 'min', hour: 'uur', approx: 'ongeveer',
    tip: { kort: 'Kortharige honden verharen vooral in voor- en najaar. Een wasbeurt met ontwolling scheelt veel haar op de bank.', lang: 'Lange vachten klitten snel achter de oren en onder de oksels. Om de 6 tot 8 weken trimmen houdt het netjes.', krul: 'Krullende vachten groeien door. Elke 6 weken een trimbeurt voorkomt vilt en houdt de huid gezond.', dubbel: 'Dubbele vachten scheren we nooit kort, dat beschermt tegen kou én warmte. We kammen de onderwol eruit.' },
