---
// Kosmiczne tło: pole gwiazd (miękkie, świecące) + proceduralna asteroida wysokiej jakości.
// Dryfuje wraz ze scrollem. Three.js wbudowany. Na telefonie lżej, przy reduced-motion bez auto-obrotu.
---
<div class="cosmos" id="cosmos" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const host = document.getElementById('cosmos');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.matchMedia('(max-width: 820px)').matches;

  if (host) {
    try {
      const W = () => host.clientWidth || innerWidth || document.documentElement.clientWidth || 1;
      const H = () => host.clientHeight || innerHeight || document.documentElement.clientHeight || 1;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(52, W() / H(), 0.1, 600);
      camera.position.set(0, 0, 6);

      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: !mobile, preserveDrawingBuffer: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.6 : 2));
      renderer.setSize(W(), H());
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      host.appendChild(renderer.domElement);

      // ——— światła (dramatyczne, kosmiczne) ———
      scene.add(new THREE.AmbientLight(0x223049, 0.55));
      const sun = new THREE.DirectionalLight(0xfff0d8, 3.6); sun.position.set(6, 3.5, 4); scene.add(sun);
      const rim = new THREE.DirectionalLight(0x4f78e0, 1.4); rim.position.set(-6, -1.5, -4); scene.add(rim);
      const fill = new THREE.PointLight(0x9fb4ff, 6, 40); fill.position.set(-3, 2, 5); scene.add(fill);

      // ——— miękka tekstura gwiazdy (okrągły, świecący punkt) ———
      function starTex() {
        const c = document.createElement('canvas'); c.width = c.height = 64;
        const g = c.getContext('2d');
        const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
        grad.addColorStop(0, 'rgba(255,255,255,1)');
        grad.addColorStop(0.18, 'rgba(255,255,255,0.95)');
        grad.addColorStop(0.45, 'rgba(255,255,255,0.28)');
        grad.addColorStop(1, 'rgba(255,255,255,0)');
        g.fillStyle = grad; g.fillRect(0, 0, 64, 64);
        const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
      }
      const sprite = starTex();

      function stars(count, spread, size, opacity, warmish) {
        const g = new THREE.BufferGeometry();
        const pos = new Float32Array(count * 3), col = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          pos[i * 3] = (Math.random() - 0.5) * spread;
          pos[i * 3 + 1] = (Math.random() - 0.5) * spread;
          pos[i * 3 + 2] = (Math.random() - 0.5) * spread;
          // paleta: głównie chłodna biel/błękit, część ciepła
          const t = Math.random();
          let r, gg, b;
          if (warmish && t > 0.8) { r = 1.0; gg = 0.86; b = 0.7; }        // ciepłe
          else if (t > 0.6) { r = 0.72; gg = 0.82; b = 1.0; }             // błękitne
          else { const w = 0.85 + Math.random() * 0.15; r = w; gg = w; b = w * 1.02; } // białe
          col[i * 3] = r; col[i * 3 + 1] = gg; col[i * 3 + 2] = b;
        }
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        const m = new THREE.PointsMaterial({ size, map: sprite, alphaMap: sprite, transparent: true, opacity, depthWrite: false, blending: THREE.AdditiveBlending, vertexColors: true, sizeAttenuation: true });
        return new THREE.Points(g, m);
      }
      const starFar = stars(mobile ? 2400 : 5000, 220, 0.9, 0.6, false);
      const starMid = stars(mobile ? 1100 : 2400, 110, 1.6, 0.85, true);
      const starBright = stars(mobile ? 90 : 180, 90, 4.2, 1.0, true);
      scene.add(starFar, starMid, starBright);

      // ——— proceduralna asteroida (wysoka jakość) ———
      const hash = (x, y, z) => { const s = Math.sin(x * 12.9898 + y * 78.233 + z * 37.719) * 43758.5453; return s - Math.floor(s); };
      const sm = (t) => t * t * (3 - 2 * t);
      const lp = (a, b, t) => a + (b - a) * t;
      function vnoise(x, y, z) {
        const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
        const u = sm(x - xi), v = sm(y - yi), w = sm(z - zi);
        const c000 = hash(xi, yi, zi), c100 = hash(xi + 1, yi, zi), c010 = hash(xi, yi + 1, zi), c110 = hash(xi + 1, yi + 1, zi);
        const c001 = hash(xi, yi, zi + 1), c101 = hash(xi + 1, yi, zi + 1), c011 = hash(xi, yi + 1, zi + 1), c111 = hash(xi + 1, yi + 1, zi + 1);
        return lp(lp(lp(c000, c100, u), lp(c010, c110, u), v), lp(lp(c001, c101, u), lp(c011, c111, u), v), w);
      }
      const fbm = (x, y, z, oct) => { let a = 0, amp = 0.5, f = 1, norm = 0; for (let i = 0; i < oct; i++) { a += amp * vnoise(x * f, y * f, z * f); norm += amp; f *= 2.03; amp *= 0.5; } return a / norm; };

      const craters = [];
      for (let i = 0; i < 14; i++) {
        const d = new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize();
        craters.push({ d, r: 0.16 + Math.random() * 0.32, depth: 0.08 + Math.random() * 0.15 });
      }

      const R = 1.65;
      const detail = mobile ? 4 : 6;
      const geo = new THREE.IcosahedronGeometry(R, detail);
      const pos = geo.attributes.position;
      const colors = new Float32Array(pos.count * 3);
      const v = new THREE.Vector3();
      const cLow = new THREE.Color(0x3a3129), cMid = new THREE.Color(0x8b7f70), cHi = new THREE.Color(0xb8ab97);
      const tmp = new THREE.Color();
      for (let i = 0; i < pos.count; i++) {
        v.fromBufferAttribute(pos, i).normalize();
        let disp = 0.24 * (fbm(v.x * 1.9 + 11, v.y * 1.9, v.z * 1.9, 3) - 0.5) * 2;
        disp += 0.10 * (fbm(v.x * 4.3 + 4, v.y * 4.3, v.z * 4.3, 3) - 0.5) * 2;
        disp += 0.045 * (fbm(v.x * 9.0 + 7, v.y * 9.0, v.z * 9.0, 2) - 0.5) * 2;
        let crater = 0;
        for (const c of craters) {
          const ang = Math.acos(Math.min(1, Math.max(-1, v.dot(c.d))));
          const t = ang / c.r;
          if (t < 1) crater += c.depth * (Math.cos(t * Math.PI) * 0.5 + 0.5);     // misa
          else if (t < 1.3) crater -= c.depth * 0.35 * (1 - (t - 1) / 0.3);        // uniesiony brzeg
        }
        const off = disp - crater;
        const rr = R * (1 + off);
        pos.setXYZ(i, v.x * rr, v.y * rr, v.z * rr);
        // kolor: ciemniej w zagłębieniach, jaśniej na szczytach (efekt AO)
        const f = Math.min(1, Math.max(0, 0.5 + off * 2.2));
        if (f < 0.5) tmp.copy(cLow).lerp(cMid, f * 2); else tmp.copy(cMid).lerp(cHi, (f - 0.5) * 2);
        colors[i * 3] = tmp.r; colors[i * 3 + 1] = tmp.g; colors[i * 3 + 2] = tmp.b;
      }
      geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      geo.computeVertexNormals();
      const rock = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.98, metalness: 0.22, flatShading: true });
      const asteroid = new THREE.Mesh(geo, rock);
      asteroid.position.set(2.4, 0.9, 0);
      asteroid.rotation.set(0.4, 0.6, 0.1);
      scene.add(asteroid);

      // ——— responsywność + pointer ———
      function resize() { camera.aspect = W() / H(); camera.updateProjectionMatrix(); renderer.setSize(W(), H()); }
      addEventListener('resize', resize, { passive: true });
      let px = 0, py = 0;
      if (!mobile) addEventListener('pointermove', (e) => { px = e.clientX / innerWidth - 0.5; py = e.clientY / innerHeight - 0.5; }, { passive: true });

      // ——— animacja ———
      const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
      const start = performance.now();
      function frame(now) {
        requestAnimationFrame(frame);
        const t = (now - start) / 1000;
        const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
        const prog = clamp(scrollY / max, 0, 1);

        asteroid.position.x = 2.4 - prog * 6.4;
        asteroid.position.y = 0.9 - prog * 3.0;
        asteroid.position.z = -prog * 5.0;
        const s = 1 - prog * 0.4; asteroid.scale.set(s, s, s);
        if (!reduce) { asteroid.rotation.y += 0.0015; asteroid.rotation.x += 0.0005; }
        asteroid.rotation.z = 0.1 + prog * 0.5;

        starMid.rotation.y = t * 0.005 + px * 0.1;
        starFar.rotation.y = t * 0.0018;
        starBright.rotation.y = t * 0.006;
        starMid.position.y = prog * 3;
        if (!reduce) { starMid.material.opacity = 0.78 + Math.sin(t * 1.6) * 0.1; starBright.material.opacity = 0.85 + Math.sin(t * 2.3 + 1) * 0.15; }

        camera.position.x += ((px * 0.5) - camera.position.x) * 0.05;
        camera.position.y += ((-py * 0.35) - camera.position.y) * 0.05;
        camera.lookAt(0, 0, 0);

        renderer.render(scene, camera);
      }
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
      host.style.opacity = '1';
    } catch (err) {
      console.warn('Cosmos wyłączony:', err);
      host.style.display = 'none';
    }
  }
</script>

<style>
  .cosmos {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    opacity: 0; transition: opacity 1.2s ease;
    background: radial-gradient(130% 90% at 72% 16%, #161d31 0%, #0a0d1a 42%, #05060d 70%, #030308 100%);
  }
  .cosmos canvas { width: 100% !important; height: 100% !important; display: block; }
</style>
