---
import {
  T, LANGS, DEFAULT_LANG, NAV_HREFS, SKILLS, CASE_MEDIA, SITE_HREFS, SITE_THUMBS, CERTS,
  FIVERR_URL, GITHUB_URL, FICHES_URL, EMAIL,
} from '../data/hub-i18n.js';

const { lang = DEFAULT_LANG } = Astro.props;
const t = T[lang] || T[DEFAULT_LANG];

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : 'https://vervostudio.com';
const og = (p) => new URL(`${b}/og/${p}`, Astro.site || 'https://vervostudio.com/').href;
const asset = (p) => `${b}/${p}`;

// Formularz kontaktowy trafia na ten adres przez FormSubmit (bez konta i bez klucza).
// Przy pierwszym wysłaniu FormSubmit przyśle na tę skrzynkę mail z linkiem aktywacyjnym.
const email = EMAIL;

const langPath = (l) => (l === DEFAULT_LANG ? '/' : `/${l}/`);
const urls = Object.fromEntries(LANGS.map((l) => [l, `${site}${langPath(l)}`]));
const canonical = urls[lang];
const langUrl = (l) => `${b}${langPath(l)}`;

// Bez linku do Fiverr główne CTA prowadzą do formularza kontaktowego.
const fiverr = FIVERR_URL || '';
const extLink = { target: '_blank', rel: 'noopener' };
const hire = fiverr ? { href: fiverr, ...extLink } : { href: '#contact' };
const fmtDate = (d) => new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(d));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Vervo Studio',
  description: t.schemaDesc,
  url: canonical,
  email: email,
  image: og('vervo.png'),
  inLanguage: lang,
  areaServed: 'Worldwide',
  founder: {
    '@type': 'Person',
    name: 'Antoni Antczak',
    jobTitle: t.jobTitle,
    knowsAbout: SKILLS,
    sameAs: [GITHUB_URL, fiverr].filter(Boolean),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: t.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceIcons = [
  // tabela
  '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M9.5 9.5v10"/>',
  // błyskawica / automatyzacja
  '<path d="M13 3 5 13.5h6L10 21l8-10.5h-6L13 3Z"/>',
  // przeglądarka
  '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M3 8.5h18"/><circle cx="6" cy="6.5" r=".4"/><circle cx="8" cy="6.5" r=".4"/>',
  // wykres
  '<path d="M4 20V4M4 20h16"/><path d="m7.5 15 3.5-4 3 2.5 5-6"/>',
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={urls[l]} />)}
    <link rel="alternate" hreflang="x-default" href={urls[DEFAULT_LANG]} />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:site_name" content="Vervo Studio" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og('vervo.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.ogTitle} />
    <meta name="twitter:description" content={t.meta.ogDescription} />
    <meta name="twitter:image" content={og('vervo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <header class="hdr" id="hdr">
      <div class="wrap hdr__in">
        <a class="brand" href="#top" aria-label="Vervo Studio">
          <svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand__tx">Vervo <em>Studio</em></span>
        </a>
        <nav class="nav" aria-label="Nav">{NAV_HREFS.map((href, i) => <a href={href}>{t.navLabels[i]}</a>)}</nav>
        <div class="lang" role="group" aria-label="Language">
          {LANGS.map((l) => <a class:list={['lang__a', { on: l === lang }]} href={langUrl(l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>)}
        </div>
        <a class="btn btn--dark btn--sm hdr__cta" {...hire}>{t.cta.hire}</a>
        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span></button>
      </div>
    </header>

    <div class="drawer" id="drawer">
      {NAV_HREFS.map((href, i) => <a href={href}>{t.navLabels[i]}</a>)}
      <a {...hire}>{t.cta.hire}</a>
      <div class="lang lang--drawer" role="group" aria-label="Language">
        {LANGS.map((l) => <a class:list={['lang__a', { on: l === lang }]} href={langUrl(l)} hreflang={l} lang={l}>{l.toUpperCase()}</a>)}
      </div>
    </div>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__txt">
            <p class="avail"><span class="avail__dot" aria-hidden="true"></span>{t.hero.available}</p>
            <p class="who">
              <span class="mono" aria-hidden="true">AA</span>
              <span><b>Antoni Antczak</b><span>{t.jobTitle}</span></span>
            </p>
            <h1 set:html={t.hero.h1}></h1>
            <p class="hero__lede">{t.hero.lede}</p>
            <div class="hero__cta">
              {fiverr
                ? <a class="btn btn--acc" href={fiverr} {...extLink}>{t.cta.fiverr} ↗</a>
                : <a class="btn btn--acc" href="#contact">{t.cta.quote}</a>}
              <a class="btn btn--line" href="#work">{t.cta.seeWork}</a>
            </div>
          </div>

          <div class="hero__art" aria-hidden="true">
            <figure class="win win--a">
              <div class="win__bar"><i></i><i></i><i></i><span>Sweet Crumb Bakery · Google Sheets</span></div>
              <img src={asset(CASE_MEDIA[1].shots[1].src)} width={CASE_MEDIA[1].shots[1].w} height={CASE_MEDIA[1].shots[1].h} alt="" fetchpriority="high" />
            </figure>
            <figure class="win win--b">
              <div class="win__bar"><i></i><i></i><i></i><span>Cleaning log</span></div>
              <img src={asset(CASE_MEDIA[0].shots[2].src)} width={CASE_MEDIA[0].shots[2].w} height={CASE_MEDIA[0].shots[2].h} alt="" />
            </figure>
            <figure class="win win--c">
              <div class="win__bar"><i></i><i></i><i></i><span>Little Kettle Shop.xlsx</span></div>
              <img src={asset(CASE_MEDIA[0].shots[1].src)} width={CASE_MEDIA[0].shots[1].w} height={CASE_MEDIA[0].shots[1].h} alt="" />
            </figure>
            <span class="chip chip--1"><span class="avail__dot"></span>{t.hero.chips[1]}</span>
            <span class="chip chip--2"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>{t.hero.chips[0]}</span>
          </div>
        </div>

        <div class="wrap">
          <ul class="proof">
            {t.hero.proof.map((f) => <li><b>{f.b}</b><span>{f.t}</span></li>)}
          </ul>
        </div>
      </section>

      <!-- NARZĘDZIA -->
      <section class="tools" aria-label={t.skillsLabel}>
        <div class="wrap tools__in">
          <p class="tools__lab">{t.skillsLabel}</p>
          <ul class="tools__list">{SKILLS.map((s) => <li>{s}</li>)}</ul>
        </div>
      </section>

      <!-- PROJEKTY -->
      <section class="band" id="work">
        <div class="wrap">
          <div class="sec__head rv">
            <p class="label">{t.work.label}</p>
            <h2 class="h2">{t.work.h2}</h2>
            <p class="sec__lede">{t.work.lede}</p>
          </div>

          <div class="cases">
            {t.work.cases.map((c, i) => {
              const m = CASE_MEDIA[i];
              return (
                <article class="case rv">
                  <header class="case__head">
                    <div class="case__meta">
                      <span class="kicker">{c.kicker}</span>
                      <span class="sample">{t.work.sample}</span>
                    </div>
                    <h3>{c.title}</h3>
                  </header>

                  <div class="case__body">
                    <div class="case__text">
                      <p class="case__lab">{t.work.problem}</p>
                      <p class="case__intro">{c.intro}</p>
                      <p class="case__lab">{t.work.did}</p>
                      <ol class="did">{c.did.map((d) => <li>{d}</li>)}</ol>
                    </div>
                    <div class="case__side">
                      <figure class="vid">
                        <video controls preload="none" playsinline muted poster={asset(m.poster)} width={m.vw} height={m.vh}>
                          <source src={asset(m.video)} type="video/mp4" />
                        </video>
                        <figcaption><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5L8 5.5Z"/></svg>{t.work.video}</figcaption>
                      </figure>
                      <ul class="stats">{c.stats.map((s) => <li><b>{s.b}</b><span>{s.t}</span></li>)}</ul>
                      <div class="result">
                        <p class="case__lab">{t.work.result}</p>
                        <p>{c.result}</p>
                      </div>
                      {m.download && (
                        <a class="btn btn--line btn--sm dl" href={asset(m.download)} download>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"/></svg>{t.work.download}
                        </a>
                      )}
                    </div>
                  </div>

                  <div class:list={['shots', `shots--${m.shots.length}`]}>
                    {m.shots.map((s, k) => (
                      <button class="shot" type="button" data-zoom={asset(s.src)} data-cap={c.caps[k]} aria-label={`${c.caps[k]}. ${t.work.zoom}`}>
                        <span class="shot__img"><img src={asset(s.src)} width={s.w} height={s.h} alt={c.caps[k]} loading="lazy" decoding="async" /></span>
                        <span class="shot__cap">{c.caps[k]}</span>
                      </button>
                    ))}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <!-- STRONY WWW -->
      <section class="band band--alt" id="websites">
        <div class="wrap">
          <div class="sec__head rv">
            <p class="label">{t.sites.label}</p>
            <h2 class="h2">{t.sites.h2}</h2>
            <p class="sec__lede">{t.sites.note}</p>
          </div>
          <div class="sites">
            {t.sites.items.map((r, i) => (
              <a class="site rv" href={`${b}${SITE_HREFS[i]}`}>
                <span class="site__img"><img src={asset(SITE_THUMBS[i])} width="960" height="600" alt={`${r.nazwa}, ${r.bran}`} loading="lazy" decoding="async" /></span>
                <span class="site__body">
                  <span class="site__top"><span class="site__bran">{r.bran}</span><span class="site__go">{t.sites.goLive}</span></span>
                  <span class="site__h">{r.nazwa}</span>
                  <span class="site__p">{r.opis}</span>
                  <span class="tags">{r.tagi.map((x) => <span>{x}</span>)}</span>
                </span>
              </a>
            ))}
            <a class="site site--app rv" href={FICHES_URL} {...extLink}>
              <span class="site__img fiche" aria-hidden="true">
                <span class="fiche__card fiche__card--back">bread</span>
                <span class="fiche__card">le pain</span>
              </span>
              <span class="site__body">
                <span class="site__top"><span class="site__bran">{t.sites.project.bran}</span><span class="site__go">{t.sites.project.go}</span></span>
                <span class="site__h">{t.sites.project.nazwa}</span>
                <span class="site__p">{t.sites.project.opis}</span>
                <span class="tags">{t.sites.project.tagi.map((x) => <span>{x}</span>)}</span>
              </span>
            </a>
          </div>
        </div>
      </section>

      <!-- USŁUGI -->
      <section class="band" id="services">
        <div class="wrap">
          <div class="sec__head rv">
            <p class="label">{t.services.label}</p>
            <h2 class="h2">{t.services.h2}</h2>
            <p class="sec__lede">{t.services.lede}</p>
          </div>
          <div class="svc">
            {t.services.items.map((s, i) => (
              <div class="svc__i rv">
                <span class="svc__ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={serviceIcons[i]}></svg></span>
                <h3>{s.t}</h3>
                <p>{s.o}</p>
                <ul class="checks">{s.co.map((c) => <li>{c}</li>)}</ul>
                <a class="svc__go" {...hire}>{fiverr ? t.cta.fiverr : t.cta.ask} →</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CERTYFIKATY -->
      <section class="band band--alt" id="certificates">
        <div class="wrap">
          <div class="sec__head rv">
            <p class="label">{t.certs.label}</p>
            <h2 class="h2">{t.certs.h2}</h2>
            <p class="sec__lede">{t.certs.lede}</p>
          </div>
          <div class="certs">
            {CERTS.map((c) => (
              <div class="cert rv">
                <button class="cert__img" type="button" data-zoom={asset(c.img)} data-cap={`${c.org} · ${c.t}`} aria-label={`${c.org} ${c.t}. ${t.work.zoom}`}>
                  <img src={asset(c.img)} width={c.w} height={c.h} alt={`${c.org} ${c.t}`} loading="lazy" decoding="async" />
                </button>
                <div class="cert__body">
                  <p class="cert__org">{c.org}</p>
                  <h3>{c.t}</h3>
                  <p class="cert__date">{t.certs.earned} {fmtDate(c.date)}</p>
                  <div class="cert__links">
                    <button type="button" class="cert__a" data-zoom={asset(c.img)} data-cap={`${c.org} · ${c.t}`}>{t.certs.view}</button>
                    {c.verify && <a class="cert__a" href={c.verify} {...extLink}>{t.certs.verify}</a>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- O MNIE -->
      <section class="band" id="about">
        <div class="wrap about">
          <div class="about__card rv">
            <span class="mono mono--lg" aria-hidden="true">AA</span>
            <p class="about__name">Antoni Antczak</p>
            <p class="about__role">Vervo Studio</p>
            <dl class="facts">
              {t.about.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
            </dl>
            <div class="about__links">
              <a href={`mailto:${email}`}>{email}</a>
              <a href={GITHUB_URL} {...extLink}>{t.cta.github} ↗</a>
              {fiverr && <a href={fiverr} {...extLink}>Fiverr ↗</a>}
            </div>
          </div>
          <div class="rv">
            <p class="label">{t.about.label}</p>
            <h2 class="h2">{t.about.h2}</h2>
            {t.about.p.map((p) => <p class="about__p">{p}</p>)}
            <div class="why">
              {t.about.why.map((w) => <div class="why__i"><b>{w.b}</b><span>{w.s}</span></div>)}
            </div>
          </div>
        </div>
      </section>

      <!-- PROCES -->
      <section class="band band--alt" id="process">
        <div class="wrap">
          <div class="sec__head rv"><p class="label">{t.proces.label}</p><h2 class="h2">{t.proces.h2}</h2></div>
          <ol class="steps">
            {t.proces.steps.map((s, i) => (
              <li class="step rv"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.o}</p></li>
            ))}
          </ol>
        </div>
      </section>

      <!-- FAQ -->
      <section class="band" id="faq">
        <div class="wrap wrap--narrow">
          <div class="sec__head rv"><p class="label">{t.faq.label}</p><h2 class="h2">{t.faq.h2}</h2></div>
          <div class="faq">
            {t.faq.items.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="band band--dark" id="contact">
        <div class="wrap contact">
          <div>
            <p class="label">{t.kontakt.label}</p>
            <h2 class="h2">{t.kontakt.h2}</h2>
            <p class="contact__p">{t.kontakt.p}</p>
            <a class="contact__mail" href={`mailto:${email}`}>{email}</a>
            {fiverr && (
              <div class="contact__fiverr">
                <p>{t.kontakt.fiverrNote}</p>
                <a class="btn btn--acc" href={fiverr} {...extLink}>{t.cta.fiverr} ↗</a>
              </div>
            )}
          </div>
          <form id="kForm" novalidate>
            <div class="frow">
              <label class="fld"><span>{t.kontakt.form.imie}</span><input type="text" name="imie" autocomplete="name" required /></label>
              <label class="fld"><span>{t.kontakt.form.email}</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <label class="fld"><span>{t.kontakt.form.need}</span>
              <select name="potrzeba" required><option value="">{t.kontakt.form.needChoose}</option>{t.kontakt.form.needs.map((x) => <option value={x}>{x}</option>)}</select>
            </label>
            <label class="fld"><span>{t.kontakt.form.wiadomosc}</span><textarea name="wiadomosc" rows="4" placeholder={t.kontakt.form.wiadomoscPlaceholder} required></textarea></label>
            <label class="consent"><input type="checkbox" name="zgoda" value="tak" required /><span>{t.kontakt.form.consent}</span></label>
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0" />
            <button class="btn btn--dark kbtn" type="submit" id="kBtn">{t.kontakt.form.submit}</button>
            <p class="kstat" id="kStat" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <a class="brand" href="#top">
          <svg class="brand__mk" viewBox="0 0 68 60" aria-hidden="true"><path d="M6 10 L34 48 L62 10" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand__tx">Vervo <em>Studio</em></span>
        </a>
        <p class="foot__tx">{t.footer.tx}</p>
        <p class="foot__legal">© {new Date().getFullYear()} Antoni Antczak · <a href={`mailto:${email}`}>{email}</a> · <a href={GITHUB_URL} {...extLink}>GitHub</a></p>
      </div>
    </footer>

    <dialog class="lb" id="lb" aria-label={t.work.zoom}>
      <button class="lb__x" type="button" id="lbX" aria-label="Close">×</button>
      <img id="lbImg" alt="" />
      <p id="lbCap"></p>
    </dialog>

    <script define:vars={{ email, msgs: t.formMsgs, submitLabel: t.kontakt.form.submit }}>
      const hdr = document.getElementById('hdr');
      const onScroll = () => hdr?.classList.toggle('stuck', window.scrollY > 20);
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
      const burger = document.getElementById('burger');
      const setMenu = (o) => { const v = o ?? !document.body.classList.contains('menu-open'); document.body.classList.toggle('menu-open', v); burger?.setAttribute('aria-expanded', String(v)); };
      burger?.addEventListener('click', () => setMenu());
      document.querySelectorAll('#drawer a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // pojawianie się sekcji przy przewijaniu
      const rv = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        rv.forEach((el) => io.observe(el));
      } else rv.forEach((el) => el.classList.add('in'));

      // powiększanie zrzutów ekranu i certyfikatów
      const lb = document.getElementById('lb'), lbImg = document.getElementById('lbImg'), lbCap = document.getElementById('lbCap');
      document.querySelectorAll('[data-zoom]').forEach((el) => el.addEventListener('click', () => {
        lbImg.src = el.dataset.zoom; lbImg.alt = el.dataset.cap || ''; lbCap.textContent = el.dataset.cap || '';
        lb.showModal();
      }));
      document.getElementById('lbX')?.addEventListener('click', () => lb.close());
      lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

      const form = document.getElementById('kForm'), stat = document.getElementById('kStat'), btn = document.getElementById('kBtn');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault(); stat.textContent = ''; stat.className = 'kstat';
        let ok = true;
        form.querySelectorAll('[required]').forEach((p) => {
          if (p.type === 'checkbox') { if (!p.checked) ok = false; return; }
          if (!p.value.trim()) { p.closest('.fld')?.classList.add('bad'); ok = false; } else { p.closest('.fld')?.classList.remove('bad'); }
        });
        if (!ok) { stat.textContent = msgs.incomplete; stat.classList.add('err'); return; }
        const d = Object.fromEntries(new FormData(form).entries());
        if (d._honey) return; // pułapka na boty
