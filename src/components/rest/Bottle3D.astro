---
// Model 3D butelki wina w hero — obraca się przy scrollowaniu i zanika w dół.
// Three.js jest WBUDOWANY (bundlowany z projektu), więc działa zawsze — bez CDN i offline.
// Tylko desktop (≥1000px). Przy prefers-reduced-motion butelka jest widoczna,
// ale bez samoczynnego obrotu — kręci się wyłącznie, gdy scrollujesz.
---
<div class="bottle3d" id="bottle3d" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const host = document.getElementById('bottle3d');
  const hero = document.querySelector('.hero');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 1000px)').matches;
  const force = new URLSearchParams(location.search).has('bottle3d');
  const motion = !reduce || force;

  if (host && hero && (desktop || force)) {
    try {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 500);
      camera.position.set(0, 0, 58);

      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, preserveDrawingBuffer: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.08;
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      host.appendChild(renderer.domElement);

      // środowisko odbić: ciepły gradient ze świetlistą wstęgą
      const envCanvas = document.createElement('canvas');
      envCanvas.width = 512; envCanvas.height = 256;
      const ex = envCanvas.getContext('2d');
      const eg = ex.createLinearGradient(0, 0, 0, 256);
      eg.addColorStop(0.00, '#140e08');
      eg.addColorStop(0.40, '#241a0e');
      eg.addColorStop(0.48, '#7a6236');
      eg.addColorStop(0.52, '#8c7040');
      eg.addColorStop(0.60, '#1e150c');
      eg.addColorStop(1.00, '#070605');
      ex.fillStyle = eg; ex.fillRect(0, 0, 512, 256);
      const envTex = new THREE.CanvasTexture(envCanvas);
      envTex.mapping = THREE.EquirectangularReflectionMapping;
      envTex.colorSpace = THREE.SRGBColorSpace;
      const pmrem = new THREE.PMREMGenerator(renderer);
      const envRT = pmrem.fromEquirectangular(envTex);
      scene.environment = envRT.texture;
      envTex.dispose(); pmrem.dispose();

      // światła
      scene.add(new THREE.HemisphereLight(0xffedd0, 0x0a0705, 0.32));
      const key = new THREE.DirectionalLight(0xffe6bd, 1.7); key.position.set(12, 16, 18); scene.add(key);
      const rim = new THREE.DirectionalLight(0xc6a15b, 1.5); rim.position.set(-16, 8, -10); scene.add(rim);
      const fill = new THREE.PointLight(0xffd9a0, 22, 120); fill.position.set(-6, -4, 14); scene.add(fill);

      const group = new THREE.Group();
      scene.add(group);

      // profil butelki (obrót wokół osi Y)
      const P = (x, y) => new THREE.Vector2(x, y);
      const profil = [
        P(0.0, 2.2), P(1.4, 1.2), P(2.7, 0.35), P(3.4, 0.08), P(3.8, 0.25),
        P(3.9, 0.9), P(3.9, 12.6), P(3.86, 13.4), P(3.5, 14.8), P(2.5, 16.4),
        P(1.5, 17.8), P(0.95, 19.0), P(0.9, 23.4), P(1.08, 24.1), P(1.08, 24.8),
        P(0.8, 25.1), P(0.0, 25.2),
      ];

      // wino w środku (nieprzezroczyste) — widoczne przez szkło
      const wineProfile = [ P(0.0, 2.6), P(2.2, 1.2), P(3.6, 0.9), P(3.6, 14.0), P(1.8, 14.35), P(0.0, 14.4) ];
      const wineMat = new THREE.MeshStandardMaterial({ color: 0x4a0d15, roughness: 0.26, metalness: 0.0, envMapIntensity: 0.6 });
      group.add(new THREE.Mesh(new THREE.LatheGeometry(wineProfile, 64), wineMat));

      // szkło butelki — ciemne butelkowe zielone, mocno barwione
      const glassGeo = new THREE.LatheGeometry(profil, 96);
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: 0x0a2a15, metalness: 0.0, roughness: 0.11,
        transmission: 0.38, thickness: 4.5, ior: 1.5,
        attenuationColor: new THREE.Color(0x03100a), attenuationDistance: 1.6,
        clearcoat: 1.0, clearcoatRoughness: 0.12, envMapIntensity: 0.65,
      });
      group.add(new THREE.Mesh(glassGeo, glassMat));

      // kapsla / folia na szyjce (mosiądz)
      const capMat = new THREE.MeshStandardMaterial({ color: 0xc6a15b, metalness: 0.95, roughness: 0.32, envMapIntensity: 1.4 });
      const capsule = new THREE.Mesh(new THREE.CylinderGeometry(1.02, 0.92, 4.6, 40, 1, true), capMat);
      capsule.position.y = 21.5; group.add(capsule);
      const capTop = new THREE.Mesh(new THREE.CylinderGeometry(0.98, 0.98, 0.5, 40), capMat);
      capTop.position.y = 24.9; group.add(capTop);

      // korek
      const cork = new THREE.Mesh(
        new THREE.CylinderGeometry(0.78, 0.78, 1.4, 24),
        new THREE.MeshStandardMaterial({ color: 0x9a6b3c, roughness: 0.85 })
      );
      cork.position.y = 25.4; group.add(cork);

      // etykieta (łuk z przodu)
      const lc = document.createElement('canvas'); lc.width = 540; lc.height = 380;
      const c = lc.getContext('2d');
      c.fillStyle = '#efe7d8'; c.fillRect(0, 0, 540, 380);
      c.strokeStyle = '#9c7c40'; c.lineWidth = 3; c.strokeRect(26, 26, 488, 328);
      c.lineWidth = 1; c.strokeRect(38, 38, 464, 304);
      c.fillStyle = '#7a5a2e'; c.textAlign = 'center';
      try { c.letterSpacing = '7px'; } catch (e) {}
      c.font = '600 21px Manrope, Arial, sans-serif';
      c.fillText('VIN DE MAISON', 270, 92);
      try { c.letterSpacing = '1px'; } catch (e) {}
      c.fillStyle = '#221a15';
      c.font = '700 60px Manrope, Arial, sans-serif';
      c.fillText('OGRODOWA', 270, 176);
      c.fillStyle = '#7e3b42';
      c.font = '600 54px Manrope, Arial, sans-serif';
      c.fillText('3', 270, 238);
      c.strokeStyle = '#9c7c40'; c.lineWidth = 1.5;
      c.beginPath(); c.moveTo(160, 266); c.lineTo(380, 266); c.stroke();
      c.fillStyle = '#7a5a2e';
      try { c.letterSpacing = '6px'; } catch (e) {}
      c.font = '600 19px Manrope, Arial, sans-serif';
      c.fillText('KUCHNIA SEZONOWA', 270, 300);
      try { c.letterSpacing = '4px'; } catch (e) {}
      c.font = '400 17px Manrope, Arial, sans-serif';
      c.fillText('WOŁOMIN · 2021', 270, 330);
      const labelTex = new THREE.CanvasTexture(lc);
      labelTex.colorSpace = THREE.SRGBColorSpace; labelTex.anisotropy = 4;
      const arc = Math.PI * 0.78;
      const labelGeo = new THREE.CylinderGeometry(3.94, 3.94, 5.6, 48, 1, true, -arc / 2, arc);
      const labelMat = new THREE.MeshStandardMaterial({ map: labelTex, roughness: 0.62, metalness: 0.0, side: THREE.DoubleSide, envMapIntensity: 0.5 });
      const label = new THREE.Mesh(labelGeo, labelMat);
      label.position.y = 6.7; group.add(label);

      group.rotation.z = 0.04;

      // responsywność
      function resize() {
        const W = hero.clientWidth, H = hero.clientHeight;
        renderer.setSize(W, H, false);
        camera.aspect = W / H; camera.updateProjectionMatrix();
        group.position.x = W / H > 1.4 ? 8.5 : 4.5;
      }
      resize();
      window.addEventListener('resize', resize);

      // pointer parallax
      let py = 0;
      window.addEventListener('pointermove', (e) => { py = (e.clientY / window.innerHeight - 0.5); }, { passive: true });

      const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
      const smooth = (t) => t * t * (3 - 2 * t);
      const start = performance.now();
      let rotCur = -0.35, lastScroll = -1;

      // pierwsza klatka od razu (widoczna, zanim ruszy pętla)
      group.rotation.y = rotCur;
      group.position.y = -12.6;
      renderer.render(scene, camera);
      host.style.transition = 'opacity 1.1s ease';
      host.style.opacity = '1';

      function frame(now) {
        requestAnimationFrame(frame);
        const t = (now - start) / 1000;
        const scrollY = window.scrollY || 0;
        const prog = clamp(scrollY / (hero.offsetHeight * 0.9), 0, 1);
        host.style.opacity = (1 - smooth(prog)).toFixed(3);
        if (1 - smooth(prog) < 0.01) return;

        // przy reduced-motion renderuj tylko, gdy faktycznie scrollujesz
        if (!motion && Math.abs(scrollY - lastScroll) < 0.5 && lastScroll >= 0) return;
        lastScroll = scrollY;

        const rotAim = (motion ? t * 0.28 : 0) + scrollY * 0.0055;
        rotCur += (rotAim - rotCur) * (motion ? 0.12 : 1);
        group.rotation.y = rotCur;
        if (motion) group.rotation.x += ((py * 0.18) - group.rotation.x) * 0.05;
        group.position.y = -12.6 + smooth(prog) * 5 + (motion ? Math.sin(t * 0.8) * 0.15 : 0);
        renderer.render(scene, camera);
      }
      requestAnimationFrame(frame);
    } catch (err) {
      console.warn('Bottle3D wyłączony:', err);
      host.style.display = 'none';
    }
  }
</script>
