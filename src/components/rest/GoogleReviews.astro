---
import Stars from './Stars.astro';
import { restauracja as biz } from '../../data/firmy.js';
import { opinie } from '../../data/restauracja.js';

// `limit` — ile opinii pokazać; `cols3` — trzy kolumny (dla pełnej strony opinii)
const { limit = 6, cols3 = false } = Astro.props;
const lista = opinie.slice(0, limit);
const inicjal = (n) => n.trim().charAt(0).toUpperCase();
---
<div class="gsum reveal">
  <div class="gsum__score">{biz.googleRating.toString().replace('.', ',')}</div>
  <div>
    <Stars g={biz.googleRating} />
    <div class="gsum__g" style="margin-top:.4rem">
      <span class="gsum__logo"><b>G</b><b>o</b><b>o</b><b>g</b><b>l</b><b>e</b></span>
      <span>· {biz.googleCount} opinii</span>
    </div>
  </div>
  <a class="btn btn--outline" href={biz.googleUrl} target="_blank" rel="noopener" style="margin-left:auto">Zobacz na Google</a>
</div>

<div class={`reviews${cols3 ? ' reviews--3' : ''}`}>
  {lista.map((o) => (
    <figure class="review reveal">
      <div class="review__top">
        <span class="review__ava" aria-hidden="true">{inicjal(o.a)}</span>
        <figcaption class="review__who">
          <b>{o.a}</b>
          <div class="review__meta">{o.kiedy}{o.lokalny ? ' · Lokalny przewodnik' : ''}</div>
        </figcaption>
      </div>
      <div class="review__stars"><Stars g={o.g} /></div>
      <blockquote class="review__t">{o.t}</blockquote>
    </figure>
  ))}
</div>
