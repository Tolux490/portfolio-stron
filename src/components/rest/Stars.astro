---
// Rządek gwiazdek: `g` wypełnionych z pięciu.
const { g = 5, label = true } = Astro.props;
const pełne = Math.round(g);
const path = 'M8 1.2l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11l-3.8 2 .7-4.3-3.1-3 4.3-.6z';
---
<span class="stars" role="img" aria-label={label ? `Ocena ${g} na 5` : undefined}>
  {Array.from({ length: 5 }).map((_, i) => (
    <svg viewBox="0 0 16 16" class={i < pełne ? '' : 'star-empty'} aria-hidden="true">
      <path d={path} fill="currentColor" />
    </svg>
  ))}
</span>
