---
import '../styles/restauracja.css';
import DemoLang from '../components/DemoLang.astro';
import { restauracja as bizPl, inLang } from '../data/firmy.js';

const {
  title,
  description,
  current = '',          // slug aktywnej podstrony: menu, wina, o-nas, wydarzenia, galeria, opinie, rezerwacja
  ogImage = 'restauracja/wnetrze-kominek.webp',
  lang = 'pl',           // 'pl' albo 'en'
  path = '',             // ścieżka podstrony względem /restauracja/, np. 'menu/' (do przełącznika języka)
} = Astro.props;
const en = lang === 'en';
const biz = inLang(bizPl, lang);

const tel = biz.phone.replace(/[^+\d]/g, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const plRoot = `${base}/restauracja`;
const root = en ? `${plRoot}/en` : plRoot;
const img = (p) => `${base}/img/${p}`;

const t = en ? {
  nav: ['Home', 'Menu', 'Wine', 'Kitchen', 'Evenings', 'Gallery', 'Reviews'],
  home: 'homepage', sub: 'Seasonal kitchen · Wołomin', navLabel: 'Main navigation',
  book: 'Book a table', reservation: 'Reservations', visit: 'Visit us', hours: 'Opening hours', navFoot: 'Navigation',
  credit: 'Website · Vervo Studio ↗', privacy: 'Privacy policy', bookShort: 'Book', call: 'Call',
} : {
  nav: ['Start', 'Karta', 'Wina', 'Kuchnia', 'Wieczory', 'Galeria', 'Opinie'],
  home: 'strona główna', sub: 'Kuchnia sezonowa · Wołomin', navLabel: 'Główna nawigacja',
  book: 'Rezerwuj stolik', reservation: 'Rezerwacja', visit: 'Odwiedź nas', hours: 'Godziny', navFoot: 'Nawigacja',
  credit: 'Realizacja · Vervo Studio ↗', privacy: 'Polityka prywatności', bookShort: 'Rezerwuj', call: 'Zadzwoń',
};
const nav = ['home', 'menu', 'wina', 'o-nas', 'wydarzenia', 'galeria', 'opinie'].map((id, i) => ({
  id, href: id === 'home' ? `${root}/` : `${root}/${id}/`, label: t.nav[i],
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: biz.name,
  image: new URL(img(ogImage), Astro.url).href,
  telephone: biz.phone,
  email: biz.email,
  servesCuisine: biz.cuisine,
  priceRange: biz.priceRange,
  url: Astro.url.origin + plRoot + '/',
  acceptsReservations: 'True',
  menu: Astro.url.origin + plRoot + '/menu/',
  address: { '@type': 'PostalAddress', streetAddress: biz.street, addressLocality: biz.city, postalCode: biz.zip, addressCountry: 'PL' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '16:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:00', closes: '18:00' },
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: biz.googleRating, reviewCount: biz.googleCount, bestRating: 5 },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="pl" href={new URL(`${plRoot}/${path}`, Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(`${plRoot}/en/${path}`, Astro.url).href} />
    <meta name="theme-color" content="#0e0c0a" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={en ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image" content={new URL(`${base}/og/restauracja.png`, Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}/og/restauracja.png`, Astro.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <header class="site" id="site">
      <div class="wrap site__in">
        <a class="brand" href={`${root}/`} aria-label={`${biz.name}, ${t.home}`}>
          <span class="brand__name">Ogrodowa <em>3</em></span>
          <span class="brand__sub">{t.sub}</span>
        </a>

        <nav class="nav" aria-label={t.navLabel}>
          {nav.map((l) => <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>)}
        </nav>

        <a class="btn btn--gold site__cta" href={`${root}/rezerwacja/`}>{t.book}</a>

        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
          <span></span>
        </button>
      </div>
    </header>

    <div class="drawer" id="drawer">
      {nav.map((l) => <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>)}
      <a href={`${root}/rezerwacja/`} aria-current={current === 'rezerwacja' ? 'page' : undefined}>{t.reservation}</a>
      <div class="drawer__foot">
        <a href={`tel:${tel}`}>{biz.phone}</a>
        <span>{biz.hours[0]}</span>
        <span>{biz.street}, {biz.city}</span>
      </div>
    </div>

    <main id="gora">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot__grid">
          <div class="foot__brand">
            <span class="brand__name">Ogrodowa <em>3</em></span>
            <p class="foot__tag">{biz.tagline}</p>
            <div class="foot__social">
              <a class="ulink" href={biz.instagram} target="_blank" rel="noopener">Instagram</a>
              <a class="ulink" href={biz.facebook} target="_blank" rel="noopener">Facebook</a>
              <a class="ulink" href={biz.googleUrl} target="_blank" rel="noopener">Google</a>
            </div>
          </div>
          <div>
            <h4>{t.visit}</h4>
            <ul>
              <li>{biz.street}</li>
              <li>{biz.zip} {biz.city}</li>
              <li><a class="ulink" href={`tel:${tel}`}>{biz.phone}</a></li>
              <li><a class="ulink" href={`mailto:${biz.email}`}>{biz.email}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.hours}</h4>
            <ul>
              {biz.hours.map((h) => <li>{h}</li>)}
            </ul>
            <h4 style="margin-top:1.6rem">{t.navFoot}</h4>
            <ul>
              <li><a class="ulink" href={`${root}/menu/`}>{t.nav[1]}</a></li>
              <li><a class="ulink" href={`${root}/rezerwacja/`}>{t.reservation}</a></li>
            </ul>
          </div>
        </div>

        <div class="foot__legal">
          <span>{biz.legalName} · NIP {biz.nip} · {biz.street}, {biz.zip} {biz.city}</span>
          <span><a href={`${base}/${en ? '' : 'pl/'}`}>{t.credit}</a> &nbsp;·&nbsp; <a href={`${root}/polityka-prywatnosci/`}>{t.privacy}</a></span>
        </div>
      </div>
    </footer>

    <div class="callbar">
      <a href={`${root}/rezerwacja/`}>{t.bookShort}</a>
      <a href={`tel:${tel}`}>{t.call}</a>
    </div>

    <DemoLang lang={lang} pl={`${plRoot}/${path}`} en={`${plRoot}/en/${path}`} />

    <script>
      // sticky header
      const site = document.getElementById('site');
      const onScroll = () => site?.classList.toggle('is-stuck', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // mobilne menu
      const burger = document.getElementById('burger');
      const toggle = (open) => {
        const isOpen = open ?? !document.body.classList.contains('menu-open');
        document.body.classList.toggle('menu-open', isOpen);
        burger?.setAttribute('aria-expanded', String(isOpen));
      };
      burger?.addEventListener('click', () => toggle());
      document.querySelectorAll('#drawer a').forEach((a) => a.addEventListener('click', () => toggle(false)));
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });

      // wejścia sekcji
      const obs = new IntersectionObserver((wpisy) => {
        wpisy.forEach((w) => { if (w.isIntersecting) { w.target.classList.add('is-in'); obs.unobserve(w.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      document.querySelectorAll('.reveal').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i % 3, 2) * 90}ms`;
        obs.observe(el);
      });
    </script>
  </body>
</html>
